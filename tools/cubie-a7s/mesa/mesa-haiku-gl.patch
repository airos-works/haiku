diff -ruN a/src/gallium/drivers/zink/zink_haiku_present.c b/src/gallium/drivers/zink/zink_haiku_present.c
--- a/src/gallium/drivers/zink/zink_haiku_present.c
+++ b/src/gallium/drivers/zink/zink_haiku_present.c
@@ -0,0 +1,725 @@
+/*
+ * Presenting a finished frame straight into the screen on Haiku; see
+ * zink_haiku_present.h.
+ *
+ * Read back to the processor, every frame costs a wait for the GPU, a copy
+ * into a bitmap and two more in app_server (into its copy of the screen and
+ * from there into the frame buffer), one after the other. Here the GPU
+ * copies the frame into the frame buffer and into a staging buffer in cached
+ * memory in one batch, and a helper thread copies the staging buffer on into
+ * the window system's copy of the screen once the batch has run. The
+ * program's thread only waits when more presents are in flight than it
+ * allows.
+ *
+ * The window system's copy is not imported into the GPU: app_server's
+ * processor writes it all the time, and a cache line that straddles a
+ * rectangle's edge could be written back by one side over the other's
+ * pixels. Processor stores into it, from the helper thread, are coherent
+ * with app_server's.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "zink_haiku_present.h"
+
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "zink_batch.h"
+#include "zink_clear.h"
+#include "zink_context.h"
+#include "zink_fence.h"
+#include "zink_resource.h"
+#include "zink_screen.h"
+#include "zink_types.h"
+
+#include "util/os_time.h"
+#include "util/u_math.h"
+#include "util/u_threaded_context.h"
+
+#include "vk_haiku_scanout.h"
+
+#ifdef __HAIKU__
+#include <fcntl.h>
+#include <unistd.h>
+#include <OS.h>
+/* sunxi_display.h is written for C++: its structures name each other
+ * without "struct" */
+typedef struct sunxi_display_timing sunxi_display_timing;
+typedef struct sunxi_display_output sunxi_display_output;
+#include <sunxi_display.h>
+#endif
+
+#define MAX_RECTS 256
+#define MAX_QUEUED 16
+/* Staging buffers for the window system's copy: one per present in flight,
+ * so frames_in_flight is at most this. */
+#define BACK_SLOTS 4
+
+/* A rectangle of the window system's copy, packed in a staging buffer: rows
+ * of row_pitch bytes from offset. */
+struct back_rect {
+   int32_t left, top;
+   uint32_t width, height;
+   uint32_t row_pitch;
+   uint64_t offset;
+};
+
+/* Staging rows are padded to this many pixels: the PowerVR transfer path
+ * writes a buffer whose row length is odd in two passes (its PBE line stride
+ * is counted in pairs of pixels), and 16 pixels keep rows on 64-byte cache
+ * lines for the processor's copy on. */
+#define BACK_ROW_ALIGN 16
+
+struct back_slot {
+   VkDeviceMemory memory;
+   VkBuffer buffer;
+   uint8_t *map;
+   uint64_t size;
+   bool coherent;
+   /* the present using it: where its rectangles go */
+   unsigned count;
+   struct back_rect rects[MAX_RECTS];
+   uint8_t *bits;
+   uint32_t bytes_per_row;
+   uint64_t used;
+};
+
+/* A present the helper thread waits for: by the number of its batch on the
+ * screen's timeline semaphore. The helper never touches zink's fences or
+ * batch states: those are recycled by the context's own thread, and a wait
+ * through them from another thread marks a reused batch idle, after which
+ * zink hands out memory the GPU is still using. */
+struct completion {
+   uint64_t batch_id;
+   void (*completed)(void *cookie);
+   void *cookie;
+   int slot;                      /* back_slot to copy on, or -1 */
+};
+
+static struct {
+   pthread_mutex_t lock;
+   pthread_cond_t changed;
+   struct zink_screen *screen;
+
+   /* The frame buffer the display scans out. */
+   VkDeviceMemory scanout_memory;
+   VkBuffer scanout_buffer;
+   uint32_t scanout_width, scanout_height, scanout_row_pitch;
+   uint64_t scanout_size;
+   int64_t scanout_refused_at;   /* os_time_get_nano() of the last refusal */
+#ifdef __HAIKU__
+   /* the display driver's frame buffer generation, checked once a second:
+    * a mode change replaces the frame buffer, and one that keeps the row
+    * length would otherwise go unnoticed */
+   int display_fd;
+   bool display_missing;
+   uint32_t scanout_generation;
+   int64_t scanout_checked_at;
+#endif
+
+   struct back_slot back[BACK_SLOTS];
+
+   /* Presents whose copies the helper thread waits for. */
+   struct completion queue[MAX_QUEUED];
+   unsigned queue_head, queue_count;
+   uint64_t submitted, finished;
+   bool thread_started;
+   pthread_t thread;
+} state = {
+   .lock = PTHREAD_MUTEX_INITIALIZER,
+   .changed = PTHREAD_COND_INITIALIZER,
+#ifdef __HAIKU__
+   .display_fd = -1,
+#endif
+};
+
+
+#ifdef __HAIKU__
+/* The sunxi_display driver's frame buffer generation (the Cubie A7S); false
+ * where there is no such driver, and then only the row length tells frame
+ * buffers apart. */
+static bool
+display_generation(uint32_t *generation)
+{
+   if (state.display_missing)
+      return false;
+   if (state.display_fd < 0) {
+      state.display_fd = open("/dev/" SUNXI_DISPLAY_DEVICE, O_RDWR | O_CLOEXEC);
+      if (state.display_fd < 0) {
+         state.display_missing = true;
+         return false;
+      }
+   }
+   struct sunxi_display_shared_info info;
+   if (ioctl(state.display_fd, SUNXI_DISPLAY_GET_STATE, &info,
+             sizeof(info)) != 0)
+      return false;
+   *generation = info.generation;
+   return true;
+}
+#endif
+
+
+static void
+copy_back(struct zink_screen *screen, struct back_slot *slot)
+{
+   if (!slot->coherent) {
+      const VkDeviceSize atom =
+         MAX2(screen->info.props.limits.nonCoherentAtomSize, 1);
+      VkDeviceSize size = align64(slot->used, atom);
+      VkMappedMemoryRange range = {
+         .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE,
+         .memory = slot->memory,
+         .offset = 0,
+         .size = size >= slot->size ? VK_WHOLE_SIZE : size,
+      };
+      VKSCR(InvalidateMappedMemoryRanges)(screen->dev, 1, &range);
+   }
+   for (unsigned i = 0; i < slot->count; i++) {
+      const struct back_rect *r = &slot->rects[i];
+      const size_t row = (size_t)r->width * 4;
+      const uint8_t *from = slot->map + r->offset;
+      uint8_t *to = slot->bits + (size_t)r->top * slot->bytes_per_row
+         + (size_t)r->left * 4;
+      for (uint32_t y = 0; y < r->height; y++) {
+         memcpy(to, from, row);
+         from += r->row_pitch;
+         to += slot->bytes_per_row;
+      }
+   }
+}
+
+
+static void *
+completion_thread(void *data)
+{
+   (void)data;
+   pthread_mutex_lock(&state.lock);
+   for (;;) {
+      while (state.queue_count == 0)
+         pthread_cond_wait(&state.changed, &state.lock);
+      struct completion entry = state.queue[state.queue_head];
+      struct zink_screen *screen = state.screen;
+      pthread_mutex_unlock(&state.lock);
+
+      /* On a lost device nothing ran: there is nothing to copy on, but the
+       * program still hears that the present is over. */
+      bool ran = !screen->device_lost;
+      if (ran && entry.batch_id != 0 && screen->sem != VK_NULL_HANDLE) {
+         VkSemaphoreWaitInfo wait = {
+            .sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO,
+            .semaphoreCount = 1,
+            .pSemaphores = &screen->sem,
+            .pValues = &entry.batch_id,
+         };
+         ran = VKSCR(WaitSemaphores)(screen->dev, &wait, UINT64_MAX)
+                  == VK_SUCCESS
+               && !screen->device_lost;
+      }
+      if (ran && entry.slot >= 0)
+         copy_back(screen, &state.back[entry.slot]);
+      if (entry.completed != NULL)
+         entry.completed(entry.cookie);
+
+      pthread_mutex_lock(&state.lock);
+      state.queue_head = (state.queue_head + 1) % MAX_QUEUED;
+      state.queue_count--;
+      state.finished++;
+      pthread_cond_broadcast(&state.changed);
+   }
+   return NULL;
+}
+
+
+/* With the lock held: waits until every present has finished, so that
+ * memory one of them still uses is never let go of. */
+static void
+wait_idle_locked(void)
+{
+   while (state.submitted != state.finished)
+      pthread_cond_wait(&state.changed, &state.lock);
+}
+
+
+static void
+drop_scanout(struct zink_screen *screen)
+{
+   wait_idle_locked();
+   if (state.scanout_buffer != VK_NULL_HANDLE)
+      VKSCR(DestroyBuffer)(screen->dev, state.scanout_buffer, NULL);
+   if (state.scanout_memory != VK_NULL_HANDLE)
+      VKSCR(FreeMemory)(screen->dev, state.scanout_memory, NULL);
+   state.scanout_buffer = VK_NULL_HANDLE;
+   state.scanout_memory = VK_NULL_HANDLE;
+   state.scanout_row_pitch = 0;
+}
+
+
+/* Takes hold of the frame buffer the display scans out. A mode change gives
+ * the screen a new one: its row length, or (on air/OS) the display driver's
+ * generation, tells them apart. */
+static bool
+acquire_scanout(struct zink_screen *screen, uint32_t bytes_per_row)
+{
+   const int64_t now = os_time_get_nano();
+   if (state.scanout_buffer != VK_NULL_HANDLE) {
+      bool current = state.scanout_row_pitch == bytes_per_row;
+#ifdef __HAIKU__
+      if (current && now - state.scanout_checked_at >= 1000000000LL) {
+         uint32_t generation;
+         state.scanout_checked_at = now;
+         if (display_generation(&generation)
+             && generation != state.scanout_generation)
+            current = false;
+      }
+#endif
+      if (current)
+         return true;
+      drop_scanout(screen);
+   }
+   /* Asking costs driver round trips; after a refusal, ask again later. */
+   if (state.scanout_refused_at != 0
+       && now - state.scanout_refused_at < 1000000000LL)
+      return false;
