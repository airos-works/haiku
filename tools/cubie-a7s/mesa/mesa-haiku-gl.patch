+/* Private air/OS performance hint for the current EGL context. A negative
+ * result means no preference, zero means whole rectangles, positive values
+ * give a preferred CPU readback band size in bytes. No GL state is changed.
+ * Zink reads back through one GPU copy and a wait per call: whole
+ * rectangles are cheapest.
+ */
+extern "C" PUBLIC int
+haiku_mesa_readback_band_bytes(void)
+{
+   struct st_context *st = st_api_get_current();
+   if (st && st->pipe && st->pipe->screen &&
+       strncmp(st->pipe->screen->get_name(st->pipe->screen), "zink", 4) == 0)
+      return 0;
+   return -1;
+}
+
+static void update_size(struct hgl_buffer *buffer);
+
+/* GPU rendering, CPU presentation: the frame is read back (a mapping of the
+ * GPU texture: zink copies it to host memory and waits) into a bitmap that
+ * the window's BitmapHook then shows. A view owns its displayed bitmap until
+ * SetBitmap() returns it, under the view's draw lock and after DrawBitmap()
+ * has read it; only that bitmap is written next.
+ */
+static bool
+haiku_present_texture(struct pipe_context *pipe, struct hgl_buffer *buffer,
+                      struct pipe_resource *texture)
+{
+   if (!pipe || !buffer->winsysContext || !texture || texture->width0 == 0 ||
+       texture->height0 == 0 || texture->width0 > INT32_MAX ||
+       texture->format != PIPE_FORMAT_BGRA8888_UNORM)
+      return false;
+
+   struct haiku_egl_surface *surface =
+      static_cast<struct haiku_egl_surface *>(buffer->present_private);
+   if (!surface)
+      return false;
+   const unsigned width = texture->width0, height = texture->height0;
+   BBitmap *back = surface->back_bitmap;
+   surface->back_bitmap = NULL;
+   if (back && (back->Bounds().IntegerWidth() + 1 != int64_t(width) ||
+                back->Bounds().IntegerHeight() + 1 != int64_t(height))) {
+      delete back;
+      back = NULL;
+   }
+   if (!back) {
+      back = new(std::nothrow) BBitmap(BRect(0, 0, width - 1, height - 1), 0,
+         B_RGBA32);
+   }
+   if (!back || back->InitCheck() != B_OK) {
+      delete back;
+      return false;
+   }
+
+   const size_t row_bytes = size_t(width) * 4;
+   struct pipe_box box;
+   u_box_2d(0, 0, width, height, &box);
+   struct pipe_transfer *transfer = NULL;
+   const uint8_t *pixels = static_cast<const uint8_t *>(
+      pipe->texture_map(pipe, texture, 0, PIPE_MAP_READ, &box, &transfer));
+   if (!pixels || transfer->stride < row_bytes ||
+       back->BytesPerRow() < int64_t(row_bytes)) {
+      if (pixels)
+         pipe->texture_unmap(pipe, transfer);
+      delete back;
+      return false;
+   }
+
+   const size_t destination_stride = back->BytesPerRow();
+   for (unsigned y = 0; y < height; ++y) {
+      uint8_t *destination = static_cast<uint8_t *>(back->Bits())
+         + size_t(y) * destination_stride;
+      memcpy(destination, pixels + size_t(y) * transfer->stride, row_bytes);
+      if (destination_stride > row_bytes)
+         memset(destination + row_bytes, 0, destination_stride - row_bytes);
+   }
+   pipe->texture_unmap(pipe, transfer);
+
+   BBitmap *retired =
+      static_cast<BitmapHook *>(buffer->winsysContext)->SetBitmap(back);
+   assert(retired == surface->front_bitmap);
+   (void)retired;
+   surface->back_bitmap = surface->front_bitmap;
+   surface->front_bitmap = back;
+   return true;
+}
