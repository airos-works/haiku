+   }
+   VkBufferCreateInfo bci = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = scanout.size,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+   };
+   VkBuffer buffer = VK_NULL_HANDLE;
+   if (VKSCR(CreateBuffer)(screen->dev, &bci, NULL, &buffer) != VK_SUCCESS
+       || VKSCR(BindBufferMemory)(screen->dev, buffer, memory, 0) != VK_SUCCESS) {
+      if (buffer != VK_NULL_HANDLE)
+         VKSCR(DestroyBuffer)(screen->dev, buffer, NULL);
+      VKSCR(FreeMemory)(screen->dev, memory, NULL);
+      state.scanout_refused_at = now;
+      return false;
+   }
+   state.scanout_memory = memory;
+   state.scanout_buffer = buffer;
+   state.scanout_width = scanout.width;
+   state.scanout_height = scanout.height;
+   state.scanout_row_pitch = scanout.rowPitch;
+   state.scanout_size = scanout.size;
+   state.scanout_refused_at = 0;
+#ifdef __HAIKU__
+   state.scanout_generation = generation;
+   state.scanout_checked_at = now;
+#endif
+   return true;
+}
+
+
+static void
+drop_back_slot(struct zink_screen *screen, struct back_slot *slot)
+{
+   if (slot->map != NULL)
+      VKSCR(UnmapMemory)(screen->dev, slot->memory);
+   if (slot->buffer != VK_NULL_HANDLE)
+      VKSCR(DestroyBuffer)(screen->dev, slot->buffer, NULL);
+   if (slot->memory != VK_NULL_HANDLE)
+      VKSCR(FreeMemory)(screen->dev, slot->memory, NULL);
+   slot->map = NULL;
+   slot->buffer = VK_NULL_HANDLE;
+   slot->memory = VK_NULL_HANDLE;
+   slot->size = 0;
+}
+
+
+/* A staging buffer of at least `bytes` for the window system's copy, in
+ * host-cached memory if there is any (it is read by the processor), kept
+ * mapped. The slot is idle: no present in flight uses it. */
+static bool
+ensure_back_slot(struct zink_screen *screen, struct back_slot *slot,
+                 uint64_t bytes)
+{
+   if (slot->buffer != VK_NULL_HANDLE && slot->size >= bytes)
+      return true;
+   drop_back_slot(screen, slot);
+
+   /* by the rectangles, with room to grow, not by the screen */
+   const uint64_t size = align64(bytes + bytes / 4, 65536);
+   VkBufferCreateInfo bci = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = size,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+   };
+   if (VKSCR(CreateBuffer)(screen->dev, &bci, NULL, &slot->buffer)
+       != VK_SUCCESS) {
+      slot->buffer = VK_NULL_HANDLE;
+      return false;
+   }
+   VkMemoryRequirements reqs;
+   VKSCR(GetBufferMemoryRequirements)(screen->dev, slot->buffer, &reqs);
+
+   const VkMemoryPropertyFlags cached =
+      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+   const VkMemoryPropertyFlags visible = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+   uint32_t type = UINT32_MAX;
+   for (unsigned pass = 0; pass < 2 && type == UINT32_MAX; pass++) {
+      const VkMemoryPropertyFlags wanted = pass == 0 ? cached : visible;
+      for (uint32_t i = 0; i < screen->info.mem_props.memoryTypeCount; i++) {
+         if ((reqs.memoryTypeBits & BITFIELD_BIT(i))
+             && (screen->info.mem_props.memoryTypes[i].propertyFlags & wanted)
+                == wanted) {
+            type = i;
+            break;
+         }
+      }
+   }
+   VkMemoryAllocateInfo mai = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = reqs.size,
+      .memoryTypeIndex = type,
+   };
+   void *map = NULL;
+   if (type == UINT32_MAX
+       || VKSCR(AllocateMemory)(screen->dev, &mai, NULL, &slot->memory)
+          != VK_SUCCESS) {
+      slot->memory = VK_NULL_HANDLE;
+      drop_back_slot(screen, slot);
+      return false;
+   }
+   if (VKSCR(BindBufferMemory)(screen->dev, slot->buffer, slot->memory, 0)
+          != VK_SUCCESS
+       || VKSCR(MapMemory)(screen->dev, slot->memory, 0, VK_WHOLE_SIZE, 0,
+                           &map) != VK_SUCCESS) {
+      drop_back_slot(screen, slot);
+      return false;
+   }
+   slot->map = map;
+   slot->size = size;
+   slot->coherent = (screen->info.mem_props.memoryTypes[type].propertyFlags
+                     & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0;
+   return true;
+}
+
+
+static void release_at_exit(void);
+
+
+/* Clips one of the present's rectangles to the image and to a surface of
+ * width x height pixels; false if nothing is left. */
+static bool
+clip_rect(const struct summit_haiku_present *p, uint32_t i,
+          unsigned image_width, unsigned image_height, uint32_t width,
+          uint32_t height, int32_t *left, int32_t *top, int32_t *right,
+          int32_t *bottom)
+{
+   const int32_t *r = p->rects + i * 4;
+   *left = MAX2(MAX2(r[0], p->origin_x), 0);
+   *top = MAX2(MAX2(r[1], p->origin_y), 0);
+   *right = MIN2(MIN2(r[2] + 1, p->origin_x + (int32_t)image_width),
+                 (int32_t)width);
+   *bottom = MIN2(MIN2(r[3] + 1, p->origin_y + (int32_t)image_height),
+                  (int32_t)height);
+   return *right > *left && *bottom > *top;
+}
+
+
+static VkBufferImageCopy
+image_region(const struct summit_haiku_present *p, struct zink_resource *res,
+             int32_t left, int32_t top, int32_t right, int32_t bottom,
+             uint64_t offset, uint32_t row_length)
+{
+   return (VkBufferImageCopy) {
+      .bufferOffset = offset,
+      .bufferRowLength = row_length,
+      .bufferImageHeight = bottom - top,
+      .imageSubresource = {
+         .aspectMask = res->aspect,
+         .mipLevel = 0,
+         .baseArrayLayer = 0,
+         .layerCount = 1,
+      },
+      .imageOffset = { left - p->origin_x, top - p->origin_y, 0 },
+      .imageExtent = { right - left, bottom - top, 1 },
+   };
+}
+
+
+/* The frame buffer's regions: straight into a linear surface. */
+static unsigned
+front_regions(VkBufferImageCopy *regions, const struct summit_haiku_present *p,
+              struct zink_resource *res, unsigned image_width,
+              unsigned image_height)
+{
+   unsigned count = 0;
+   for (uint32_t i = 0; i < p->rect_count && count < MAX_RECTS; i++) {
+      int32_t left, top, right, bottom;
+      if (!clip_rect(p, i, image_width, image_height, state.scanout_width,
+                     state.scanout_height, &left, &top, &right, &bottom))
+         continue;
+      regions[count++] = image_region(p, res, left, top, right, bottom,
+         (uint64_t)top * state.scanout_row_pitch + (uint64_t)left * 4,
+         state.scanout_row_pitch / 4);
+   }
+   return count;
+}
+
+
+/* The window system's copy: each rectangle packed into the slot's staging
+ * buffer, and remembered for the helper thread. */
+static unsigned
+back_regions(VkBufferImageCopy *regions, struct back_slot *slot,
+             const struct summit_haiku_present *p, struct zink_resource *res,
+             unsigned image_width, unsigned image_height, uint64_t *bytes)
+{
+   unsigned count = 0;
+   uint64_t offset = 0;
+   for (uint32_t i = 0; i < p->rect_count && count < MAX_RECTS; i++) {
+      int32_t left, top, right, bottom;
+      if (!clip_rect(p, i, image_width, image_height, p->back_width,
+                     p->back_height, &left, &top, &right, &bottom))
+         continue;
+      const uint32_t width = right - left, height = bottom - top;
+      const uint32_t row_length = align(width, BACK_ROW_ALIGN);
+      regions[count] = image_region(p, res, left, top, right, bottom, offset,
+                                    row_length);
+      slot->rects[count] = (struct back_rect) {
+         .left = left,
+         .top = top,
+         .width = width,
+         .height = height,
+         .row_pitch = row_length * 4,
+         .offset = offset,
+      };
+      count++;
+      offset += (uint64_t)row_length * 4 * height;
+   }
+   *bytes = offset;
+   return count;
+}
+
+
+int
+zink_haiku_present(struct pipe_context *pipe, struct pipe_resource *image,
+                   const struct summit_haiku_present *p)
+{
+   if (pipe == NULL || image == NULL || p == NULL
+       || p->version != SUMMIT_HAIKU_PRESENT_VERSION
+       || (p->rect_count > 0 && p->rects == NULL))
+      return -1;
+   /* The screen holds 32 bit pixels in the order B, G, R, A; copying is
+    * byte for byte, so the image must be in that order already. */
+   if (image->format != PIPE_FORMAT_B8G8R8A8_UNORM
+       && image->format != PIPE_FORMAT_B8G8R8X8_UNORM)
+      return -2;
+
+   struct zink_context *ctx = zink_context(threaded_context_unwrap_sync(pipe));
+   struct zink_screen *screen = zink_screen(image->screen);
+   struct zink_resource *res = zink_resource(image);
+   if (res->obj->is_buffer)
+      return -1;
+
+   pthread_mutex_lock(&state.lock);
+   if (state.screen != NULL && state.screen != screen) {
+      pthread_mutex_unlock(&state.lock);
+      return -1;
+   }
+   state.screen = screen;
+   if (!state.thread_started) {
+      /* Normally the display is destroyed, or the program lets go, first. */
+      atexit(release_at_exit);
+      if (pthread_create(&state.thread, NULL, completion_thread, NULL) != 0) {
+         pthread_mutex_unlock(&state.lock);
+         return -1;
+      }
+      state.thread_started = true;
+   }
+   /* Keep the GPU from falling more than a few frames behind; each present
+    * in flight may hold a staging buffer. */
+   unsigned in_flight = p->frames_in_flight ? p->frames_in_flight : 2;
+   in_flight = CLAMP(in_flight, 1, BACK_SLOTS);
+   while (state.submitted - state.finished >= in_flight
+          || state.queue_count == MAX_QUEUED)
+      pthread_cond_wait(&state.changed, &state.lock);
+
+   const unsigned image_width = image->width0;
+   const unsigned image_height = image->height0;
+   static VkBufferImageCopy front[MAX_RECTS], back[MAX_RECTS];
+   unsigned front_count = 0, back_count = 0;
+   int slot_index = -1;
+   int result = 0;
+
+   if (p->front_bytes_per_row != 0) {
+      if (acquire_scanout(screen, p->front_bytes_per_row))
+         front_count = front_regions(front, p, res, image_width, image_height);
+      else
+         result = -3;
+   }
+   if (result == 0 && p->back_bits != NULL) {
+      if (p->back_bytes_per_row < p->back_width * 4)
+         result = -4;
+      else {
+         /* free: the present that used it last has finished */
+         slot_index = state.submitted % BACK_SLOTS;
+         struct back_slot *slot = &state.back[slot_index];
+         uint64_t bytes = 0;
+         back_count = back_regions(back, slot, p, res, image_width,
+                                   image_height, &bytes);
+         if (back_count != 0 && !ensure_back_slot(screen, slot, bytes))
+            result = -4;
+         else {
+            slot->count = back_count;
+            slot->bits = p->back_bits;
+            slot->bytes_per_row = p->back_bytes_per_row;
+            slot->used = bytes;
+         }
+      }
+   }
+   if (result == 0 && front_count == 0 && back_count == 0)
+      result = p->rect_count == 0 ? 0 : -5;
+   if (result != 0 || (front_count == 0 && back_count == 0)) {
+      pthread_mutex_unlock(&state.lock);
+      if (result == 0 && p->completed != NULL)
+         p->completed(p->cookie);
+      return result;
+   }
+
+   uint64_t batch_id = 0;
+   if (!screen->device_lost) {
+      /* what was drawn last, a clear that is still pending included */
+      zink_fb_clears_apply(ctx, image, 0, 1);
+      zink_batch_no_rp(ctx);
+      screen->image_barrier(ctx, res, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                            VK_ACCESS_TRANSFER_READ_BIT,
+                            VK_PIPELINE_STAGE_TRANSFER_BIT);
+      zink_batch_reference_resource_rw(ctx, res, false);
+      VkCommandBuffer cmdbuf = ctx->bs->cmdbuf;
+
+      /* The previous present wrote the same memory: order the writes. */
+      VkMemoryBarrier before = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+         .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+         .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+      };
+      VKCTX(CmdPipelineBarrier)(cmdbuf, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &before,
+                                0, NULL, 0, NULL);
+      if (front_count != 0)
+         VKCTX(CmdCopyImageToBuffer)(cmdbuf, res->obj->image, res->layout,
+                                     state.scanout_buffer, front_count, front);
+      if (back_count != 0)
+         VKCTX(CmdCopyImageToBuffer)(cmdbuf, res->obj->image, res->layout,
+                                     state.back[slot_index].buffer,
+                                     back_count, back);
+      /* The helper thread reads the staging buffer with the processor. */
+      VkMemoryBarrier after = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+         .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+         .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+      };
+      VKCTX(CmdPipelineBarrier)(cmdbuf, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                VK_PIPELINE_STAGE_HOST_BIT, 0, 1, &after,
+                                0, NULL, 0, NULL);
+      ctx->bs->has_work = true;
+
+      struct pipe_fence_handle *fence = NULL;
+      ctx->base.flush(&ctx->base, &fence, 0);
+      /* The batch's number on the timeline, once it has been submitted (on
+       * the flush thread when submission is threaded); then the fence goes,
+       * here, on the context's own thread. */
+      struct zink_tc_fence *mfence = zink_tc_fence(fence);
+      if (mfence != NULL && mfence->fence != NULL) {
+         struct zink_batch_state *bs = zink_batch_state(mfence->fence);
+         if (screen->threaded_submit)
+            util_queue_fence_wait(&bs->flush_completed);
+         batch_id = mfence->fence->batch_id;
+      }
+      screen->base.fence_reference(&screen->base, &fence, NULL);
+   }
+
+   unsigned tail = (state.queue_head + state.queue_count) % MAX_QUEUED;
+   state.queue[tail] = (struct completion) {
+      .batch_id = batch_id,
+      .completed = p->completed,
+      .cookie = p->cookie,
+      .slot = back_count != 0 ? slot_index : -1,
+   };
+   state.queue_count++;
+   state.submitted++;
+   pthread_cond_broadcast(&state.changed);
+   pthread_mutex_unlock(&state.lock);
+   return 0;
+}
+
+
+void
+zink_haiku_present_release(struct pipe_screen *pscreen)
+{
+   pthread_mutex_lock(&state.lock);
+   struct zink_screen *screen = state.screen;
+   if (screen != NULL && (pscreen == NULL || &screen->base == pscreen)) {
+      /* the presents first: their copies still use what goes */
+      wait_idle_locked();
+      for (unsigned i = 0; i < BACK_SLOTS; i++)
+         drop_back_slot(screen, &state.back[i]);
+      drop_scanout(screen);
+      if (pscreen != NULL)
+         state.screen = NULL;
+   }
+   pthread_mutex_unlock(&state.lock);
+}
+
+
+static void
+release_at_exit(void)
+{
+   zink_haiku_present_release(NULL);
+#ifdef __HAIKU__
+   pthread_mutex_lock(&state.lock);
+   if (state.display_fd >= 0)
+      close(state.display_fd);
+   state.display_fd = -1;
+   pthread_mutex_unlock(&state.lock);
+#endif
+}
+
+
+void
+zink_haiku_present_wait_idle(void)
+{
+   pthread_mutex_lock(&state.lock);
+   wait_idle_locked();
+   pthread_mutex_unlock(&state.lock);
+}
diff -ruN a/src/gallium/drivers/zink/zink_haiku_present.h b/src/gallium/drivers/zink/zink_haiku_present.h
--- a/src/gallium/drivers/zink/zink_haiku_present.h
+++ b/src/gallium/drivers/zink/zink_haiku_present.h
@@ -0,0 +1,89 @@
+/*
+ * Presenting a finished frame straight into the screen on Haiku, for a
+ * program that composites with OpenGL ES through EGL (Summit's web process).
+ *
+ * The frame is copied into the rectangles of the screen the window system
+ * says are visible: by the GPU into the frame buffer the display scans out
+ * (imported through VkImportScanoutMemoryHAIKU, vk_haiku_scanout.h), and
+ * into the window system's own copy of the screen, which it draws into
+ * first and copies to the frame buffer (a direct window with
+ * B_DIRECT_DEVICE_PIXELS is handed it as drawing_bits_area). On air/OS the
+ * GPU copies the rectangles into a buffer of zink's own in cached memory and
+ * a helper thread copies them on into the window system's copy once the GPU
+ * is done: the GPU never writes memory app_server's processor writes too.
+ * Nothing waits for the GPU on the program's thread.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef ZINK_HAIKU_PRESENT_H
+#define ZINK_HAIKU_PRESENT_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct pipe_context;
+struct pipe_resource;
+struct pipe_screen;
+
+#define SUMMIT_HAIKU_PRESENT_VERSION 1
+
+struct summit_haiku_present {
+   uint32_t version;              /* SUMMIT_HAIKU_PRESENT_VERSION */
+   /* Where the image's top left texel goes, in frame buffer pixels. */
+   int32_t origin_x, origin_y;
+   /* What to copy, in frame buffer pixels, both edges included (as
+    * clipping_rect): left, top, right, bottom for each. Already clipped to
+    * what is visible; parts outside the image or the screen are dropped. */
+   uint32_t rect_count;
+   const int32_t *rects;
+   /* The frame buffer's row length, to recognise it; 0 skips it. */
+   uint32_t front_bytes_per_row;
+   /* The window system's copy of the screen as mapped in this team, or
+    * NULL. It is written by a helper thread before completed() is called,
+    * so the mapping must stay until then. */
+   void *back_bits;
+   uint32_t back_bytes_per_row;
+   uint32_t back_width, back_height;
+   /* Presents that may still be running on the GPU when another starts;
+    * the call waits for older ones. 0 means 2. */
+   uint32_t frames_in_flight;
+   /* Called on a helper thread once this present's copies are done (or at
+    * once if there was nothing to copy), also when the device was lost and
+    * nothing could be copied. May be NULL. */
+   void (*completed)(void *cookie);
+   void *cookie;
+};
+
+/* Returns 0 when the copies were submitted, a negative number when this
+ * present cannot go to the screen (the caller then presents some other way):
+ * -1 bad arguments, -2 unsupported image format, -3 no frame buffer to be had
+ * or it is not the one described, -4 the window system's copy could not be
+ * made, -5 nothing visible. */
+int zink_haiku_present(struct pipe_context *pipe, struct pipe_resource *image,
+                       const struct summit_haiku_present *present);
+
+/* Waits until every present submitted so far has finished. */
+void zink_haiku_present_wait_idle(void);
+
+/* Waits for the presents, then lets go of the frame buffer and of the
+ * staging buffers, for the given screen or any (NULL). Call before the
+ * program or the screen goes away. Presenting again takes hold of them
+ * again. */
+void zink_haiku_present_release(struct pipe_screen *screen);
+
+/* Summit's entry points, exported by the EGL library (Haiku) or the DRI
+ * driver (the Linux host build), for the current context; see
+ * zink_haiku_present_gl.c. */
+int summit_haiku_present_framebuffer(unsigned framebuffer,
+                                     const struct summit_haiku_present *present);
+void summit_haiku_present_wait_idle(void);
+void summit_haiku_present_release(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZINK_HAIKU_PRESENT_H */
diff -ruN a/src/gallium/drivers/zink/zink_haiku_present_gl.c b/src/gallium/drivers/zink/zink_haiku_present_gl.c
--- a/src/gallium/drivers/zink/zink_haiku_present_gl.c
+++ b/src/gallium/drivers/zink/zink_haiku_present_gl.c
@@ -0,0 +1,63 @@
+/*
+ * Summit's entry points to zink_haiku_present.h, for the current OpenGL
+ * (ES) context. Summit's web process composites each page into a
+ * framebuffer object and finds these with get_image_symbol() in
+ * libEGL_mesa, so EGL's dispatch tables stay as they are. Built into the
+ * Haiku EGL driver, and into the DRI driver of the Linux host build, where
+ * build.sh's smoke test calls them.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <string.h>
+
+#include "main/glthread.h"
+#include "main/mtypes.h"
+#include "glapi/glapi/glapi.h"
+#include "state_tracker/st_context.h"
+#include "util/macros.h"
+
+#include "zink/zink_haiku_present.h"
+
+/* The framebuffer object must be the one bound for drawing, as it is when a
+ * frame has just been composited into it. Returns 0 when the copies were
+ * submitted, a negative number when the caller has to present some other
+ * way (see zink_haiku_present.h; -10: no current context or not a zink one,
+ * -11: that framebuffer object is not bound or has no colour renderbuffer).
+ */
+PUBLIC int
+summit_haiku_present_framebuffer(unsigned framebuffer,
+                                 const struct summit_haiku_present *present)
+{
+   GET_CURRENT_CONTEXT(ctx);
+   if (ctx == NULL || ctx->st == NULL)
+      return -10;
+   _mesa_glthread_finish(ctx);
+
+   struct st_context *st = ctx->st;
+   struct pipe_screen *screen = st->screen;
+   if (screen == NULL || screen->get_name == NULL
+       || strncmp(screen->get_name(screen), "zink", 4) != 0)
+      return -10;
+
+   struct gl_framebuffer *fb = ctx->DrawBuffer;
+   if (fb == NULL || framebuffer == 0 || fb->Name != framebuffer)
+      return -11;
+   struct gl_renderbuffer *rb = fb->Attachment[BUFFER_COLOR0].Renderbuffer;
+   if (rb == NULL || rb->texture == NULL)
+      return -11;
+
+   return zink_haiku_present(st->pipe, rb->texture, present);
+}
+
+PUBLIC void
+summit_haiku_present_wait_idle(void)
+{
+   zink_haiku_present_wait_idle();
+}
+
+PUBLIC void
+summit_haiku_present_release(void)
+{
+   zink_haiku_present_release(NULL);
+}
diff -ruN a/src/gallium/drivers/zink/zink_resource.c b/src/gallium/drivers/zink/zink_resource.c
--- a/src/gallium/drivers/zink/zink_resource.c
+++ b/src/gallium/drivers/zink/zink_resource.c
@@ -1160,6 +1160,17 @@
       for (unsigned i = 0; !obj->bo && i < screen->heap_count[heap]; i++) {
          if (!(reqs->memoryTypeBits & BITFIELD_BIT(screen->heap_map[heap][i])))
             continue;
+         /* Coherent and persistent maps are never flushed or invalidated:
+          * not in host memory that is not coherent (see zink_screen.c).
