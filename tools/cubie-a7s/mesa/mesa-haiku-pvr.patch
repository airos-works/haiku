+/* The device's cache of freed device memory (air/OS).
+ *
+ * zink frees and allocates device memory every frame of a WebGL page: an
+ * image or two (a new texture per frame) and its stream uploads when its own
+ * cache cannot take them back while the GPU still reads them. Each was a
+ * CREATE_BO, VM_MAP and MAP_BO, and a VM_UNMAP and GEM_CLOSE to free it. A
+ * freed memory object's buffer object is kept here, with its GPU mapping
+ * (pvr_memory_shared_vma()) and its CPU map, and handed to the next
+ * allocation of the same memory type and size (in pages). Its contents are
+ * left as they were, as zink's own cache leaves them: Vulkan memory starts
+ * undefined. Memory that is imported, exported, for display or mapped at a
+ * placed address is not kept. At most PVR_MEMORY_CACHE_MAX_BYTES
+ * (PVR_MEMORY_CACHE_MB, 0 = off), the least recently freed first out.
+ */
+#define PVR_MEMORY_CACHE_MAX_BYTES (128ull * 1024 * 1024)
+
+struct pvr_memory_cache_entry {
+   struct list_head link;
+   uint32_t memory_type;
+   struct pvr_winsys_bo *bo;
+   struct pvr_winsys_vma *vma;
+};
+
+void pvr_memory_cache_init(struct pvr_device *device)
+{
+   simple_mtx_init(&device->memory_cache.mtx, mtx_plain);
+   list_inithead(&device->memory_cache.lru);
+   device->memory_cache.bytes = 0;
+   device->memory_cache.max_bytes =
+      debug_get_num_option("PVR_MEMORY_CACHE_MB",
+                           PVR_MEMORY_CACHE_MAX_BYTES >> 20)
+      << 20;
+   device->memory_cache.enabled = device->memory_cache.max_bytes != 0;
+}
+
+static void pvr_memory_cache_destroy_entry(struct pvr_device *device,
+                                           struct pvr_memory_cache_entry *entry)
+{
+   if (entry->bo->map)
+      device->ws->ops->buffer_unmap(entry->bo, false);
+   if (entry->vma)
+      pvr_unbind_memory(device, entry->vma);
+   device->ws->ops->buffer_destroy(entry->bo);
+   vk_free(&device->vk.alloc, entry);
+}
+
+void pvr_memory_cache_finish(struct pvr_device *device)
+{
+   struct list_head evicted;
+
+   list_inithead(&evicted);
+   simple_mtx_lock(&device->memory_cache.mtx);
+   device->memory_cache.enabled = false;
+   list_splicetail(&device->memory_cache.lru, &evicted);
+   list_inithead(&device->memory_cache.lru);
+   device->memory_cache.bytes = 0;
+   simple_mtx_unlock(&device->memory_cache.mtx);
+
+   list_for_each_entry_safe (struct pvr_memory_cache_entry,
+                             entry,
+                             &evicted,
+                             link) {
+      list_del(&entry->link);
+      pvr_memory_cache_destroy_entry(device, entry);
+   }
+}
