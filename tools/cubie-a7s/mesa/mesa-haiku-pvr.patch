+static FILE *pvr_render_log;
+static once_flag pvr_render_log_once = ONCE_FLAG_INIT;
+
+static void pvr_render_log_open(void)
+{
+   const char *dest = getenv("PVR_LOG_RENDERS");
+
+   if (!dest || !*dest || !strcmp(dest, "0"))
+      return;
+
+   if (!strcmp(dest, "1") || !strcmp(dest, "stderr")) {
+      pvr_render_log = stderr;
+      return;
+   }
+
+   pvr_render_log = fopen(dest, "a");
+   if (pvr_render_log)
+      setvbuf(pvr_render_log, NULL, _IOLBF, 0);
