+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef PVR_HOST_CACHE_H
+#define PVR_HOST_CACHE_H
+
+/* The host-cached memory type (air/OS): HOST_VISIBLE | HOST_CACHED, not
+ * HOST_COHERENT. The GPU does not snoop the CPU caches, so CPU maps of the
+ * other type are write-combined, which is slow to read: zink's readback of
+ * every GL frame read from such memory. Buffers of this type are mapped
+ * write-back cached (PVR_HAIKU_MAP_BO_CACHED), and vkFlushMappedMemoryRanges()
+ * and vkInvalidateMappedMemoryRanges() keep them coherent with the data cache
+ * maintenance instructions EL0 may use on arm64 ("dc cvac" cleans what the CPU
+ * wrote before the GPU reads it, "dc civac" cleans and invalidates what the
+ * CPU will read after the GPU wrote it).
+ *
+ * PVR_CACHED_MEMORY_TYPE=0 hides the type, =1 shows it off air/OS too (the
+ * host smoke test, where all memory is coherent and the maintenance is a
+ * no-op).
+ */
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "util/detect_os.h"
+#include "util/macros.h"
+#include "util/u_debug.h"
+
+static inline bool pvr_host_cached_memory_type_enabled(void)
+{
+   return debug_get_bool_option("PVR_CACHED_MEMORY_TYPE", DETECT_OS_HAIKU);
+}
+
+#if defined(__aarch64__)
+static inline uint64_t pvr_host_ctr_el0(void)
+{
+   uint64_t ctr;
+
+   __asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+   return ctr;
+}
+#endif
+
+/* The smallest data cache line: the stride of the maintenance loops. */
+static inline uintptr_t pvr_host_dcache_line_size(void)
+{
+#if defined(__aarch64__)
+   /* DminLine, log2 of the number of words */
+   return 4u << ((pvr_host_ctr_el0() >> 16) & 0xf);
+#else
+   return 64;
+#endif
+}
+
+/* VkPhysicalDeviceLimits::nonCoherentAtomSize: no smaller than the largest
+ * line any cache might write back (CTR_EL0.CWG), so that maintenance of one
+ * atom never touches its neighbours' lines.
+ */
+static inline uint32_t pvr_host_noncoherent_atom_size(void)
+{
+   uint32_t size = 64;
+
+#if defined(__aarch64__)
+   const uint64_t ctr = pvr_host_ctr_el0();
+   const uint32_t cwg = (ctr >> 24) & 0xf;
+
+   size = MAX2(size, 4u << ((ctr >> 16) & 0xf));
+   if (cwg != 0)
+      size = MAX2(size, 4u << cwg);
+#endif
+
+   return size;
+}
+
+/* Clean (CPU writes to memory, for the GPU to read) or clean and invalidate
+ * (so the CPU reads what the GPU wrote) the lines covering [addr, addr+size).
+ */
+static inline void
+pvr_host_cache_maintain(const void *addr, size_t size, bool invalidate)
+{
+#if defined(__aarch64__)
+   const uintptr_t line = pvr_host_dcache_line_size();
+   const uintptr_t end = (uintptr_t)addr + size;
+   uintptr_t p = (uintptr_t)addr & ~(line - 1);
+
+   if (invalidate) {
+      for (; p < end; p += line)
+         __asm__ volatile("dc civac, %0" : : "r"(p) : "memory");
+   } else {
+      for (; p < end; p += line)
+         __asm__ volatile("dc cvac, %0" : : "r"(p) : "memory");
+   }
+
+   __asm__ volatile("dsb sy" : : : "memory");
+#else
+   (void)addr;
+   (void)size;
+   (void)invalidate;
+#endif
+}
+
+#endif /* PVR_HOST_CACHE_H */
