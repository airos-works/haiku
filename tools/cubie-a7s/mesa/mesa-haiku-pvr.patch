+/******************************************************************************
+   (air/OS) Transform feedback emulation (pvr_xfb.h)
+ ******************************************************************************/
+
+/* All of a render's kernels go into one compute sub-command, appended after
+ * the (still open) graphics one and kept in state->xfb.sub_cmd until it is
+ * flushed: at the end of the render, before any barrier, transfer or query
+ * sub-command, and at the end of the command buffer. Each kernel waits for
+ * the ones before it (a draw's kernel reads the offsets the previous draw's
+ * post kernel wrote).
+ */
+static void pvr_xfb_fence(struct pvr_cmd_buffer *cmd_buffer,
+                          struct pvr_sub_cmd_compute *const sub_cmd)
+{
+   pvr_compute_generate_idfwdf(cmd_buffer, sub_cmd);
+   pvr_arch_compute_generate_fence(cmd_buffer, sub_cmd, false);
+}
+
+/* Makes the transform feedback sub-command current, creating it if there is
+ * none; *prev_out gets the sub-command to restore with pvr_xfb_end_kernels().
+ */
+static VkResult pvr_xfb_begin_kernels(struct pvr_cmd_buffer *cmd_buffer,
+                                      struct pvr_sub_cmd **prev_out)
+{
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   VkResult result;
+
+   *prev_out = state->current_sub_cmd;
+
+   if (!state->xfb.sub_cmd) {
+      state->current_sub_cmd = NULL;
+      result = pvr_arch_cmd_buffer_start_sub_cmd(cmd_buffer,
+                                                 PVR_SUB_CMD_TYPE_COMPUTE);
+      if (result != VK_SUCCESS) {
+         state->current_sub_cmd = *prev_out;
+         return result;
+      }
+
+      state->xfb.sub_cmd = state->current_sub_cmd;
+      state->xfb.kernels = 0;
+   } else {
+      state->current_sub_cmd = state->xfb.sub_cmd;
+   }
+
+   assert(state->current_sub_cmd->type == PVR_SUB_CMD_TYPE_COMPUTE);
+
+   if (state->xfb.kernels > 0)
+      pvr_xfb_fence(cmd_buffer, &state->current_sub_cmd->compute);
+
+   if (PVR_IS_DEBUG_SET(DUMP_XFB)) {
+      fprintf(stderr,
+              "pvr xfb: kernel %u into sub_cmd %p (previous %p)\n",
+              state->xfb.kernels,
+              (void *)state->xfb.sub_cmd,
+              (void *)*prev_out);
+   }
+
+   return VK_SUCCESS;
+}
+
+static void pvr_xfb_end_kernels(struct pvr_cmd_buffer *cmd_buffer,
+                                struct pvr_sub_cmd *prev)
+{
+   cmd_buffer->state.current_sub_cmd = prev;
+}
+
+/* Ends the transform feedback sub-command, if one is open. */
+static VkResult pvr_xfb_flush(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   struct pvr_sub_cmd *prev = state->current_sub_cmd;
+   VkResult result;
+
+   if (!state->xfb.sub_cmd)
+      return VK_SUCCESS;
+
+   if (PVR_IS_DEBUG_SET(DUMP_XFB)) {
+      fprintf(stderr,
+              "pvr xfb: flush sub_cmd %p with %u kernels\n",
+              (void *)state->xfb.sub_cmd,
+              state->xfb.kernels);
+   }
+
+   assert(prev != state->xfb.sub_cmd);
+
+   state->current_sub_cmd = state->xfb.sub_cmd;
+   state->xfb.sub_cmd = NULL;
+   state->xfb.kernels = 0;
+   result = pvr_arch_cmd_buffer_end_sub_cmd(cmd_buffer);
+   state->current_sub_cmd = prev;
+
+   return result;
+}
+
+/* The command buffer's offsets block, made at the first use. */
+static VkResult pvr_xfb_ensure_state(struct pvr_cmd_buffer *cmd_buffer)
+{
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   VkResult result;
+
+   if (state->xfb.state_bo)
+      return VK_SUCCESS;
+
+   result = pvr_arch_cmd_buffer_alloc_mem(cmd_buffer,
+                                          cmd_buffer->device->heaps.general_heap,
+                                          PVR_DW_TO_BYTES(_PVR_XFB_STATE_COUNT),
+                                          &state->xfb.state_bo);
+   if (result != VK_SUCCESS)
+      return result;
+
+   memset(pvr_bo_suballoc_get_map_addr(state->xfb.state_bo),
+          0,
+          PVR_DW_TO_BYTES(_PVR_XFB_STATE_COUNT));
+
+   return VK_SUCCESS;
+}
+
+static VkResult pvr_xfb_counters(struct pvr_cmd_buffer *cmd_buffer,
+                                 uint32_t mode,
+                                 uint32_t first_counter_buffer,
+                                 uint32_t counter_buffer_count,
+                                 const VkBuffer *counter_buffers,
+                                 const VkDeviceSize *counter_buffer_offsets)
+{
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   uint32_t data[_PVR_XFB_COUNTERS_DATA_COUNT] = { 0 };
+   struct pvr_sub_cmd *prev;
+   VkResult result;
+
+   result = pvr_xfb_ensure_state(cmd_buffer);
+   if (result != VK_SUCCESS)
+      return result;
+
+   data[PVR_XFB_COUNTERS_DATA_MODE] = mode;
+   data[PVR_XFB_COUNTERS_DATA_STATE_LO] = state->xfb.state_bo->dev_addr.addr;
+   data[PVR_XFB_COUNTERS_DATA_STATE_HI] =
+      state->xfb.state_bo->dev_addr.addr >> 32;
+
+   for (uint32_t i = 0; i < counter_buffer_count; i++) {
+      const uint32_t buffer_index = first_counter_buffer + i;
+      uint64_t addr = 0;
+
+      if (buffer_index >= PVR_XFB_MAX_BUFFERS)
+         break;
+
+      if (counter_buffers && counter_buffers[i] != VK_NULL_HANDLE) {
+         VK_FROM_HANDLE(pvr_buffer, buffer, counter_buffers[i]);
+         addr = buffer->dev_addr.addr +
+                (counter_buffer_offsets ? counter_buffer_offsets[i] : 0);
+      }
+
+      data[PVR_XFB_COUNTERS_DATA_COUNTER0_LO + 2 * buffer_index] = addr;
+      data[PVR_XFB_COUNTERS_DATA_COUNTER0_HI + 2 * buffer_index] = addr >> 32;
+   }
+
+   result = pvr_xfb_begin_kernels(cmd_buffer, &prev);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = pvr_arch_cmd_buffer_dispatch_private_program(
+      cmd_buffer,
+      &cmd_buffer->device->xfb_counters_shader,
+      data,
+      _PVR_XFB_COUNTERS_DATA_COUNT,
+      1,
+      1);
+   state->xfb.kernels++;
+
+   pvr_xfb_end_kernels(cmd_buffer, prev);
+
+   return result;
+}
+
+void PVR_PER_ARCH(CmdBindTransformFeedbackBuffersEXT)(
+   VkCommandBuffer commandBuffer,
+   uint32_t firstBinding,
+   uint32_t bindingCount,
+   const VkBuffer *pBuffers,
+   const VkDeviceSize *pOffsets,
+   const VkDeviceSize *pSizes)
+{
+   VK_FROM_HANDLE(pvr_cmd_buffer, cmd_buffer, commandBuffer);
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+
+   PVR_CHECK_COMMAND_BUFFER_BUILDING_STATE(cmd_buffer);
+
+   for (uint32_t i = 0; i < bindingCount; i++) {
+      const uint32_t binding = firstBinding + i;
+      VK_FROM_HANDLE(pvr_buffer, buffer, pBuffers[i]);
+
+      if (binding >= PVR_XFB_MAX_BUFFERS)
+         break;
+
+      state->xfb.buffers[binding].buffer = buffer;
+      state->xfb.buffers[binding].offset = pOffsets[i];
+      state->xfb.buffers[binding].size =
+         buffer ? vk_buffer_range(&buffer->vk,
+                                  pOffsets[i],
+                                  pSizes ? pSizes[i] : VK_WHOLE_SIZE)
+                : 0;
+   }
+}
+
+void PVR_PER_ARCH(CmdBeginTransformFeedbackEXT)(
+   VkCommandBuffer commandBuffer,
+   uint32_t firstCounterBuffer,
+   uint32_t counterBufferCount,
+   const VkBuffer *pCounterBuffers,
+   const VkDeviceSize *pCounterBufferOffsets)
+{
+   VK_FROM_HANDLE(pvr_cmd_buffer, cmd_buffer, commandBuffer);
+   VkResult result;
+
+   PVR_CHECK_COMMAND_BUFFER_BUILDING_STATE(cmd_buffer);
+
+   cmd_buffer->state.xfb.enabled = true;
+
+   result = pvr_xfb_counters(cmd_buffer,
+                             PVR_XFB_COUNTERS_MODE_BEGIN,
+                             firstCounterBuffer,
+                             counterBufferCount,
+                             pCounterBuffers,
+                             pCounterBufferOffsets);
+   if (result != VK_SUCCESS)
+      vk_command_buffer_set_error(&cmd_buffer->vk, result);
+}
+
+void PVR_PER_ARCH(CmdEndTransformFeedbackEXT)(
+   VkCommandBuffer commandBuffer,
+   uint32_t firstCounterBuffer,
+   uint32_t counterBufferCount,
+   const VkBuffer *pCounterBuffers,
+   const VkDeviceSize *pCounterBufferOffsets)
+{
+   VK_FROM_HANDLE(pvr_cmd_buffer, cmd_buffer, commandBuffer);
+   VkResult result;
+
+   PVR_CHECK_COMMAND_BUFFER_BUILDING_STATE(cmd_buffer);
+
+   result = pvr_xfb_counters(cmd_buffer,
+                             PVR_XFB_COUNTERS_MODE_END,
+                             firstCounterBuffer,
+                             counterBufferCount,
+                             pCounterBuffers,
+                             pCounterBufferOffsets);
+   if (result != VK_SUCCESS)
+      vk_command_buffer_set_error(&cmd_buffer->vk, result);
+
+   cmd_buffer->state.xfb.enabled = false;
+}
+
+/* A transform feedback query program (cs_xfb_query_common): into the
+ * transform feedback sub-command (the availability write at the end of a
+ * query, in order after the draws), or as a compute sub-command of its own
+ * (reset and copy, outside a render).
+ */
+VkResult PVR_PER_ARCH(cmd_buffer_xfb_query_program)(
+   struct pvr_cmd_buffer *cmd_buffer,
+   const struct pvr_query_pool *pool,
+   uint32_t mode,
+   uint32_t first_query,
+   uint32_t query_count,
+   pvr_dev_addr_t dest_addr,
+   uint32_t dest_stride,
+   VkQueryResultFlags flags,
+   bool with_draws)
+{
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   const uint64_t result_addr =
+      pool->result_buffer->dev_addr.addr +
+      first_query * PVR_DW_TO_BYTES(_PVR_XFB_QUERY_COUNT);
+   const uint64_t avail_addr =
+      pool->availability_buffer->dev_addr.addr + first_query * sizeof(uint32_t);
+   const uint32_t data[_PVR_XFB_QUERY_DATA_COUNT] = {
+      [PVR_XFB_QUERY_DATA_MODE] = mode,
+      [PVR_XFB_QUERY_DATA_COUNT] = query_count,
+      [PVR_XFB_QUERY_DATA_RESULT_LO] = result_addr,
+      [PVR_XFB_QUERY_DATA_RESULT_HI] = result_addr >> 32,
+      [PVR_XFB_QUERY_DATA_AVAIL_LO] = avail_addr,
+      [PVR_XFB_QUERY_DATA_AVAIL_HI] = avail_addr >> 32,
+      [PVR_XFB_QUERY_DATA_DEST_LO] = dest_addr.addr,
+      [PVR_XFB_QUERY_DATA_DEST_HI] = dest_addr.addr >> 32,
+      [PVR_XFB_QUERY_DATA_DEST_STRIDE] = dest_stride,
+      [PVR_XFB_QUERY_DATA_FLAGS] = flags,
+   };
+   struct pvr_sub_cmd *prev;
+   VkResult result;
+
+   if (with_draws) {
+      result = pvr_xfb_begin_kernels(cmd_buffer, &prev);
+      if (result != VK_SUCCESS)
+         return result;
+
+      result = pvr_arch_cmd_buffer_dispatch_private_program(
+         cmd_buffer,
+         &cmd_buffer->device->xfb_query_shader,
+         data,
+         _PVR_XFB_QUERY_DATA_COUNT,
+         query_count,
+         ROGUE_MAX_INSTANCES_PER_TASK);
+      state->xfb.kernels++;
+
+      pvr_xfb_end_kernels(cmd_buffer, prev);
+
+      return result;
+   }
+
+   result = pvr_xfb_flush(cmd_buffer);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result =
+      pvr_arch_cmd_buffer_start_sub_cmd(cmd_buffer, PVR_SUB_CMD_TYPE_COMPUTE);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = pvr_arch_cmd_buffer_dispatch_private_program(
+      cmd_buffer,
+      &cmd_buffer->device->xfb_query_shader,
+      data,
+      _PVR_XFB_QUERY_DATA_COUNT,
+      query_count,
+      ROGUE_MAX_INSTANCES_PER_TASK);
+   if (result != VK_SUCCESS)
+      return result;
+
+   return pvr_arch_cmd_buffer_end_sub_cmd(cmd_buffer);
+}
+
+/* After a draw's VDM commands: the same draw through the transform feedback
+ * kernel, then the post kernel that moves the offsets on and counts.
+ */
+static VkResult pvr_xfb_draw(struct pvr_cmd_buffer *cmd_buffer,
+                             uint32_t vertex_count,
+                             uint32_t instance_count,
+                             uint32_t first_vertex,
+                             uint32_t first_instance,
+                             uint32_t first_index)
+{
+   struct pvr_cmd_buffer_state *state = &cmd_buffer->state;
+   const struct vk_dynamic_graphics_state *dynamic_state =
+      &cmd_buffer->vk.dynamic_graphics_state;
+   const struct pvr_graphics_pipeline *pipeline = state->gfx_pipeline;
+   const struct pvr_compute_pipeline *xfb_cs = &pipeline->xfb_cs;
+   struct pvr_suballoc_bo *params_bo;
+   struct pvr_sub_cmd *prev;
+   uint32_t *params;
+   VkResult result;
+
+   if (PVR_IS_DEBUG_SET(DUMP_XFB)) {
+      fprintf(stderr,
+              "pvr xfb: draw %u x %u (first %u/%u, index %u) enabled %d "
+              "kernel %d sub_cmd %p\n",
+              vertex_count,
+              instance_count,
+              first_vertex,
+              first_instance,
+              first_index,
+              state->xfb.enabled,
+              pipeline->has_xfb,
+              (void *)state->xfb.sub_cmd);
+   }
+
+   if (!state->xfb.enabled || !pipeline->has_xfb)
+      return VK_SUCCESS;
+
+   if (state->draw_state.draw_indirect) {
+      pvr_finishme("transform feedback with indirect draws");
+      return VK_SUCCESS;
+   }
+
+   const enum pvr_xfb_topology topology =
+      pvr_xfb_topology(dynamic_state->ia.primitive_topology);
+   if (topology == PVR_XFB_TOPOLOGY_UNSUPPORTED) {
+      pvr_finishme("transform feedback with topology %u",
+                   dynamic_state->ia.primitive_topology);
+      return VK_SUCCESS;
+   }
+
+   const uint32_t verts_per_prim = pvr_xfb_verts_per_prim(topology);
+   const uint32_t prim_count = pvr_xfb_prim_count(topology, vertex_count);
+   const uint64_t total =
+      (uint64_t)prim_count * verts_per_prim * instance_count;
+
+   if (!total)
+      return VK_SUCCESS;
+
+   if (total > UINT32_MAX) {
+      pvr_finishme("transform feedback of more than 2^32 vertices");
+      return VK_SUCCESS;
+   }
+
+   result = pvr_xfb_ensure_state(cmd_buffer);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result =
+      pvr_arch_cmd_buffer_alloc_mem(cmd_buffer,
+                                    cmd_buffer->device->heaps.general_heap,
+                                    PVR_DW_TO_BYTES(_PVR_XFB_PARAMS_COUNT),
+                                    &params_bo);
+   if (result != VK_SUCCESS)
+      return result;
+
+   params = pvr_bo_suballoc_get_map_addr(params_bo);
+   memset(params, 0, PVR_DW_TO_BYTES(_PVR_XFB_PARAMS_COUNT));
+
+   params[PVR_XFB_PARAMS_SELF_LO] = params_bo->dev_addr.addr;
+   params[PVR_XFB_PARAMS_SELF_HI] = params_bo->dev_addr.addr >> 32;
+   params[PVR_XFB_PARAMS_STATE_LO] = state->xfb.state_bo->dev_addr.addr;
+   params[PVR_XFB_PARAMS_STATE_HI] = state->xfb.state_bo->dev_addr.addr >> 32;
+
+   if (state->xfb.query_pool) {
+      const uint64_t query_addr =
+         state->xfb.query_pool->result_buffer->dev_addr.addr +
+         state->xfb.query * PVR_DW_TO_BYTES(_PVR_XFB_QUERY_COUNT);
+      params[PVR_XFB_PARAMS_QUERY_LO] = query_addr;
+      params[PVR_XFB_PARAMS_QUERY_HI] = query_addr >> 32;
+   }
+
+   params[PVR_XFB_PARAMS_BUFFERS_WRITTEN] = pipeline->xfb_info.buffers_written;
+   params[PVR_XFB_PARAMS_VERTS_PER_PRIM] = verts_per_prim;
+   params[PVR_XFB_PARAMS_TOPOLOGY] = topology;
+   params[PVR_XFB_PARAMS_PRIM_COUNT] = prim_count;
+   params[PVR_XFB_PARAMS_VERTEX_COUNT] = vertex_count;
+   params[PVR_XFB_PARAMS_INSTANCE_COUNT] = instance_count;
+   params[PVR_XFB_PARAMS_FIRST_VERTEX] = first_vertex;
+   params[PVR_XFB_PARAMS_FIRST_INSTANCE] = first_instance;
+   params[PVR_XFB_PARAMS_RESTART_ENABLE] =
+      dynamic_state->ia.primitive_restart_enable;
+   params[PVR_XFB_PARAMS_TOTAL_VERTICES] = total;
+
+   if (state->draw_state.draw_indexed) {
+      const uint32_t index_size =
+         vk_index_type_to_bytes(state->index_buffer_binding.type);
+      const uint64_t index_addr =
+         state->index_buffer_binding.buffer->dev_addr.addr +
+         state->index_buffer_binding.offset + (uint64_t)first_index * index_size;
+
+      params[PVR_XFB_PARAMS_INDEX_LO] = index_addr;
+      params[PVR_XFB_PARAMS_INDEX_HI] = index_addr >> 32;
+      params[PVR_XFB_PARAMS_INDEX_SIZE] = index_size;
+   }
+
+   for (uint32_t b = 0; b < PVR_XFB_MAX_BUFFERS; b++) {
+      uint32_t *xfb = &params[PVR_XFB_PARAMS_XFB0 + b * PVR_XFB_PARAMS_XFB_DWORDS];
+
+      if (!(pipeline->xfb_info.buffers_written & BITFIELD_BIT(b)) ||
+          !state->xfb.buffers[b].buffer)
+         continue;
+
+      const uint64_t addr = state->xfb.buffers[b].buffer->dev_addr.addr +
+                            state->xfb.buffers[b].offset;
+      xfb[PVR_XFB_PARAMS_XFB_LO] = addr;
+      xfb[PVR_XFB_PARAMS_XFB_HI] = addr >> 32;
+      xfb[PVR_XFB_PARAMS_XFB_SIZE] = MIN2(state->xfb.buffers[b].size, UINT32_MAX);
+      xfb[PVR_XFB_PARAMS_XFB_STRIDE] = pipeline->xfb_info.strides[b];
+   }
+
+   for (uint32_t i = 0; i < PVR_XFB_MAX_VERTEX_BINDINGS; i++) {
+      const struct pvr_vertex_binding *binding = &state->vertex_bindings[i];
+      uint32_t *vb = &params[PVR_XFB_PARAMS_VB0 + i * PVR_XFB_PARAMS_VB_DWORDS];
+
+      if (!binding->buffer)
+         continue;
+
+      const uint64_t addr = binding->buffer->dev_addr.addr + binding->offset;
+      vb[PVR_XFB_PARAMS_VB_LO] = addr;
+      vb[PVR_XFB_PARAMS_VB_HI] = addr >> 32;
+      vb[PVR_XFB_PARAMS_VB_SIZE] = MIN2(binding->size, UINT32_MAX);
+      vb[PVR_XFB_PARAMS_VB_STRIDE] = dynamic_state->vi_binding_strides[i];
+   }
+
+   result = pvr_xfb_begin_kernels(cmd_buffer, &prev);
+   if (result != VK_SUCCESS)
+      return result;
+
