+/* (air/OS) As should_vectorize_mem_cb(), in powers of two: merged greedily,
+ * a run of scalar loads otherwise ends up in loads of 5 (4 + 1, then 5 + 1
+ * is no valid size), where rounds of 1 + 1, 2 + 2, 4 + 4 and 8 + 8 make
+ * loads of up to 16 (an ld's longest burst).
+ */
+static bool should_vectorize_mem_pow2_cb(unsigned align_mul,
+                                         unsigned align_offset,
+                                         unsigned bit_size,
+                                         unsigned num_components,
+                                         int64_t hole_size,
+                                         nir_intrinsic_instr *low,
+                                         nir_intrinsic_instr *high,
+                                         void *data)
+{
+   const unsigned max_components = *(const unsigned *)data;
+
+   if (!util_is_power_of_two_nonzero(num_components) ||
+       num_components > max_components)
+      return false;
+
+   return should_vectorize_mem_cb(align_mul,
+                                  align_offset,
+                                  bit_size,
+                                  num_components,
+                                  hole_size,
+                                  low,
+                                  high,
+                                  data);
+}
