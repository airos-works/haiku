+/* The device's cache of freed buffer objects (air/OS).
+ *
+ * Command buffers allocate buffer objects as they record (control streams,
+ * descriptor and uniform uploads through the sub-allocators, SPM constants)
+ * and free them when they are reset: dozens per frame of a WebGL page. Each
+ * cost a kernel round trip to create (an area, cleared), a GPU mapping, a
+ * CPU mapping (MAP_BO), and the same again to free. A freed CPU-mapped
+ * buffer object is kept here instead, with both mappings, and handed out
+ * again to the next allocation of the same heap, size (in pages), alignment
+ * and flags; cleared first, unless the caller says it need not be
+ * (PVR_BO_ALLOC_FLAG_NO_ZERO). At most PVR_BO_CACHE_MAX_BYTES are kept
+ * (PVR_BO_CACHE_MB in the environment, 0 turns the cache off); the least
+ * recently freed go first.
+ */
+#define PVR_BO_CACHE_MAX_BYTES (64ull * 1024 * 1024)
+/* larger ones are not kept */
+#define PVR_BO_CACHE_MAX_BO_BYTES (8ull * 1024 * 1024)
+
+struct pvr_bo_cache_bucket {
+   uint64_t key;
+   struct list_head bos; /* most recently freed first */
+};
+
+void pvr_bo_cache_init(struct pvr_device *device)
+{
+   simple_mtx_init(&device->bo_cache.mtx, mtx_plain);
+   util_dynarray_init(&device->bo_cache.buckets, NULL);
+   list_inithead(&device->bo_cache.lru);
+   device->bo_cache.bytes = 0;
+   device->bo_cache.max_bytes =
+      debug_get_num_option("PVR_BO_CACHE_MB", PVR_BO_CACHE_MAX_BYTES >> 20)
+      << 20;
+   device->bo_cache.enabled = device->bo_cache.max_bytes != 0;
+   device->bo_cache.hits = 0;
+   device->bo_cache.misses = 0;
+}
+
+static void pvr_bo_destroy(struct pvr_device *device, struct pvr_bo *pvr_bo);
+
+/* Empties the cache and keeps it off: frees after this destroy at once. */
+void pvr_bo_cache_finish(struct pvr_device *device)
+{
+   struct list_head evicted;
+
+   list_inithead(&evicted);
+
+   simple_mtx_lock(&device->bo_cache.mtx);
+   device->bo_cache.enabled = false;
+   list_for_each_entry_safe (struct pvr_bo,
+                             pvr_bo,
+                             &device->bo_cache.lru,
+                             cache_lru) {
+      list_del(&pvr_bo->link);
+      list_del(&pvr_bo->cache_lru);
+      list_addtail(&pvr_bo->cache_lru, &evicted);
+   }
+   device->bo_cache.bytes = 0;
+   util_dynarray_foreach (&device->bo_cache.buckets,
+                          struct pvr_bo_cache_bucket *,
+                          bucket) {
+      free(*bucket);
+   }
+   util_dynarray_fini(&device->bo_cache.buckets);
+   util_dynarray_init(&device->bo_cache.buckets, NULL);
+   simple_mtx_unlock(&device->bo_cache.mtx);
+
+   list_for_each_entry_safe (struct pvr_bo, pvr_bo, &evicted, cache_lru) {
+      list_del(&pvr_bo->cache_lru);
+      pvr_bo_destroy(device, pvr_bo);
+   }
+}
+
+/* What a buffer object can be handed out again for; 0 if it is not kept. */
+static uint64_t pvr_bo_cache_key(const struct pvr_device *device,
+                                 const struct pvr_winsys_heap *heap,
+                                 uint64_t size,
+                                 uint64_t alignment,
+                                 uint64_t flags)
+{
+   const struct pvr_winsys_heap *const heaps[] = {
+      device->heaps.general_heap,      device->heaps.pds_heap,
+      device->heaps.rgn_hdr_heap,      device->heaps.transfer_frag_heap,
+      device->heaps.usc_heap,          device->heaps.vis_test_heap,
+   };
+   const uint64_t page_size = device->ws->page_size;
+   uint64_t heap_index = 0;
+
+   /* Kept mapped, so they can be cleared: CPU-mapped ones only. */
+   if (!(flags & PVR_BO_ALLOC_FLAG_CPU_MAPPED) ||
+       size > PVR_BO_CACHE_MAX_BO_BYTES || alignment == 0 ||
+       !util_is_power_of_two_nonzero64(alignment)) {
+      return 0;
+   }
+
+   for (uint32_t i = 0; i < ARRAY_SIZE(heaps); i++) {
+      if (heap == heaps[i])
+         heap_index = i + 1;
+   }
+   if (!heap_index)
+      return 0;
+
+   return (DIV_ROUND_UP(size, page_size) << 20) |
+          ((uint64_t)util_logbase2_64(alignment) << 12) | (heap_index << 4) |
+          (flags & (PVR_BO_ALLOC_FLAG_CPU_ACCESS | PVR_BO_ALLOC_FLAG_CPU_MAPPED |
+                    PVR_BO_ALLOC_FLAG_GPU_UNCACHED |
+                    PVR_BO_ALLOC_FLAG_PM_FW_PROTECT));
