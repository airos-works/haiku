diff -ruN a/include/vk_haiku_scanout.h b/include/vk_haiku_scanout.h
--- a/include/vk_haiku_scanout.h
+++ b/include/vk_haiku_scanout.h
@@ -0,0 +1,47 @@
+/*
+ * Drawing straight into the screen on Haiku.
+ *
+ * The frame buffer the display scans out is ordinary memory, and the display
+ * driver lets another program take hold of it. A renderer that copies its
+ * finished frame there never reads it back to the processor, which is what
+ * presenting through the window system costs otherwise.
+ *
+ * This is a private agreement between the Vulkan drivers on air/OS (NVK on
+ * the X399, PowerVR on the Cubie A7S) and the programs that present with
+ * them (zink's zink_haiku_present.c), not a registered Vulkan extension. It
+ * rides on the pNext chain of vkAllocateMemory, so it needs nothing of the
+ * loader: pass a VkImportScanoutMemoryHAIKU (allocationSize is ignored) and
+ * the memory that comes back is the screen, with its shape filled in.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef VK_HAIKU_SCANOUT_H
+#define VK_HAIKU_SCANOUT_H
+
+#include <vulkan/vulkan_core.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Private sType, from the range reserved for unregistered extensions. */
+#define VK_STRUCTURE_TYPE_IMPORT_SCANOUT_MEMORY_HAIKU \
+   ((VkStructureType)1000399000)
+
+typedef struct VkImportScanoutMemoryHAIKU {
+   VkStructureType sType;
+   void *pNext;
+   /* Filled in by the driver: the shape of the frame buffer that came back.
+    * The memory is a linear surface of `height` rows of `rowPitch` bytes.
+    */
+   uint32_t width;
+   uint32_t height;
+   uint32_t rowPitch;
+   VkDeviceSize size;
+} VkImportScanoutMemoryHAIKU;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* VK_HAIKU_SCANOUT_H */
diff -ruN a/include/xf86drm.h b/include/xf86drm.h
--- a/include/xf86drm.h
+++ b/include/xf86drm.h
@@ -0,0 +1,567 @@
+/*
+ * Copyright 2026, air/OS. All rights reserved.
+ * SPDX-License-Identifier: MIT
+ */
+
+/* air/OS (Haiku): the part of libdrm that Mesa's PowerVR Vulkan driver uses,
+ * on top of the native "powervr" kernel driver (/dev/graphics/powervr/0).
+ *
+ * The kernel takes Linux's drm.h and pvr_drm.h structures unchanged. Its
+ * contract is headers/private/graphics/powervr/pvr_haiku.h in the air/OS
+ * tree: a request goes out as op code PVR_HAIKU_OP(nr), nr being the Linux
+ * DRM ioctl number (the request's low 8 bits), with the length of the
+ * structure the request encodes (IOCPARM_LEN). So this needs no table.
+ *
+ * Semantics follow libdrm 2.4.123, with two deliberate differences:
+ *  - every function returns 0 on success and -1 with errno set on failure
+ *    (libdrm's waits return -errno, which is positive on Haiku);
+ *  - a syncobj wait that runs out of time fails with errno ETIME, whatever
+ *    timeout code the kernel used (B_TIMED_OUT, B_WOULD_BLOCK), and is not
+ *    retried on EAGAIN (which is B_WOULD_BLOCK on Haiku).
+ * Syncobj wait timeouts are absolute CLOCK_MONOTONIC nanoseconds, as on
+ * Linux (on Haiku that is system_time() * 1000); INT64_MAX waits for good.
+ *
+ * There is no device list (drmGetDevices2() finds nothing; pvr_instance.c
+ * opens the node itself), no display device, and no file descriptors for
+ * buffers or sync objects yet: the PRIME and syncobj fd functions fail with
+ * EOPNOTSUPP unless pvr_haiku.h names an op for them.
+ */
+#ifndef __HAIKU__
+/* everywhere else (the host tools' build, for one): the real libdrm */
+#include_next <xf86drm.h>
+#else
+
+#ifndef HAIKU_PVR_XF86DRM_H
+#define HAIKU_PVR_XF86DRM_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "drm-uapi/drm.h"
+#include "drm-uapi/pvr_drm.h"
+
+/* from the air/OS tree, by path (the build adds its directory) */
+#include <pvr_haiku.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The kernel's op numbers are Linux's; the length is the request's size. */
+#ifndef __cplusplus
+#define HAIKU_PVR_CHECK_REQUEST(request, nr, type)                            \
+   _Static_assert(((request) & 0xff) == (nr), #request " number");            \
+   _Static_assert(IOCPARM_LEN(request) == sizeof(type), #request " size")
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_VERSION, PVR_HAIKU_NR_VERSION,
+                        struct drm_version);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_GEM_CLOSE, PVR_HAIKU_NR_GEM_CLOSE,
+                        struct drm_gem_close);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_GET_CAP, PVR_HAIKU_NR_GET_CAP,
+                        struct drm_get_cap);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_SYNCOBJ_CREATE, PVR_HAIKU_NR_SYNCOBJ_CREATE,
+                        struct drm_syncobj_create);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_SYNCOBJ_DESTROY,
+                        PVR_HAIKU_NR_SYNCOBJ_DESTROY,
+                        struct drm_syncobj_destroy);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_SYNCOBJ_WAIT, PVR_HAIKU_NR_SYNCOBJ_WAIT,
+                        struct drm_syncobj_wait);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_SYNCOBJ_RESET, PVR_HAIKU_NR_SYNCOBJ_RESET,
+                        struct drm_syncobj_array);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_SYNCOBJ_SIGNAL, PVR_HAIKU_NR_SYNCOBJ_SIGNAL,
+                        struct drm_syncobj_array);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_SYNCOBJ_TIMELINE_WAIT,
+                        PVR_HAIKU_NR_SYNCOBJ_TIMELINE_WAIT,
+                        struct drm_syncobj_timeline_wait);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_SYNCOBJ_QUERY, PVR_HAIKU_NR_SYNCOBJ_QUERY,
+                        struct drm_syncobj_timeline_array);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_SYNCOBJ_TRANSFER,
+                        PVR_HAIKU_NR_SYNCOBJ_TRANSFER,
+                        struct drm_syncobj_transfer);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_SYNCOBJ_TIMELINE_SIGNAL,
+                        PVR_HAIKU_NR_SYNCOBJ_TIMELINE_SIGNAL,
+                        struct drm_syncobj_timeline_array);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_PVR_DEV_QUERY, PVR_HAIKU_NR_PVR_FIRST,
+                        struct drm_pvr_ioctl_dev_query_args);
+HAIKU_PVR_CHECK_REQUEST(DRM_IOCTL_PVR_SUBMIT_JOBS, PVR_HAIKU_NR_PVR_LAST,
+                        struct drm_pvr_ioctl_submit_jobs_args);
+#undef HAIKU_PVR_CHECK_REQUEST
+#endif
+
+static inline int
+drmIoctl(int fd, unsigned long request, void *arg)
+{
+   int ret;
+
+   do {
+      ret = ioctl(fd, PVR_HAIKU_OP(request & 0xff), arg,
+                  (size_t)IOCPARM_LEN(request));
+   } while (ret == -1 && (errno == EINTR || errno == EAGAIN));
+
+   return ret;
+}
+
+/* A syncobj wait: restarted after a signal (the timeout is absolute), never
+ * spun on EAGAIN, and any way of running out of time reads ETIME. */
+static inline int
+haiku_pvr_wait_ioctl(int fd, unsigned long request, void *arg)
+{
+   int ret;
+
+   do {
+      ret = ioctl(fd, PVR_HAIKU_OP(request & 0xff), arg,
+                  (size_t)IOCPARM_LEN(request));
+   } while (ret == -1 && errno == EINTR);
+
+   if (ret == -1 && (errno == ETIMEDOUT || errno == EWOULDBLOCK))
+      errno = ETIME;
+
+   return ret == 0 ? 0 : -1;
+}
+
+static inline int
+haiku_pvr_unsupported(void)
+{
+   errno = EOPNOTSUPP;
+   return -1;
+}
+
+static inline void
+drmFree(void *pt)
+{
+   free(pt);
+}
+
+/* -- version, capabilities, master ------------------------------------- */
+
+typedef struct _drmVersion {
+   int version_major;
+   int version_minor;
+   int version_patchlevel;
+   int name_len;
+   char *name;
+   int date_len;
+   char *date;
+   int desc_len;
+   char *desc;
+} drmVersion, *drmVersionPtr;
+
+static inline void
+drmFreeVersion(drmVersionPtr version)
+{
+   if (version == NULL)
+      return;
+
+   free(version->name);
+   free(version->date);
+   free(version->desc);
+   free(version);
+}
+
+/* Two calls, as libdrm: the lengths, then the strings. */
+static inline drmVersionPtr
+drmGetVersion(int fd)
+{
+   struct drm_version request;
+   drmVersionPtr version;
+
+   memset(&request, 0, sizeof(request));
+   if (drmIoctl(fd, DRM_IOCTL_VERSION, &request) != 0)
+      return NULL;
+
+   version = (drmVersionPtr)calloc(1, sizeof(*version));
+   if (version == NULL)
+      return NULL;
+
+   version->name = (char *)calloc(1, request.name_len + 1);
+   version->date = (char *)calloc(1, request.date_len + 1);
+   version->desc = (char *)calloc(1, request.desc_len + 1);
+   if (version->name == NULL || version->date == NULL ||
+       version->desc == NULL) {
+      drmFreeVersion(version);
+      return NULL;
+   }
+
+   request.name = version->name;
+   request.date = version->date;
+   request.desc = version->desc;
+   if (drmIoctl(fd, DRM_IOCTL_VERSION, &request) != 0) {
+      drmFreeVersion(version);
+      return NULL;
+   }
+
+   version->version_major = request.version_major;
+   version->version_minor = request.version_minor;
+   version->version_patchlevel = request.version_patchlevel;
+   version->name_len = (int)request.name_len;
+   version->date_len = (int)request.date_len;
+   version->desc_len = (int)request.desc_len;
+   return version;
+}
+
+static inline int
+drmGetCap(int fd, uint64_t capability, uint64_t *value)
+{
+   struct drm_get_cap request;
+
+   memset(&request, 0, sizeof(request));
+   request.capability = capability;
