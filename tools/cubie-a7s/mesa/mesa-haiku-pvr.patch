+/* (air/OS) The kernel ended this queue's context (a GPU reset, a context
+ * marked faulty) or lost the device: a winsys request failed with
+ * VK_ERROR_DEVICE_LOST. The runtime does not mark a queue lost when an
+ * immediate-mode submission fails, so do it here: every later submit and
+ * wait then returns VK_ERROR_DEVICE_LOST at once instead of blocking. Then
+ * signal what this submission would have signalled. A thread already
+ * waiting for one of those points would otherwise wait forever for a point
+ * no job will reach: zink waits for its batch timeline on the GL thread
+ * while its flush thread submits. That wait then ends, and the runtime's
+ * device check after a wait reports the loss.
+ */
+static void pvr_queue_lost(struct pvr_queue *queue,
+                           struct vk_queue_submit *submit)
+{
+   vk_queue_set_lost(&queue->vk,
+                     "the kernel ended the queue's context (GPU reset)");
+
+   /* Nothing will ever signal the submission's semaphores and fence now, and
+    * a thread may already be blocked in the kernel waiting for them (zink
+    * waits for its batch timeline point with no timeout).  Signal them so it
+    * wakes up; the runtime's post-wait vk_device_check_status() then returns
+    * VK_ERROR_DEVICE_LOST to it, as it does to every later wait.
+    */
+   for (uint32_t i = 0; i < submit->signal_count; i++) {
+      const struct vk_sync_signal *signal = &submit->signals[i];
+      VkResult result = vk_sync_signal(&queue->device->vk,
+                                       signal->sync,
+                                       signal->signal_value);
+      if (result != VK_SUCCESS)
+         mesa_logw("could not signal a lost submission's sync (%d)", result);
+   }
+}
+
+static VkResult pvr_driver_queue_submit(struct vk_queue *queue,
+                                        struct vk_queue_submit *submit)
+{
+   VkResult result = pvr_driver_queue_submit_jobs(queue, submit);
+
+   if (result == VK_ERROR_DEVICE_LOST)
+      pvr_queue_lost(container_of(queue, struct pvr_queue, vk), submit);
+
+   return result;
+}
