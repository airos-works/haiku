+/* How many whole primitives of verts_per_prim vertices still fit into buffer
+ * b, given the bytes written so far.
+ */
+static inline uint
+xfb_buffer_capacity(uint p_lo, uint p_hi, uint state_lo, uint state_hi,
+                    uint b, uint verts_per_prim)
+{
+   uint base = PVR_XFB_PARAMS_XFB0 + b * PVR_XFB_PARAMS_XFB_DWORDS;
+   uint size = xfb_ld_dw(p_lo, p_hi, base + PVR_XFB_PARAMS_XFB_SIZE);
+   uint stride = xfb_ld_dw(p_lo, p_hi, base + PVR_XFB_PARAMS_XFB_STRIDE);
+   uint offset = xfb_ld_dw(state_lo, state_hi, PVR_XFB_STATE_OFFSET0 + b);
+   uint avail = offset <= size ? size - offset : 0;
+   uint bytes_per_prim = stride * verts_per_prim;
+   return bytes_per_prim ? avail / bytes_per_prim : 0xffffffffu;
+}
+
+static inline void
+xfb_advance(uint p_lo, uint p_hi, uint state_lo, uint state_hi, uint b,
+            uint bytes)
+{
+   uint base = PVR_XFB_PARAMS_XFB0 + b * PVR_XFB_PARAMS_XFB_DWORDS;
+   uint stride = xfb_ld_dw(p_lo, p_hi, base + PVR_XFB_PARAMS_XFB_STRIDE);
+   uint offset = xfb_ld_dw(state_lo, state_hi, PVR_XFB_STATE_OFFSET0 + b);
+   xfb_st_dw(state_lo, state_hi, PVR_XFB_STATE_OFFSET0 + b,
+             offset + bytes * stride);
+}
+
+/* After a draw's kernel: the primitives that fit went into the buffers, so
+ * the offsets move on by them, and the active query (if any) counts them and
+ * the primitives the draw generated.
+ */
+KERNEL(1)
+cs_xfb_post_common(void)
+{
+   uint p_lo = nir_load_preamble(1, PVR_XFB_POST_DATA_PARAMS_LO, 0);
+   uint p_hi = nir_load_preamble(1, PVR_XFB_POST_DATA_PARAMS_HI, 0);
+   uint state_lo = xfb_ld_dw(p_lo, p_hi, PVR_XFB_PARAMS_STATE_LO);
+   uint state_hi = xfb_ld_dw(p_lo, p_hi, PVR_XFB_PARAMS_STATE_HI);
+   uint query_lo = xfb_ld_dw(p_lo, p_hi, PVR_XFB_PARAMS_QUERY_LO);
+   uint query_hi = xfb_ld_dw(p_lo, p_hi, PVR_XFB_PARAMS_QUERY_HI);
+   uint mask = xfb_ld_dw(p_lo, p_hi, PVR_XFB_PARAMS_BUFFERS_WRITTEN);
+   uint verts_per_prim = xfb_ld_dw(p_lo, p_hi, PVR_XFB_PARAMS_VERTS_PER_PRIM);
+   uint prim_count = xfb_ld_dw(p_lo, p_hi, PVR_XFB_PARAMS_PRIM_COUNT);
+   uint instance_count = xfb_ld_dw(p_lo, p_hi, PVR_XFB_PARAMS_INSTANCE_COUNT);
+   uint generated = prim_count * instance_count;
+   uint capacity = 0xffffffffu;
+
+   if (mask & 1u)
+      capacity = min(capacity, xfb_buffer_capacity(p_lo, p_hi, state_lo, state_hi, 0, verts_per_prim));
+   if (mask & 2u)
+      capacity = min(capacity, xfb_buffer_capacity(p_lo, p_hi, state_lo, state_hi, 1, verts_per_prim));
+   if (mask & 4u)
+      capacity = min(capacity, xfb_buffer_capacity(p_lo, p_hi, state_lo, state_hi, 2, verts_per_prim));
+   if (mask & 8u)
+      capacity = min(capacity, xfb_buffer_capacity(p_lo, p_hi, state_lo, state_hi, 3, verts_per_prim));
+
+   uint written = min(generated, capacity);
+   uint vertices = written * verts_per_prim;
+
+   if (mask & 1u)
+      xfb_advance(p_lo, p_hi, state_lo, state_hi, 0, vertices);
+   if (mask & 2u)
+      xfb_advance(p_lo, p_hi, state_lo, state_hi, 1, vertices);
+   if (mask & 4u)
+      xfb_advance(p_lo, p_hi, state_lo, state_hi, 2, vertices);
+   if (mask & 8u)
+      xfb_advance(p_lo, p_hi, state_lo, state_hi, 3, vertices);
+
+   if (query_lo | query_hi) {
+      xfb_st_dw(query_lo, query_hi, PVR_XFB_QUERY_WRITTEN_LO,
+                xfb_ld_dw(query_lo, query_hi, PVR_XFB_QUERY_WRITTEN_LO) + written);
+      xfb_st_dw(query_lo, query_hi, PVR_XFB_QUERY_GENERATED_LO,
+                xfb_ld_dw(query_lo, query_hi, PVR_XFB_QUERY_GENERATED_LO) + generated);
+   }
+}
+
+/* Transform feedback query pools: reset, mark available, copy results. One
+ * invocation per query.
+ */
+KERNEL(32)
+cs_xfb_query_common(void)
+{
+   uint mode = nir_load_preamble(1, PVR_XFB_QUERY_DATA_MODE, 0);
+   uint count = nir_load_preamble(1, PVR_XFB_QUERY_DATA_COUNT, 0);
+   uint result_lo = nir_load_preamble(1, PVR_XFB_QUERY_DATA_RESULT_LO, 0);
+   uint result_hi = nir_load_preamble(1, PVR_XFB_QUERY_DATA_RESULT_HI, 0);
+   uint avail_lo = nir_load_preamble(1, PVR_XFB_QUERY_DATA_AVAIL_LO, 0);
+   uint avail_hi = nir_load_preamble(1, PVR_XFB_QUERY_DATA_AVAIL_HI, 0);
+   uint dest_lo = nir_load_preamble(1, PVR_XFB_QUERY_DATA_DEST_LO, 0);
+   uint dest_hi = nir_load_preamble(1, PVR_XFB_QUERY_DATA_DEST_HI, 0);
+   uint dest_stride = nir_load_preamble(1, PVR_XFB_QUERY_DATA_DEST_STRIDE, 0);
+   uint flags = nir_load_preamble(1, PVR_XFB_QUERY_DATA_FLAGS, 0);
+   uint index = query_calc_global_id();
+
+   if (index < count) {
+      uint result_dw = index * _PVR_XFB_QUERY_COUNT;
+
+      if (mode == PVR_XFB_QUERY_MODE_RESET) {
+         xfb_st_dw(result_lo, result_hi, result_dw + PVR_XFB_QUERY_WRITTEN_LO, 0);
+         xfb_st_dw(result_lo, result_hi, result_dw + PVR_XFB_QUERY_WRITTEN_HI, 0);
+         xfb_st_dw(result_lo, result_hi, result_dw + PVR_XFB_QUERY_GENERATED_LO, 0);
+         xfb_st_dw(result_lo, result_hi, result_dw + PVR_XFB_QUERY_GENERATED_HI, 0);
+         xfb_st_dw(avail_lo, avail_hi, index, 0);
+      } else if (mode == PVR_XFB_QUERY_MODE_AVAIL) {
+         xfb_st_dw(avail_lo, avail_hi, index, 1);
+      } else {
+         uint available = xfb_ld_dw(avail_lo, avail_hi, index);
+         uint2 dest = nir_umad64_32(dest_stride, index, dest_lo, dest_hi);
+         bool wide = (flags & VK_QUERY_RESULT_64_BIT) != 0;
+
+         if (available || (flags & VK_QUERY_RESULT_PARTIAL_BIT)) {
+            uint written = xfb_ld_dw(result_lo, result_hi, result_dw + PVR_XFB_QUERY_WRITTEN_LO);
+            uint generated = xfb_ld_dw(result_lo, result_hi, result_dw + PVR_XFB_QUERY_GENERATED_LO);
+            if (wide) {
+               nir_dma_st_pco(false, dest, written, 0);
+               nir_dma_st_pco(false, nir_uadd64_32(dest.x, dest.y, 8), generated, 0);
+            } else {
+               nir_dma_st_pco(false, dest, written);
+               nir_dma_st_pco(false, nir_uadd64_32(dest.x, dest.y, 4), generated);
+            }
+         }
+         if (flags & VK_QUERY_RESULT_WITH_AVAILABILITY_BIT) {
+            if (wide)
+               nir_dma_st_pco(false, nir_uadd64_32(dest.x, dest.y, 16), available, 0);
+            else
+               nir_dma_st_pco(false, nir_uadd64_32(dest.x, dest.y, 8), available);
+         }
+      }
+   }
+}
