+/* A kept buffer object of that type and size, with its GPU mapping. */
+static struct pvr_winsys_bo *
+pvr_memory_cache_take(struct pvr_device *device,
+                      uint32_t memory_type,
+                      uint64_t size,
+                      struct pvr_winsys_vma **const vma_out)
+{
+   struct pvr_memory_cache_entry *found = NULL;
+
+   simple_mtx_lock(&device->memory_cache.mtx);
+   list_for_each_entry (struct pvr_memory_cache_entry,
+                        entry,
+                        &device->memory_cache.lru,
+                        link) {
+      if (entry->memory_type == memory_type && entry->bo->size == size) {
+         list_del(&entry->link);
+         device->memory_cache.bytes -= size;
+         found = entry;
+         break;
+      }
+   }
+   simple_mtx_unlock(&device->memory_cache.mtx);
+
+   if (!found)
+      return NULL;
+
+   struct pvr_winsys_bo *bo = found->bo;
+   *vma_out = found->vma;
+   vk_free(&device->vk.alloc, found);
+   return bo;
+}
+
+/* Keeps a freed memory object's buffer object; false if it is not kept. */
+static bool pvr_memory_cache_put(struct pvr_device *device,
+                                 struct pvr_device_memory *mem)
+{
+   struct pvr_memory_cache_entry *entry;
+   struct list_head evicted;
+
+   if (!mem->cacheable || !device->memory_cache.enabled ||
+       mem->bo->size > device->memory_cache.max_bytes / 4) {
+      return false;
+   }
+
+   entry = vk_alloc(&device->vk.alloc,
+                    sizeof(*entry),
+                    8,
+                    VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!entry)
+      return false;
+   entry->memory_type = mem->vk.memory_type_index;
+   entry->bo = mem->bo;
+   entry->vma = mem->buffer_vma;
+
+   list_inithead(&evicted);
+   simple_mtx_lock(&device->memory_cache.mtx);
+   if (!device->memory_cache.enabled) {
+      simple_mtx_unlock(&device->memory_cache.mtx);
+      vk_free(&device->vk.alloc, entry);
+      return false;
+   }
+   list_add(&entry->link, &device->memory_cache.lru);
+   device->memory_cache.bytes += entry->bo->size;
+   while (device->memory_cache.bytes > device->memory_cache.max_bytes) {
+      struct pvr_memory_cache_entry *oldest =
+         list_last_entry(&device->memory_cache.lru,
+                         struct pvr_memory_cache_entry,
+                         link);
+      list_del(&oldest->link);
+      device->memory_cache.bytes -= oldest->bo->size;
+      list_addtail(&oldest->link, &evicted);
+   }
+   simple_mtx_unlock(&device->memory_cache.mtx);
+
+   /* outside the lock: these make requests to the kernel */
+   list_for_each_entry_safe (struct pvr_memory_cache_entry,
+                             oldest,
+                             &evicted,
+                             link) {
+      list_del(&oldest->link);
+      pvr_memory_cache_destroy_entry(device, oldest);
+   }
+
+   return true;
+}
