+#ifdef __HAIKU__
+/* VkImportScanoutMemoryHAIKU on the Cubie A7S: the frame buffer of the
+ * sunxi_display driver, cloned into this team (SUNXI_DISPLAY_CLONE_FRAME_BUFFER)
+ * and imported as host memory (PVR_HAIKU_NR_IMPORT_HOST). The GPU writes it
+ * past its own cache (DRM_PVR_BO_BYPASS_DEVICE_CACHE): a cache line that
+ * covered a rectangle's edge would otherwise write back over pixels
+ * app_server drew around it. The frame buffer is write-combined, so the CPU
+ * side needs no cache maintenance. Without the display driver, or with a
+ * kernel driver that lacks the import (B_DEV_INVALID_IOCTL), this fails and
+ * the caller presents some other way.
+ */
+VkResult pvr_drm_winsys_buffer_import_scanout(struct pvr_winsys *ws,
+                                              uint32_t *const width_out,
+                                              uint32_t *const height_out,
+                                              uint32_t *const row_pitch_out,
+                                              struct pvr_winsys_bo **const bo_out)
+{
+   struct pvr_drm_winsys *drm_ws = to_pvr_drm_winsys(ws);
+   struct sunxi_display_shared_info info;
+   struct pvr_drm_winsys_bo *drm_bo;
+   area_info clone = { .area = -1 };
+   int fd;
+   int ret;
+
+   fd = open("/dev/" SUNXI_DISPLAY_DEVICE, O_RDWR | O_CLOEXEC);
+   if (fd < 0) {
+      return vk_errorf(NULL,
+                       VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "no frame buffer: /dev/%s (%s)",
+                       SUNXI_DISPLAY_DEVICE,
+                       strerror(errno));
+   }
+
+   memset(&info, 0, sizeof(info));
+   ret = ioctl(fd, SUNXI_DISPLAY_GET_STATE, &info, sizeof(info));
+   if (ret == 0 && (info.width == 0 || info.height == 0 ||
+                    info.bytes_per_row < info.width * 4)) {
+      ret = -1;
+      errno = B_NO_INIT;
+   }
+   if (ret == 0)
+      ret = ioctl(fd, SUNXI_DISPLAY_CLONE_FRAME_BUFFER, &clone, sizeof(clone));
+   const int err = ret != 0 ? errno : 0;
+   close(fd);
+   if (ret != 0 || clone.area < 0) {
+      return vk_errorf(NULL,
+                       VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "no frame buffer from %s (%s)",
+                       SUNXI_DISPLAY_DEVICE,
+                       strerror(err));
+   }
+
+   const uint64_t size =
+      ALIGN_POT((uint64_t)info.bytes_per_row * info.height, B_PAGE_SIZE);
+   if (size > clone.size) {
+      delete_area(clone.area);
+      return vk_errorf(NULL,
+                       VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "frame buffer area (%zu bytes) smaller than "
+                       "%u rows of %u bytes",
+                       clone.size,
+                       info.height,
+                       info.bytes_per_row);
+   }
+
+   struct pvr_haiku_import_host args = {
+      .address = (uint64_t)(uintptr_t)clone.address,
+      .size = size,
+      .flags = DRM_PVR_BO_BYPASS_DEVICE_CACHE,
+   };
+   do {
+      ret = ioctl(drm_ws->base.render_fd,
+                  PVR_HAIKU_OP(PVR_HAIKU_NR_IMPORT_HOST),
+                  &args,
+                  sizeof(args));
+   } while (ret == -1 && errno == EINTR);
+   if (ret != 0) {
+      const int import_err = errno;
+      delete_area(clone.area);
+      return vk_errorf(NULL,
+                       VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "PVR_HAIKU_NR_IMPORT_HOST of the frame buffer failed "
+                       "(%s)",
+                       strerror(import_err));
