+/* (air/OS) The robustness lowering of buffer loads, for loads that may have
+ * been vectorized first (see pco_lower_nir()). nir_lower_robust_access()
+ * reads a whole load from offset 0 when any of it is out of bounds, which
+ * for a merged load would also change the components that were in bounds.
+ * Here a load that fits, the usual case (a uniform branch), stays one load;
+ * one that does not is read a component at a time, each in-bounds
+ * component from its own offset and each out-of-bounds one from offset 0.
+ */
+static bool lower_robust_buffer_load(nir_builder *b,
+                                     nir_intrinsic_instr *intr,
+                                     UNUSED void *data)
+{
+   const bool ubo = intr->intrinsic == nir_intrinsic_load_ubo;
+
+   if (!ubo && intr->intrinsic != nir_intrinsic_load_ssbo)
+      return false;
+
+   const unsigned comps = intr->def.num_components;
+   const unsigned bit_size = intr->def.bit_size;
+   const unsigned comp_size = bit_size / 8;
+   nir_def *index = intr->src[0].ssa;
+   nir_def *offset = intr->src[1].ssa;
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   nir_def *size = ubo ? nir_get_ubo_size(b, 32, index)
+                       : nir_get_ssbo_size(b, 32, index);
+   nir_def *last = nir_iadd_imm(b, offset, comps * comp_size - 1);
+   nir_def *fits = nir_ult(b, last, size);
+
+   if (comps == 1) {
+      nir_src_rewrite(&intr->src[1],
+                      nir_bcsel(b, fits, offset, nir_imm_int(b, 0)));
+      return true;
+   }
+
+   nir_push_if(b, fits);
+   nir_instr *whole = nir_instr_clone(b->shader, &intr->instr);
+   nir_builder_instr_insert(b, whole);
+   nir_push_else(b, NULL);
+   nir_def *parts[NIR_MAX_VEC_COMPONENTS];
+   for (unsigned i = 0; i < comps; i++) {
+      nir_def *part_offset = nir_iadd_imm(b, offset, i * comp_size);
+      nir_def *valid =
+         nir_ult(b, nir_iadd_imm(b, part_offset, comp_size - 1), size);
+      part_offset = nir_bcsel(b, valid, part_offset, nir_imm_int(b, 0));
+
+      if (ubo) {
+         parts[i] = nir_load_ubo(b,
+                                 1,
+                                 bit_size,
+                                 index,
+                                 part_offset,
+                                 .access = nir_intrinsic_access(intr),
+                                 .align_mul = comp_size,
+                                 .align_offset = 0,
+                                 .range_base = 0,
+                                 .range = ~0);
+      } else {
+         parts[i] = nir_load_ssbo(b,
+                                  1,
+                                  bit_size,
+                                  index,
+                                  part_offset,
+                                  .access = nir_intrinsic_access(intr),
+                                  .align_mul = comp_size,
+                                  .align_offset = 0);
+      }
+   }
+   nir_def *split = nir_vec(b, parts, comps);
+   nir_pop_if(b, NULL);
+
+   nir_def_replace(&intr->def,
+                   nir_if_phi(b, &nir_instr_as_intrinsic(whole)->def, split));
+   return true;
+}
+
+/* (air/OS) robustness_filter() without the buffer loads, which
+ * lower_robust_buffer_load() takes.
+ */
+static bool robustness_filter_no_loads(const nir_intrinsic_instr *intr,
+                                       const void *data)
+{
+   if (intr->intrinsic == nir_intrinsic_load_ubo ||
+       intr->intrinsic == nir_intrinsic_load_ssbo) {
+      return false;
+   }
+
+   return robustness_filter(intr, data);
+}
+
+/* (air/OS) Uniform buffer promotion. Loads of a uniform buffer at constant
+ * offsets read shared registers instead, which the PDS fills once per draw
+ * from the buffer (PVR_BUFFER_TYPE_UBO_PROMOTED), as it does push constants.
+ * An ld costs a memory round trip per invocation; WebKit's TextureMapper
+ * fragment shader, through zink, made 17 per pixel. Each buffer's range runs
+ * from its first to its last constant load; ranges are taken in order while
+ * they fit PCO_UBO_PROMOTE_MAX_DW dwords in all (default 128, 0 = off), at
+ * most PCO_MAX_UBO_PROMOTIONS of them. Loads at dynamic offsets stay lds.
+ * Robustness is the driver's at draw time: a range the bound buffer does not
+ * hold, or a null descriptor, is loaded from zeros.
+ */
+#define PCO_UBO_PROMOTE_MAX_DW_DEFAULT 128U
+#define PCO_UBO_PROMOTE_MAX_DW_LIMIT 1024U
+#define PCO_UBO_PROMOTE_MAX_KEYS 8U
+
+struct pco_ubo_promote_key {
+   uint32_t packed_desc;
+   unsigned elem;
+   unsigned start_dw;
+   unsigned end_dw;
+   int promotion;
+};
+
+struct pco_ubo_promote_state {
+   pco_common_data *common;
+   struct pco_ubo_promote_key keys[PCO_UBO_PROMOTE_MAX_KEYS];
+   unsigned key_count;
+};
+
+/* The buffer a load_ubo reads, as pco packs it: before pco_nir_lower_vk() a
+ * load_vulkan_descriptor of a vulkan_resource_index, after it a constant.
+ * *desc_def is the load_vulkan_descriptor, if any.
+ */
+static bool pco_ubo_index(nir_def *index,
+                          uint32_t *packed_desc,
+                          unsigned *elem,
+                          nir_def **desc_def)
+{
+   nir_scalar desc = nir_scalar_resolved(index, 0);
+   nir_scalar array_elem = nir_scalar_resolved(index, 1);
+
+   *desc_def = NULL;
+
+   if (nir_scalar_is_const(desc) && nir_scalar_is_const(array_elem)) {
+      *packed_desc = nir_scalar_as_uint(desc);
+      *elem = nir_scalar_as_uint(array_elem);
+      return true;
+   }
+
+   if (!nir_scalar_is_intrinsic(desc) ||
+       nir_scalar_intrinsic_op(desc) != nir_intrinsic_load_vulkan_descriptor ||
+       desc.def != array_elem.def || desc.comp != 0 || array_elem.comp != 1) {
+      return false;
+   }
+
+   nir_intrinsic_instr *load_desc = nir_def_as_intrinsic(desc.def);
+   nir_intrinsic_instr *res_index = nir_src_as_intrinsic(load_desc->src[0]);
+   if (!res_index ||
+       res_index->intrinsic != nir_intrinsic_vulkan_resource_index ||
+       !nir_src_is_const(res_index->src[0])) {
+      return false;
+   }
+
+   *packed_desc = pco_pack_desc(nir_intrinsic_desc_set(res_index),
+                                nir_intrinsic_binding(res_index));
+   *elem = nir_src_as_uint(res_index->src[0]);
+   *desc_def = desc.def;
+   return true;
+}
+
+/* A load_ubo offset that is a sum of constants. Before pco_nir_lower_vk() it
+ * adds the descriptor's third component, which that pass makes 0.
+ */
+static bool pco_ubo_const_offset(nir_scalar offset,
+                                 const nir_def *desc_def,
+                                 uint32_t *value)
+{
+   if (nir_scalar_is_const(offset)) {
+      *value = nir_scalar_as_uint(offset);
+      return true;
+   }
+
+   if (desc_def && offset.def == desc_def && offset.comp == 2) {
+      *value = 0;
+      return true;
+   }
+
+   if (nir_scalar_is_alu(offset) && nir_scalar_alu_op(offset) == nir_op_iadd) {
+      uint32_t a, b;
+
+      if (pco_ubo_const_offset(nir_scalar_chase_alu_src(offset, 0),
+                               desc_def,
+                               &a) &&
+          pco_ubo_const_offset(nir_scalar_chase_alu_src(offset, 1),
+                               desc_def,
+                               &b)) {
+         *value = a + b;
+         return true;
+      }
+   }
+
+   return false;
+}
+
+static bool pco_ubo_load_key(const nir_intrinsic_instr *intr,
+                             uint32_t *packed_desc,
+                             unsigned *elem,
+                             unsigned *offset_dw)
+{
+   nir_def *desc_def;
+   uint32_t offset;
+
+   if (intr->intrinsic != nir_intrinsic_load_ubo || intr->def.bit_size != 32)
+      return false;
+
+   if (!pco_ubo_index(intr->src[0].ssa, packed_desc, elem, &desc_def))
+      return false;
+
+   if (!pco_ubo_const_offset(nir_scalar_resolved(intr->src[1].ssa, 0),
+                             desc_def,
+                             &offset) ||
+       offset % sizeof(uint32_t)) {
+      return false;
+   }
+
+   *offset_dw = offset / sizeof(uint32_t);
+   return true;
+}
+
+static struct pco_ubo_promote_key *
+pco_ubo_promote_find_key(struct pco_ubo_promote_state *state,
+                         uint32_t packed_desc,
+                         unsigned elem)
+{
+   for (unsigned u = 0; u < state->key_count; ++u) {
+      if (state->keys[u].packed_desc == packed_desc &&
+          state->keys[u].elem == elem) {
+         return &state->keys[u];
+      }
+   }
+
+   return NULL;
+}
+
+static bool pco_ubo_promote_gather(nir_builder *b,
+                                   nir_intrinsic_instr *intr,
+                                   void *data)
+{
+   struct pco_ubo_promote_state *state = data;
+   uint32_t packed_desc;
+   unsigned elem, offset_dw;
+
+   if (!pco_ubo_load_key(intr, &packed_desc, &elem, &offset_dw))
+      return false;
+
+   const unsigned end_dw = offset_dw + intr->def.num_components;
+   struct pco_ubo_promote_key *key =
+      pco_ubo_promote_find_key(state, packed_desc, elem);
+
+   if (key) {
+      key->start_dw = MIN2(key->start_dw, offset_dw);
+      key->end_dw = MAX2(key->end_dw, end_dw);
+   } else if (state->key_count < ARRAY_SIZE(state->keys)) {
+      state->keys[state->key_count++] = (struct pco_ubo_promote_key){
+         .packed_desc = packed_desc,
+         .elem = elem,
+         .start_dw = offset_dw,
+         .end_dw = end_dw,
+         .promotion = -1,
+      };
+   }
+
+   return false;
+}
+
+static bool pco_ubo_promote_rewrite(nir_builder *b,
+                                    nir_intrinsic_instr *intr,
+                                    void *data)
+{
+   struct pco_ubo_promote_state *state = data;
+   uint32_t packed_desc;
+   unsigned elem, offset_dw;
+
+   if (!pco_ubo_load_key(intr, &packed_desc, &elem, &offset_dw))
+      return false;
+
+   const struct pco_ubo_promote_key *key =
+      pco_ubo_promote_find_key(state, packed_desc, elem);
+   if (!key || key->promotion < 0)
+      return false;
+
+   const pco_ubo_promotion *promotion =
+      &state->common->ubo_promotions[key->promotion];
+   assert(offset_dw >= promotion->offset_dw);
+   assert(offset_dw + intr->def.num_components <=
+          promotion->offset_dw + promotion->count_dw);
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *value = nir_load_preamble(b,
+                                      intr->def.num_components,
+                                      32,
+                                      .base = PCO_UBO_PROMOTED_BASE +
+                                              promotion->base + offset_dw -
+                                              promotion->offset_dw);
+   nir_def_replace(&intr->def, value);
+   return true;
+}
+
+static bool pco_nir_promote_ubo_loads(nir_shader *nir, pco_common_data *common)
+{
+   const unsigned max_dw = MIN2(debug_get_num_option("PCO_UBO_PROMOTE_MAX_DW",
+                                                     PCO_UBO_PROMOTE_MAX_DW_DEFAULT),
+                                PCO_UBO_PROMOTE_MAX_DW_LIMIT);
+   struct pco_ubo_promote_state state = { .common = common };
+   unsigned total_dw = 0;
+
+   common->ubo_promotion_count = 0;
+   common->ubo_promoted = (pco_range){ 0 };
+
+   /* Internal shaders set up their shared registers themselves. */
+   if (!max_dw || nir->info.internal)
+      return false;
+
+   nir_shader_intrinsics_pass(nir,
+                              pco_ubo_promote_gather,
+                              nir_metadata_all,
+                              &state);
+
+   for (unsigned u = 0; u < state.key_count; ++u) {
+      struct pco_ubo_promote_key *key = &state.keys[u];
+      const unsigned count_dw = key->end_dw - key->start_dw;
+
+      if (common->ubo_promotion_count == PCO_MAX_UBO_PROMOTIONS)
+         break;
+
+      if (total_dw + count_dw > max_dw)
+         continue;
+
+      pco_ubo_promotion *promotion =
+         &common->ubo_promotions[common->ubo_promotion_count];
+      pco_unpack_desc(key->packed_desc,
+                      &promotion->desc_set,
+                      &promotion->binding);
+      promotion->elem = key->elem;
+      promotion->offset_dw = key->start_dw;
+      promotion->count_dw = count_dw;
+      promotion->base = total_dw;
+
+      key->promotion = common->ubo_promotion_count++;
+      total_dw += count_dw;
+   }
+
+   if (!total_dw)
+      return false;
+
+   common->ubo_promoted.count = total_dw;
+
+   return nir_shader_intrinsics_pass(nir,
+                                     pco_ubo_promote_rewrite,
+                                     nir_metadata_control_flow,
+                                     &state);
+}
