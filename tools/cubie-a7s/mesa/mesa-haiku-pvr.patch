+                                                 uint32_t samples,
+                                                 uint32_t layers)
+{
+   struct pvr_rt_dataset *found = NULL;
+
+   simple_mtx_lock(&device->rt_dataset_cache.mtx);
+
+   /* The most recently released first. */
+   list_for_each_entry (struct pvr_rt_dataset,
+                        rt_dataset,
+                        &device->rt_dataset_cache.idle,
+                        cache_link) {
+      if (rt_dataset->width == width && rt_dataset->height == height &&
+          rt_dataset->samples == samples && rt_dataset->layers == layers) {
+         list_del(&rt_dataset->cache_link);
+         device->rt_dataset_cache.count--;
+         found = rt_dataset;
+         break;
+      }
+   }
+
+   simple_mtx_unlock(&device->rt_dataset_cache.mtx);
+
+   return found;
+}
+
+void pvr_rt_dataset_cache_release(struct pvr_rt_dataset *rt_dataset)
+{
+   struct pvr_device *device = rt_dataset->device;
+   struct list_head evicted;
+
+   /* A geometry job without its fragment job left data in it for the next
+    * geometry job to add to; only a data set no render is in the middle of
+    * can start the next one.
+    */
+   if (rt_dataset->need_frag) {
+      pvr_render_target_dataset_destroy(rt_dataset);
+      return;
+   }
+
+   list_inithead(&evicted);
+
+   simple_mtx_lock(&device->rt_dataset_cache.mtx);
+
+   rt_dataset->cache_serial = ++device->rt_dataset_cache.serial;
+   list_add(&rt_dataset->cache_link, &device->rt_dataset_cache.idle);
+   device->rt_dataset_cache.count++;
+
+   while (!list_is_empty(&device->rt_dataset_cache.idle)) {
+      struct pvr_rt_dataset *oldest =
+         list_last_entry(&device->rt_dataset_cache.idle,
+                         struct pvr_rt_dataset,
+                         cache_link);
+
+      if (device->rt_dataset_cache.count <= PVR_RT_DATASET_CACHE_MAX_IDLE &&
+          device->rt_dataset_cache.serial - oldest->cache_serial <=
+             PVR_RT_DATASET_CACHE_MAX_AGE) {
+         break;
+      }
+
+      list_del(&oldest->cache_link);
+      device->rt_dataset_cache.count--;
+      list_addtail(&oldest->cache_link, &evicted);
+   }
+
+   simple_mtx_unlock(&device->rt_dataset_cache.mtx);
+
+   /* Outside the lock: destroying makes requests to the kernel. */
+   list_for_each_entry_safe (struct pvr_rt_dataset,
+                             entry,
+                             &evicted,
+                             cache_link) {
+      list_del(&entry->cache_link);
+      pvr_render_target_dataset_destroy(entry);
+   }
+}
+
 void pvr_render_target_dataset_destroy(struct pvr_rt_dataset *rt_dataset)
 {
    struct pvr_device *device = rt_dataset->device;
