+enum pvr_xfb_topology pvr_xfb_topology(VkPrimitiveTopology topology)
+{
+   switch (topology) {
+   case VK_PRIMITIVE_TOPOLOGY_POINT_LIST:
+      return PVR_XFB_TOPOLOGY_POINTS;
+   case VK_PRIMITIVE_TOPOLOGY_LINE_LIST:
+      return PVR_XFB_TOPOLOGY_LINES;
+   case VK_PRIMITIVE_TOPOLOGY_LINE_STRIP:
+      return PVR_XFB_TOPOLOGY_LINE_STRIP;
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST:
+      return PVR_XFB_TOPOLOGY_TRIANGLES;
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP:
+      return PVR_XFB_TOPOLOGY_TRIANGLE_STRIP;
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN:
+      return PVR_XFB_TOPOLOGY_TRIANGLE_FAN;
+   default:
+      return PVR_XFB_TOPOLOGY_UNSUPPORTED;
+   }
+}
+
+uint32_t pvr_xfb_verts_per_prim(enum pvr_xfb_topology topology)
+{
+   switch (topology) {
+   case PVR_XFB_TOPOLOGY_POINTS:
+      return 1;
+   case PVR_XFB_TOPOLOGY_LINES:
+   case PVR_XFB_TOPOLOGY_LINE_STRIP:
+      return 2;
+   default:
+      return 3;
+   }
+}
+
+uint32_t pvr_xfb_prim_count(enum pvr_xfb_topology topology,
+                            uint32_t vertex_count)
+{
+   switch (topology) {
+   case PVR_XFB_TOPOLOGY_POINTS:
+      return vertex_count;
+   case PVR_XFB_TOPOLOGY_LINES:
+      return vertex_count / 2;
+   case PVR_XFB_TOPOLOGY_LINE_STRIP:
+      return vertex_count >= 2 ? vertex_count - 1 : 0;
+   case PVR_XFB_TOPOLOGY_TRIANGLES:
+      return vertex_count / 3;
+   case PVR_XFB_TOPOLOGY_TRIANGLE_STRIP:
+   case PVR_XFB_TOPOLOGY_TRIANGLE_FAN:
+      return vertex_count >= 3 ? vertex_count - 2 : 0;
+   default:
+      return 0;
+   }
+}
+
+struct xfb_state {
+   const struct vk_vertex_input_state *vi;
+   const pco_data *vs_data;
+   const nir_xfb_info *xfb;
+
+   /* lo/hi of the parameter block. */
+   nir_def *params;
+   /* The output vertex this invocation produces, over all instances. */
+   nir_def *slot;
+   nir_def *instance;
+   nir_def *first_vertex;
+   nir_def *first_instance;
+   nir_def *vertex_index;
+   /* lo/hi of this vertex's record in each buffer. */
+   nir_def *record[PVR_XFB_MAX_BUFFERS];
+};
+
+/* 64-bit address arithmetic on lo/hi pairs, as nir_lower_explicit_io does
+ * it for nir_address_format_2x32bit_global.
+ */
+static nir_def *addr_add(nir_builder *b, nir_def *addr, nir_def *offset)
+{
+   nir_def *lo = nir_channel(b, addr, 0);
+   nir_def *hi = nir_channel(b, addr, 1);
+   nir_def *res_lo = nir_iadd(b, lo, offset);
+   nir_def *carry = nir_b2i32(b, nir_ult(b, res_lo, lo));
+
+   return nir_vec2(b, res_lo, nir_iadd(b, hi, carry));
+}
+
+static nir_def *addr_add_imm(nir_builder *b, nir_def *addr, uint32_t offset)
+{
+   return offset ? addr_add(b, addr, nir_imm_int(b, offset)) : addr;
+}
+
+static nir_def *load_dw(nir_builder *b, nir_def *addr, unsigned count)
+{
+   return nir_load_global_2x32(b, count, 32, addr, .align_mul = 4);
+}
+
+static nir_def *param(nir_builder *b, struct xfb_state *st, unsigned dw)
+{
+   return load_dw(b, addr_add_imm(b, st->params, dw * sizeof(uint32_t)), 1);
+}
+
+static nir_def *param_addr(nir_builder *b, struct xfb_state *st, unsigned dw)
+{
+   return load_dw(b, addr_add_imm(b, st->params, dw * sizeof(uint32_t)), 2);
+}
+
+/* The vertex, counted from the draw's first one, that goes into slot k of
+ * primitive prim under the draw's topology: the order in which the
+ * primitives are assembled, strips and fans expanded into lists.
+ */
+static nir_def *source_vertex(nir_builder *b,
+                              nir_def *topology,
+                              nir_def *prim,
+                              nir_def *k,
+                              nir_def *list_vertex)
+{
+   nir_def *strip = nir_iadd(b, prim, k);
+   nir_def *odd = nir_i2b(b, nir_iand_imm(b, prim, 1));
+   /* Odd triangles of a strip are (i + 1, i, i + 2). */
+   nir_def *odd_k = nir_bcsel(b,
+                              nir_ieq_imm(b, k, 0),
+                              nir_imm_int(b, 1),
+                              nir_bcsel(b,
+                                        nir_ieq_imm(b, k, 1),
+                                        nir_imm_int(b, 0),
+                                        nir_imm_int(b, 2)));
+   nir_def *tri_strip =
+      nir_bcsel(b, odd, nir_iadd(b, prim, odd_k), strip);
+   nir_def *fan = nir_bcsel(b, nir_ieq_imm(b, k, 0), nir_imm_int(b, 0), strip);
+
+   nir_def *v = list_vertex;
+   v = nir_bcsel(b,
+                 nir_ieq_imm(b, topology, PVR_XFB_TOPOLOGY_LINE_STRIP),
+                 strip,
+                 v);
+   v = nir_bcsel(b,
+                 nir_ieq_imm(b, topology, PVR_XFB_TOPOLOGY_TRIANGLE_STRIP),
+                 tri_strip,
+                 v);
+   v = nir_bcsel(b,
+                 nir_ieq_imm(b, topology, PVR_XFB_TOPOLOGY_TRIANGLE_FAN),
+                 fan,
+                 v);
+   return v;
+}
+
+/* The dword holding the byte at addr, and that byte's bit position in it:
+ * the memory loads have to be dword-aligned (an unaligned one returns the
+ * bytes up to the next dword boundary only).
+ */
+static nir_def *load_dw_around(nir_builder *b, nir_def *addr, nir_def **shift)
+{
+   nir_def *lo = nir_channel(b, addr, 0);
+   nir_def *aligned =
+      nir_vec2(b, nir_iand_imm(b, lo, ~3u), nir_channel(b, addr, 1));
+
+   *shift = nir_imul_imm(b, nir_iand_imm(b, lo, 3), 8);
+   return load_dw(b, aligned, 1);
+}
+
+/* Reads index number i (from firstIndex) of index_size bytes. Indices are
+ * naturally aligned, so one never straddles a dword.
+ */
+static nir_def *load_index(nir_builder *b,
+                           nir_def *index_addr,
+                           nir_def *index_size,
+                           nir_def *i)
+{
+   nir_def *byte_offset = nir_imul(b, i, index_size);
+   nir_def *shift;
+   nir_def *dw = load_dw_around(b, addr_add(b, index_addr, byte_offset), &shift);
+   nir_def *mask = nir_bcsel(b,
+                             nir_ieq_imm(b, index_size, 4),
+                             nir_imm_int(b, 0xffffffff),
+                             nir_bcsel(b,
+                                       nir_ieq_imm(b, index_size, 2),
+                                       nir_imm_int(b, 0xffff),
+                                       nir_imm_int(b, 0xff)));
+   return nir_iand(b, nir_ushr(b, dw, shift), mask);
+}
+
+static bool lower_input(nir_builder *b,
+                        nir_intrinsic_instr *intr,
+                        struct xfb_state *st)
+{
+   gl_vert_attrib location = nir_intrinsic_io_semantics(intr).location;
+   unsigned component = nir_intrinsic_component(intr);
+   unsigned attrib = location - VERT_ATTRIB_GENERIC0;
+
+   assert(intr->def.num_components == 1 && intr->def.bit_size == 32);
+   assert(location >= VERT_ATTRIB_GENERIC0 && location <= VERT_ATTRIB_GENERIC15);
+   assert(nir_src_as_uint(intr->src[0]) == 0);
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   enum pipe_format format = st->vs_data->vs.attrib_formats[location];
+   unsigned format_dwords =
+      format == PIPE_FORMAT_NONE
+         ? 0
+         : DIV_ROUND_UP(util_format_get_blocksize(format), sizeof(uint32_t));
+
+   if (!(st->vi->attributes_valid & BITFIELD_BIT(attrib)) ||
+       component >= format_dwords) {
+      /* Not fed by the pipeline, or a dword the format does not have (the
+       * unpacking does not read it).
+       */
+      nir_def_replace(&intr->def, nir_imm_int(b, 0));
+      return true;
+   }
+
+   const struct vk_vertex_attribute_state *attr = &st->vi->attributes[attrib];
+   const struct vk_vertex_binding_state *binding =
+      &st->vi->bindings[attr->binding];
+   unsigned vb = PVR_XFB_PARAMS_VB0 + attr->binding * PVR_XFB_PARAMS_VB_DWORDS;
+
+   nir_def *vb_addr = param_addr(b, st, vb + PVR_XFB_PARAMS_VB_LO);
+   nir_def *vb_size = param(b, st, vb + PVR_XFB_PARAMS_VB_SIZE);
+   nir_def *vb_stride = param(b, st, vb + PVR_XFB_PARAMS_VB_STRIDE);
+
+   nir_def *index;
+   if (binding->input_rate == VK_VERTEX_INPUT_RATE_INSTANCE) {
+      if (binding->divisor == 0) {
+         index = st->first_instance;
+      } else {
+         index = nir_iadd(b,
+                          st->first_instance,
+                          nir_udiv_imm(b, st->instance, binding->divisor));
+      }
+   } else {
+      index = st->vertex_index;
+   }
+
+   nir_def *offset =
+      nir_iadd_imm(b,
+                   nir_imul(b, index, vb_stride),
+                   attr->offset + component * sizeof(uint32_t));
+   /* robustBufferAccess: a dword past the bound range reads as zero, and
+    * the loads themselves stay inside the buffer.
+    */
+   nir_def *in_bounds =
+      nir_uge(b, vb_size, nir_iadd_imm(b, offset, sizeof(uint32_t)));
+   nir_def *safe_offset = nir_bcsel(b, in_bounds, offset, nir_imm_int(b, 0));
+   nir_def *safe_addr =
+      nir_bcsel(b, nir_ine_imm(b, vb_size, 0), vb_addr, st->params);
+   nir_def *addr = addr_add(b, safe_addr, safe_offset);
+
+   /* The attribute's dword may straddle two aligned ones (an offset or a
+    * stride that is not a multiple of 4): take the bytes from both. The
+    * second dword is only read where the buffer still has one.
+    */
+   nir_def *shift;
+   nir_def *lo_dw = load_dw_around(b, addr, &shift);
+   nir_def *aligned_offset = nir_iand_imm(b, safe_offset, ~3u);
+   nir_def *has_next =
+      nir_uge(b, vb_size, nir_iadd_imm(b, aligned_offset, 2 * sizeof(uint32_t)));
+   nir_def *next_offset =
+      nir_bcsel(b,
+                has_next,
+                nir_iadd_imm(b, aligned_offset, sizeof(uint32_t)),
+                aligned_offset);
+   nir_def *hi_dw = load_dw(b, addr_add(b, safe_addr, next_offset), 1);
+   nir_def *straddles = nir_ine_imm(b, shift, 0);
+   nir_def *joined =
+      nir_ior(b,
+              nir_ushr(b, lo_dw, shift),
+              nir_ishl(b, hi_dw, nir_isub(b, nir_imm_int(b, 32), shift)));
+   nir_def *value = nir_bcsel(b, straddles, joined, lo_dw);
+
+   nir_def_replace(&intr->def, nir_bcsel(b, in_bounds, value, nir_imm_int(b, 0)));
+   return true;
+}
+
+static const nir_xfb_output_info *find_output(const nir_xfb_info *xfb,
+                                              unsigned location,
+                                              unsigned component)
+{
+   for (unsigned i = 0; i < xfb->output_count; ++i) {
+      const nir_xfb_output_info *out = &xfb->outputs[i];
+      if (out->location == location &&
+          (out->component_mask & BITFIELD_BIT(component)))
+         return out;
+   }
+
+   return NULL;
+}
+
+static bool lower_output(nir_builder *b,
+                         nir_intrinsic_instr *intr,
+                         struct xfb_state *st)
+{
+   unsigned location = nir_intrinsic_io_semantics(intr).location +
+                       nir_src_as_uint(intr->src[1]);
+   unsigned component = nir_intrinsic_component(intr);
+   unsigned write_mask = nir_intrinsic_write_mask(intr);
+   nir_def *value = intr->src[0].ssa;
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   if (value->bit_size == 32) {
+      u_foreach_bit (i, write_mask) {
+         const nir_xfb_output_info *out =
+            find_output(st->xfb, location, component + i);
+         if (!out)
+            continue;
+
+         assert(!out->data_is_16bit);
+         unsigned offset =
+            out->offset +
+            (component + i - out->component_offset) * sizeof(uint32_t);
+         nir_store_global_2x32(b,
+                               nir_channel(b, value, i),
+                               addr_add_imm(b, st->record[out->buffer], offset),
+                               .write_mask = 1,
+                               .align_mul = 4);
+      }
+   }
+
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+static bool lower_intr(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   struct xfb_state *st = data;
+   nir_def *replacement;
+
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_input:
+      return lower_input(b, intr, st);
+
+   case nir_intrinsic_store_output:
+      return lower_output(b, intr, st);
+
+   case nir_intrinsic_load_vertex_id:
+      replacement = st->vertex_index;
+      break;
+   case nir_intrinsic_load_instance_id:
+      b->cursor = nir_before_instr(&intr->instr);
+      replacement = nir_iadd(b, st->first_instance, st->instance);
+      break;
+   case nir_intrinsic_load_base_vertex:
+   case nir_intrinsic_load_first_vertex:
+      replacement = st->first_vertex;
+      break;
+   case nir_intrinsic_load_base_instance:
+      replacement = st->first_instance;
+      break;
+   case nir_intrinsic_load_draw_id:
+   case nir_intrinsic_load_view_index:
+      b->cursor = nir_before_instr(&intr->instr);
+      replacement = nir_imm_int(b, 0);
+      break;
+   case nir_intrinsic_load_is_indexed_draw:
+      b->cursor = nir_before_instr(&intr->instr);
+      replacement = nir_ine_imm(b, param(b, st, PVR_XFB_PARAMS_INDEX_SIZE), 0);
+      replacement = nir_b2i32(b, replacement);
+      break;
+
+   default:
+      return false;
+   }
+
+   nir_def_replace(&intr->def, replacement);
+   return true;
+}
+
+static unsigned glsl_type_size(const struct glsl_type *type,
+                               UNUSED bool bindless)
+{
+   return glsl_count_attribute_slots(type, false);
+}
+
+bool pvr_xfb_lower_vs_to_cs(nir_shader *nir,
+                            const struct vk_vertex_input_state *vi,
+                            pco_data *vs_data,
+                            struct pvr_xfb_shader_info *info)
+{
+   const nir_xfb_info *xfb = nir->xfb_info;
+
+   assert(nir->info.stage == MESA_SHADER_VERTEX);
+
+   if (!xfb || !xfb->output_count || !xfb->buffers_written)
+      return false;
+
+   for (unsigned i = 0; i < xfb->output_count; ++i) {
+      if (xfb->outputs[i].data_is_16bit)
+         return false;
+   }
+
+   *info = (struct pvr_xfb_shader_info){
+      .buffers_written = xfb->buffers_written,
+   };
+   for (unsigned i = 0; i < PVR_XFB_MAX_BUFFERS; ++i)
+      info->strides[i] = xfb->buffers[i].stride;
+
+   /* Inputs and outputs as intrinsics, inputs as the raw dwords the vertex
+    * DMA would deliver (pco_nir_pvi unpacks them, in any stage).
+    */
+   NIR_PASS(_,
+            nir,
+            nir_lower_io,
+            nir_var_shader_in | nir_var_shader_out,
+            glsl_type_size,
+            nir_lower_io_lower_64bit_to_32 |
+               nir_lower_io_use_interpolated_input_intrinsics);
+   NIR_PASS(_, nir, nir_lower_io_to_scalar, nir_var_shader_in, NULL, NULL);
+   /* The dead derefs of the variables must go before pvi retypes them. */
+   NIR_PASS(_, nir, nir_opt_copy_prop);
+   NIR_PASS(_, nir, nir_opt_dce);
+   NIR_PASS(_, nir, pco_nir_pvi, &vs_data->vs);
+   NIR_PASS(_, nir, nir_opt_constant_folding);
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   struct xfb_state st = {
+      .vi = vi,
+      .vs_data = vs_data,
+      .xfb = xfb,
+   };
+
+   /* From here on a compute shader: one invocation per output vertex. */
+   nir->info.stage = MESA_SHADER_COMPUTE;
+   memset(&nir->info.cs, 0, sizeof(nir->info.cs));
+   nir->info.workgroup_size[0] = PVR_XFB_WORKGROUP_SIZE;
+   nir->info.workgroup_size[1] = 1;
+   nir->info.workgroup_size[2] = 1;
+   nir->info.workgroup_size_variable = false;
+   nir->info.shared_size = 0;
+   nir->info.inputs_read = 0;
+   nir->info.outputs_written = 0;
+   nir->info.outputs_read = 0;
+   nir->info.clip_distance_array_size = 0;
+   nir->info.cull_distance_array_size = 0;
+   nir->xfb_info = NULL;
+
+   /* The vertex shader's body runs only for a slot the draw produces and
+    * that fits into every buffer: extract it, build the prologue, and put
+    * it back under the condition.
+    */
+   nir_cf_list body;
+   nir_cf_extract(&body, nir_before_impl(impl), nir_after_impl(impl));
+
+   nir_builder bld = nir_builder_at(nir_before_impl(impl));
+   nir_builder *b = &bld;
+
+   st.params = nir_load_preamble(b, 2, 32, .base = PCO_XFB_PARAMS_BASE);
+   st.slot = nir_channel(b, nir_load_global_invocation_id(b, 32), 0);
+
+   nir_def *total = param(b, &st, PVR_XFB_PARAMS_TOTAL_VERTICES);
+   nir_def *verts_per_prim = param(b, &st, PVR_XFB_PARAMS_VERTS_PER_PRIM);
+   nir_def *prim_count = param(b, &st, PVR_XFB_PARAMS_PRIM_COUNT);
+   nir_def *topology = param(b, &st, PVR_XFB_PARAMS_TOPOLOGY);
+   nir_def *index_size = param(b, &st, PVR_XFB_PARAMS_INDEX_SIZE);
+   nir_def *restart = param(b, &st, PVR_XFB_PARAMS_RESTART_ENABLE);
+   nir_def *index_addr = param_addr(b, &st, PVR_XFB_PARAMS_INDEX_LO);
+   nir_def *state_addr = param_addr(b, &st, PVR_XFB_PARAMS_STATE_LO);
+   st.first_vertex = param(b, &st, PVR_XFB_PARAMS_FIRST_VERTEX);
+   st.first_instance = param(b, &st, PVR_XFB_PARAMS_FIRST_INSTANCE);
+
+   nir_def *verts_per_instance = nir_imul(b, prim_count, verts_per_prim);
+   st.instance = nir_udiv(b, st.slot, verts_per_instance);
+   nir_def *in_instance =
+      nir_isub(b, st.slot, nir_imul(b, st.instance, verts_per_instance));
+   nir_def *prim = nir_udiv(b, in_instance, verts_per_prim);
+   nir_def *k = nir_isub(b, in_instance, nir_imul(b, prim, verts_per_prim));
+
+   nir_def *valid = nir_ult(b, st.slot, total);
+   nir_def *src = source_vertex(b, topology, prim, k, in_instance);
+   nir_def *indexed = nir_ine_imm(b, index_size, 0);
+   /* Loads from the index buffer only where the draw has indices: the
+    * invocations past the end of the draw read index 0 and are dropped.
+    */
+   nir_def *safe_index_addr = nir_bcsel(b, indexed, index_addr, st.params);
+   nir_def *index =
+      load_index(b,
+                 safe_index_addr,
+                 index_size,
+                 nir_bcsel(b, valid, src, nir_imm_int(b, 0)));
+   st.vertex_index =
+      nir_iadd(b, st.first_vertex, nir_bcsel(b, indexed, index, src));
+
+   /* Primitive restart: a primitive with the restart index in it is not
+    * assembled. (Its slots stay reserved: see DESIGN.md.)
+    */
+   nir_def *check_restart =
+      nir_iand(b, valid, nir_iand(b, indexed, nir_ine_imm(b, restart, 0)));
+   nir_def *restart_hit = nir_imm_false(b);
+   for (unsigned kk = 0; kk < 3; ++kk) {
+      nir_def *src_kk =
+         source_vertex(b,
+                       topology,
+                       prim,
+                       nir_imm_int(b, kk),
+                       nir_iadd_imm(b, nir_imul(b, prim, verts_per_prim), kk));
+      nir_def *in_prim = nir_ult(b, nir_imm_int(b, kk), verts_per_prim);
+      nir_def *load_it = nir_iand(b, check_restart, in_prim);
+      nir_def *idx = load_index(b,
+                                safe_index_addr,
+                                index_size,
+                                nir_bcsel(b, load_it, src_kk, nir_imm_int(b, 0)));
+      nir_def *restart_value =
+         nir_bcsel(b,
+                   nir_ieq_imm(b, index_size, 4),
+                   nir_imm_int(b, 0xffffffff),
+                   nir_bcsel(b,
+                             nir_ieq_imm(b, index_size, 2),
+                             nir_imm_int(b, 0xffff),
+                             nir_imm_int(b, 0xff)));
+      nir_def *hit = nir_iand(b, load_it, nir_ieq(b, idx, restart_value));
+      restart_hit = nir_ior(b, restart_hit, hit);
+   }
+
+   /* Does the primitive fit into every buffer, after what is already
+    * there? Then this vertex's record is at offset + slot * stride.
+    */
+   nir_def *fits = nir_imm_true(b);
+   u_foreach_bit (buffer, xfb->buffers_written) {
+      unsigned base = PVR_XFB_PARAMS_XFB0 + buffer * PVR_XFB_PARAMS_XFB_DWORDS;
+      unsigned stride = xfb->buffers[buffer].stride;
+      nir_def *buf_addr = param_addr(b, &st, base + PVR_XFB_PARAMS_XFB_LO);
+      nir_def *size = param(b, &st, base + PVR_XFB_PARAMS_XFB_SIZE);
+      nir_def *offset =
+         load_dw(b,
+                 addr_add_imm(b,
+                              state_addr,
+                              (PVR_XFB_STATE_OFFSET0 + buffer) * sizeof(uint32_t)),
+                 1);
+      nir_def *avail = nir_bcsel(b,
+                                 nir_uge(b, size, offset),
+                                 nir_isub(b, size, offset),
+                                 nir_imm_int(b, 0));
+      nir_def *needed =
+         nir_imul_imm(b, nir_imul(b, nir_iadd_imm(b, prim, 1), verts_per_prim),
+                      stride);
+      fits = nir_iand(b, fits, nir_uge(b, avail, needed));
+
+      st.record[buffer] =
+         addr_add(b,
+                  addr_add(b, buf_addr, offset),
+                  nir_imul_imm(b, st.slot, stride));
+   }
+
+   nir_def *run = nir_iand(b, valid, fits);
+   run = nir_iand(b, run, nir_inot(b, restart_hit));
+
+   nir_if *nif = nir_push_if(b, run);
+   nir_cf_reinsert(&body, b->cursor);
+   nir_pop_if(b, nif);
+
+   nir_progress(true, impl, nir_metadata_none);
+
+   nir_shader_intrinsics_pass(nir, lower_intr, nir_metadata_none, &st);
+
+   NIR_PASS(_,
+            nir,
+            nir_remove_dead_variables,
+            nir_var_shader_in | nir_var_shader_out | nir_var_system_value,
+            NULL);
+   NIR_PASS(_, nir, nir_lower_system_values);
+   NIR_PASS(_,
+            nir,
+            nir_lower_compute_system_values,
+            &(nir_lower_compute_system_values_options){
+               .lower_cs_local_id_to_index = true,
+            });
+   NIR_PASS(_, nir, nir_opt_constant_folding);
+   NIR_PASS(_, nir, nir_opt_idiv_const, 32);
+   NIR_PASS(_,
+            nir,
+            nir_lower_idiv,
+            &(nir_lower_idiv_options){
+               .allow_fp16 = false,
+            });
+   NIR_PASS(_, nir, nir_opt_dce);
+   NIR_PASS(_, nir, nir_opt_cse);
+   NIR_PASS(_, nir, nir_opt_dce);
+
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+
+   return true;
+}
diff -ruN a/src/imagination/vulkan/pvr_xfb.h b/src/imagination/vulkan/pvr_xfb.h
--- a/src/imagination/vulkan/pvr_xfb.h
+++ b/src/imagination/vulkan/pvr_xfb.h
@@ -0,0 +1,68 @@
+/*
+ * Copyright 2026, air/OS. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+/* Transform feedback emulation for the PowerVR Vulkan driver.
+ *
+ * The hardware path of the open driver has no transform feedback output. A
+ * pipeline whose vertex shader captures outputs therefore also gets a
+ * compute kernel built from that vertex shader: one invocation per output
+ * vertex (primitive by primitive, as the draw would assemble them), which
+ * fetches its own index and vertex data, runs the vertex shader's code and
+ * writes the captured outputs into the transform feedback buffers. The real
+ * draw is unchanged. See evidence/gpu/xfb/DESIGN.md in the air/OS tree.
+ */
+
+#ifndef PVR_XFB_H
+#define PVR_XFB_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <vulkan/vulkan.h>
+
+#include "common/pvr_iface.h"
+#include "compiler/nir/nir_xfb_info.h"
+#include "nir/nir.h"
+#include "pco/pco.h"
+
+struct vk_vertex_input_state;
+
+/* The topologies the kernel can expand; PVR_XFB_PARAMS_TOPOLOGY. */
+enum pvr_xfb_topology {
+   PVR_XFB_TOPOLOGY_POINTS,
+   PVR_XFB_TOPOLOGY_LINES,
+   PVR_XFB_TOPOLOGY_LINE_STRIP,
+   PVR_XFB_TOPOLOGY_TRIANGLES,
+   PVR_XFB_TOPOLOGY_TRIANGLE_STRIP,
+   PVR_XFB_TOPOLOGY_TRIANGLE_FAN,
+   PVR_XFB_TOPOLOGY_UNSUPPORTED,
+};
+
+/* What a draw needs to know about a pipeline's capture. */
+struct pvr_xfb_shader_info {
+   uint8_t buffers_written;
+   uint16_t strides[PVR_XFB_MAX_BUFFERS];
+};
+
+/* The kernel's workgroup: one task's worth of instances. */
+#define PVR_XFB_WORKGROUP_SIZE 32U
+
+/* Turns a copy of a vertex shader (after pco_preprocess_nir(), inputs and
+ * outputs still variables, system values intrinsics) into the compute
+ * kernel described above. vi is the pipeline's vertex input state (bindings
+ * and attributes), vs_data->vs.attrib_formats must be set up. Fills info.
+ * Returns false if the shader cannot be lowered (nothing captured, or an
+ * output type the kernel does not handle).
+ */
+bool pvr_xfb_lower_vs_to_cs(nir_shader *nir,
+                            const struct vk_vertex_input_state *vi,
+                            pco_data *vs_data,
+                            struct pvr_xfb_shader_info *info);
+
+enum pvr_xfb_topology pvr_xfb_topology(VkPrimitiveTopology topology);
+uint32_t pvr_xfb_verts_per_prim(enum pvr_xfb_topology topology);
+uint32_t pvr_xfb_prim_count(enum pvr_xfb_topology topology,
+                            uint32_t vertex_count);
+
+#endif /* PVR_XFB_H */
