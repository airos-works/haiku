+                                             struct vk_queue_submit *submit)
 {
    struct pvr_queue *driver_queue = container_of(queue, struct pvr_queue, vk);
    struct pvr_device *device = driver_queue->device;
@@ -1064,6 +1064,50 @@
    return VK_SUCCESS;
