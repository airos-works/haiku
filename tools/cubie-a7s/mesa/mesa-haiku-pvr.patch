+
+static const char *pvr_load_op_name(VkAttachmentLoadOp op)
+{
+   switch (op) {
+   case VK_ATTACHMENT_LOAD_OP_LOAD:
+      return "load";
+   case VK_ATTACHMENT_LOAD_OP_CLEAR:
+      return "clear";
+   case VK_ATTACHMENT_LOAD_OP_DONT_CARE:
+      return "dontcare";
+   default:
+      return "none";
+   }
+}
