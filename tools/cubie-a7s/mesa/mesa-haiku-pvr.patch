+   char inits[96] = "";
+   char pbes[256] = "";
+   size_t used = 0;
+
+   if (hw_render) {
+      for (uint32_t i = 0; i < hw_render->color_init_count && used < 80; i++) {
+         used += snprintf(inits + used,
+                          sizeof(inits) - used,
+                          "%s%u:%s",
+                          i ? "," : "",
+                          hw_render->color_init[i].index,
+                          pvr_load_op_name(hw_render->color_init[i].op));
