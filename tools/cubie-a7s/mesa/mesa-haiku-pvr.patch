+/* Cache maintenance of mapped ranges of the host-cached (non-coherent)
+ * memory type; the coherent type needs none.
+ */
+static void pvr_mapped_memory_ranges_maintain(
+   struct pvr_device *device,
+   uint32_t memoryRangeCount,
+   const VkMappedMemoryRange *pMemoryRanges,
+   bool invalidate)
+{
+   for (uint32_t i = 0; i < memoryRangeCount; i++) {
+      VK_FROM_HANDLE(pvr_device_memory, mem, pMemoryRanges[i].memory);
+      const VkMemoryType *mem_type =
+         &device->pdevice->memory.memoryTypes[mem->vk.memory_type_index];
+      VkDeviceSize offset = pMemoryRanges[i].offset;
+      VkDeviceSize size;
+
+      if (mem_type->propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)
+         continue;
+
+      /* The range must be mapped; the whole memory object always is. */
+      if (!mem->bo->map || offset >= mem->bo->size)
+         continue;
+
+      size = pMemoryRanges[i].size == VK_WHOLE_SIZE
+                ? mem->bo->size - offset
+                : MIN2(pMemoryRanges[i].size, mem->bo->size - offset);
+
+      pvr_host_cache_maintain((const uint8_t *)mem->bo->map + offset,
+                              size,
+                              invalidate);
+   }
+}
