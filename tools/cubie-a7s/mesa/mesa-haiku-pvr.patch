+/* (air/OS) Transform feedback emulation (vulkan/pvr_xfb.c): the kernels that
+ * keep the per-command-buffer state (bytes written per buffer) and the query
+ * counters. The vertex-shader-as-compute kernel itself is compiled per
+ * pipeline. All addresses are 32+32 bit; the loads and stores are dwords.
+ */
+static inline uint
+xfb_ld_dw(uint lo, uint hi, uint dw)
+{
+   return nir_dma_ld_pco(1, nir_uadd64_32(lo, hi, dw * sizeof(uint32_t)));
+}
+
+static inline void
+xfb_st_dw(uint lo, uint hi, uint dw, uint value)
+{
+   nir_dma_st_pco(false, nir_uadd64_32(lo, hi, dw * sizeof(uint32_t)), value);
+}
+
+static inline void
+xfb_counter(uint mode, uint state_lo, uint state_hi, uint b, uint counter_lo,
+            uint counter_hi)
+{
+   bool has_counter = (counter_lo | counter_hi) != 0;
+   if (mode == PVR_XFB_COUNTERS_MODE_BEGIN) {
+      uint offset = 0;
+      if (has_counter)
+         offset = xfb_ld_dw(counter_lo, counter_hi, 0);
+      xfb_st_dw(state_lo, state_hi, PVR_XFB_STATE_OFFSET0 + b, offset);
+   } else if (has_counter) {
+      xfb_st_dw(counter_lo, counter_hi, 0,
+                xfb_ld_dw(state_lo, state_hi, PVR_XFB_STATE_OFFSET0 + b));
+   }
+}
+
+/* vkCmdBeginTransformFeedbackEXT loads the offsets from the counter buffers
+ * (0 without one); vkCmdEndTransformFeedbackEXT stores them.
+ */
+KERNEL(1)
+cs_xfb_counters_common(void)
+{
+   uint mode = nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_MODE, 0);
+   uint state_lo = nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_STATE_LO, 0);
+   uint state_hi = nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_STATE_HI, 0);
+   xfb_counter(mode, state_lo, state_hi, 0,
+               nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_COUNTER0_LO, 0),
+               nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_COUNTER0_HI, 0));
+   xfb_counter(mode, state_lo, state_hi, 1,
+               nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_COUNTER1_LO, 0),
+               nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_COUNTER1_HI, 0));
+   xfb_counter(mode, state_lo, state_hi, 2,
+               nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_COUNTER2_LO, 0),
+               nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_COUNTER2_HI, 0));
+   xfb_counter(mode, state_lo, state_hi, 3,
+               nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_COUNTER3_LO, 0),
+               nir_load_preamble(1, PVR_XFB_COUNTERS_DATA_COUNTER3_HI, 0));
+}
