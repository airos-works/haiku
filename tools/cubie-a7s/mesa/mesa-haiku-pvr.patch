+#else /* __HAIKU__ */
+/* air/OS (Haiku): there is no mmap() of the render device. PVR_HAIKU_NR_MAP_BO
+ * clones the buffer's kernel area into this team (write-combined, like a
+ * Linux mapping of a buffer on a non-coherent GPU) and returns where; the
+ * clone is unmapped with delete_area(). Only buffers created with
+ * DRM_PVR_BO_ALLOW_CPU_USERSPACE_ACCESS (PVR_WINSYS_BO_FLAG_CPU_ACCESS) can
+ * be mapped.
+ *
+ * A placed map (VK_EXT_map_memory_placed) passes the address: the range is
+ * the application's reservation, which is freed so that the clone can take
+ * exactly its place (B_EXACT_ADDRESS); if that fails, the reservation is
+ * put back.
+ */
+/* The structure grew flags (PVR_HAIKU_MAP_BO_CACHED); a kernel driver still
+ * expecting the old 24 bytes maps write-combined.
+ */
+static_assert(sizeof(struct pvr_haiku_map_bo) == 32,
+              "struct pvr_haiku_map_bo is not the 32-byte one with flags");
+
+static VkResult pvr_drm_haiku_map_bo(struct pvr_drm_winsys *drm_ws,
+                                     uint32_t handle,
+                                     void *addr,
+                                     uint64_t size,
+                                     bool cached,
+                                     void **const map_out)
+{
+   struct pvr_haiku_map_bo args = {
+      .handle = handle,
+      .area = -1,
+      .address = (uint64_t)(uintptr_t)addr,
+      .flags = cached ? PVR_HAIKU_MAP_BO_CACHED : 0,
+   };
+   int ret;
+   int err;
+
+   if (addr)
+      munmap(addr, size);
+
+   do {
+      ret = ioctl(drm_ws->base.render_fd,
+                  PVR_HAIKU_OP(PVR_HAIKU_NR_MAP_BO),
+                  &args,
+                  sizeof(args));
+   } while (ret == -1 && errno == EINTR);
+
+   if (ret == 0 && (args.area < 0 || args.size < size ||
+                    (addr && args.address != (uint64_t)(uintptr_t)addr))) {
+      if (args.area >= 0)
+         delete_area(args.area);
+      ret = -1;
+      errno = B_BAD_DATA;
+   }
+
+   if (ret != 0) {
+      err = errno;
+      if (addr) {
+         mmap(addr,
+              size,
+              PROT_NONE,
+              MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED,
+              -1,
+              0);
+      }
+
+      return vk_errorf(NULL,
+                       VK_ERROR_MEMORY_MAP_FAILED,
+                       "PVR_HAIKU_NR_MAP_BO of handle %u failed (%s)",
+                       handle,
+                       strerror(err));
+   }
+
+   *map_out = (void *)(uintptr_t)args.address;
+
+   return VK_SUCCESS;
+}
+
+static VkResult pvr_drm_haiku_unmap_bo(void *map, uint64_t size, bool reserve)
+{
+   area_id area = area_for(map);
+   status_t status;
+
+   if (area < 0) {
+      return vk_errorf(NULL,
+                       VK_ERROR_UNKNOWN,
+                       "no area at %p (%s)",
+                       map,
+                       strerror(area));
+   }
+
+   status = delete_area(area);
+   if (status != B_OK) {
+      return vk_errorf(NULL,
+                       VK_ERROR_UNKNOWN,
+                       "delete_area failed (%s)",
+                       strerror(status));
+   }
+
+   /* VK_EXT_map_memory_placed's memoryUnmapReserve: keep the range */
+   if (reserve) {
+      void *ret = mmap(map,
+                       size,
+                       PROT_NONE,
+                       MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED,
+                       -1,
+                       0);
+      if (ret == MAP_FAILED) {
+         return vk_errorf(NULL,
+                          VK_ERROR_UNKNOWN,
+                          "mmap(reserve) failed (%s)",
+                          strerror(errno));
+      }
+   }
+
+   return VK_SUCCESS;
+}
