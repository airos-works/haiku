# air/OS: U-Boot proper for the Cubie A7S, started by Radxa's BSP U-Boot 2018
# (boot0 boot chain) through booti, to provide UEFI for Haiku's loader.
# The lab card's airos/chain.scr (ESP on partition 2) takes over if present;
# otherwise the standard boot finds EFI/BOOT/BOOTAA64.EFI and
# dtb/allwinner/sun60i-a733-cubie-a7s.dtb on the ESP.
CONFIG_SUNXI_CHAINLOAD=y
CONFIG_LOCALVERSION="-airos"
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
CONFIG_BOOTDELAY=2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="if load mmc 0:2 ${scriptaddr} airos/chain.scr; then source ${scriptaddr}; fi; bootflow scan; echo air/OS: nothing to boot; sleep 5; reset"
# CONFIG_TOOLS_MKEFICAPSULE is not set
