# air/OS release images, built by the air/OS build server (airos-works/airos-ci,
# images/build-image.sh) from this tree and from inputs CI builds itself (the
# owner's applications, Summit, the libraries and GL stack from the airos-works
# forks, firmware) - never from a workstation's directories.
#
#   x86_64     jam -q @nightly-airos-x86_64               -> airos-x86_64.iso
#              hybrid ISO for a USB stick or a CD, EFI and BIOS (X399 and
#              other PCs); boots to the desktop and the Installer
#   arm64 EFI  jam -q @airos-arm64                        -> airos-arm64.iso
#              hybrid ISO with an EFI system partition (ROCK 5 ITX and other
#              arm64 machines with UEFI firmware)
#   Pi 4       jam -q @airos-rpi4 airos-rpi-image         -> airos-rpi4.img
#              SD card image (FAT boot partition + BFS) that boots directly
#   Cubie A7S  jam -q @airos-cubie                        -> haiku-airos-cubie.image
#              then tools/cubie-a7s/build-sd-image.sh haiku-airos-cubie.image
#              airos-cubie.img: SD card image (Radxa's boot chain, the air/OS
#              U-Boot, ESP, BFS); building that U-Boot needs an
#              aarch64-linux-gnu cross compiler (tools/cubie-a7s/u-boot)
#
# The build directory's UserBuildConfig sets these and then includes this file:
#   AIROS_CI_PACKAGES       directory of packages for system/packages: the
#                           applications, Summit and summit_webkit, the
#                           airos_* libraries, rock5_ffmpeg, firmware packages,
#                           and (x86_64) HaikuPorts packages the build system's
#                           repository list lacks, and qt6_base with air/OS's
#                           Haiku platform plugin; (arm64) CI's builds of
#                           base packages the bootstrap repository has
#                           (icu74, ncurses6), which the image gets instead,
#                           and the zstd package
#   AIROS_CI_SYSTEM_PACKAGES
#                           (x86_64) names of packages from the build system's
#                           HaikuPorts list that CI's packages need (Qt's
#                           dependencies), installed with theirs
#   AIROS_CI_FONTS          (arm64) HaikuPorts' noto and noto_sans_cjk_jp
#                           packages, added as system packages in place of
#                           the arm64 repository's bootstrap noto
#   HAIKU_ARM64_FREETYPE_PACKAGES_DIR
#                           (arm64) air/OS's freetype and freetype_devel
#                           packages: build/jam/BuildFeatures compiles Haiku
#                           against them and the top Jamfile puts freetype in
#                           the image instead of the bootstrap FreeType 2.6.3
#   HAIKU_ARM64_OPENSSL_PACKAGE
#                           (arm64) air/OS's airos_openssl package: the SSL
#                           build feature, libbnetapi's HTTPS (System Updater,
#                           pkgman, HaikuDepot); it goes in the image with
#                           AIROS_CI_BASE_PACKAGES
#   HAIKU_ARM64_LIBPNG_PACKAGES_DIR
#                           (arm64) air/OS's libpng16 and libpng16_devel: the
#                           libpng build feature (the PNG translator), and
#                           libpng16 in the image for it and for FreeType
#   HAIKU_MUPDF_PACKAGES_DIR
#                           HaikuPorts' mupdf and mupdf_devel for the
#                           architecture: the mupdf build feature (Quick
#                           Look's PDFPreview add-on); mupdf and jbig2dec go
#                           in the image through AIROS_CI_PACKAGES
#   AIROS_CI_LIBS           libraries for system/non-packaged/lib (GL stack)
#   AIROS_CI_EGL            EGL vendor files for .../add-ons/opengl/egl_vendor.d
#   AIROS_CI_DEMOS          demos for system/non-packaged/demos (an older
#                           CI's GLTeapot)
#   AIROS_CI_SYSTEM_DEMOS   (release images) demos the payload package puts in
#                           system/demos, each linked from Deskbar's Demos
#                           folder as the haiku package links its own (arm64:
#                           GLTeapot, which Haiku builds only with its mesa
#                           build feature)
#   AIROS_CI_SYSTEM_APPS    (release images) applications the payload package
#                           puts in system/apps (arm64: GLInfo)
#   AIROS_CI_ADDONS         an add-ons tree for system/non-packaged/add-ons
#   AIROS_CI_FLUIDLITE      (arm64) a prefix with FluidLite for the MIDI kit,
#                           read by build/jam/BuildFeatures
#   AIROS_CI_FIRMWARE       a tree copied to system/non-packaged/data/firmware
#   AIROS_CI_AMDGPU         (x86_64) the AMD GPU user land: a tree copied to
#                           system/non-packaged/amdgpu, which the boot script
#                           links into system/non-packaged where amdgpu_drm
#                           drives a GPU
#   AIROS_CI_ADRENO         (arm64) the Dragon Q8B's GPU user land: a tree
#                           copied to system/non-packaged/adreno (Turnip,
#                           zink's EGL vendor library, libvulkan.so.1), which
#                           the boot script links into system/non-packaged
#                           where the adreno driver publishes the GPU; its
#                           firmware comes with AIROS_CI_FIRMWARE
#   AIROS_CI_FILES          a jam file CI generates that names each file of
#                           the trees above (AirosCIFile, AirosCISymlink); used
#                           instead of the AIROS_CI_LIBS ... AIROS_CI_ADRENO
#                           rules when set
#   AIROS_CI_IMAGE_SIZE     image size in MiB (optional)
#   HAIKU_RPI_FIRMWARE_DIR  (Pi) the Raspberry Pi boot firmware files
#
# arm64 builds also get, from the environment (every jam run in the build
# directory needs them, not only the image's):
#   HAIKU_ARM64_ZSTD_PACKAGES_DIR
#                           CI's zstd, zstd_devel and zstd_source: the zstd
#                           build feature, so packagefs, the boot loader and
#                           the package kit read zstd packages
#   HAIKU_PACKAGE_DEFAULT_COMPRESSION = zlib
#                           while the packages the build makes stay zlib, for
#                           the arm64 systems that cannot read zstd yet
#
# A release image, which System Updater can update (docs/airos/SYSTEM-UPDATER.md),
# also has:
#   AIROS_CI_RELEASE_VERSION
#                           the release's version, its build time (20261026.0915)
#   AIROS_CI_RELEASE_DIR    a directory with "release" (the release file) and the
#                           package infos "airos_release" and "airos_payload"
# Its image then carries the airos_release package, and everything it would
# put into system/non-packaged goes into the airos_payload package instead,
# under data/airos/non-packaged, with a symlink in system/non-packaged for each
# file: the files belong to the package state like the rest of the system, so
# an older state started from the boot loader brings its own back.
#
# Unlike the lab configurations (tools/rock5-itx, tools/rpi4) this adds no
# remote shell, password, keys, probes or diagnostics.

HAIKU_IMAGE_LABEL = airOS ;
HAIKU_IMAGE_HOST_NAME ?= airos ;

DefineBuildProfile nightly-airos-x86_64 : anyboot-image : "airos-x86_64.iso" ;
DefineBuildProfile airos-arm64 : anyboot-image : "airos-arm64.iso" ;
DefineBuildProfile airos-rpi4 : image : "haiku-airos-rpi4.image" ;
DefineBuildProfile airos-cubie : image : "haiku-airos-cubie.image" ;

AIROS_X86_64 = ;
AIROS_ROCK5 = ;
AIROS_RPI4 = ;
AIROS_CUBIE = ;
switch $(HAIKU_BUILD_PROFILE) {
	case nightly-airos-x86_64 : {
		AIROS_X86_64 = 1 ;
		HAIKU_IMAGE_SIZE = $(AIROS_CI_IMAGE_SIZE:E=3072) ;
		# CI's curl with HTTP/3 (airos-ci deps/recipes/curl.sh, under the
		# repository package's name) instead of the repository's, whose
		# libcurl has none, with the QUIC and HTTP/3 libraries it requires:
		# as packages, so that the dependency resolution sees them. This
		# comes first: AddHaikuImageSystemPackages adds the repository's
		# package at once, so suppressing it later leaves both in the image.
		local curl = [ Glob $(AIROS_CI_PACKAGES) : curl-*-x86_64.hpkg ] ;
		if $(curl) {
			local quic = [ Glob $(AIROS_CI_PACKAGES)
				: airos_ngtcp2-*-x86_64.hpkg airos_nghttp3-*-x86_64.hpkg ] ;
			SuppressHaikuImagePackages curl ;
			AIROS_CI_BASE_PACKAGES += $(curl:BS) $(quic:BS) ;
		}
		# What the x86_64 applications require that the HaikuPorts repository
		# list of the build system has (the rest arrive as package files):
		# Amp (curl, SQLite), Kiri (git, PCRE2), airTime
		# (FFmpeg 6), Burrow (OpenSSL 3) and Summit's TLS certificates.
		AddHaikuImageSystemPackages curl sqlite libpcre2 openssl3 ffmpeg6 git
			ca_root_certificates ;
		# and what CI's packages need that this list has: Qt's dependencies
		# (airos-ci deps/build-qt-airos.sh, images/build-image.sh)
		if $(AIROS_CI_SYSTEM_PACKAGES) {
			AddHaikuImageSystemPackages $(AIROS_CI_SYSTEM_PACKAGES) ;
		}
		# CI's Vision (HaikuPorts' build with its Deskbar entry in the menu's
		# Utilities folder) instead of the repository's, which the nightly
		# profile adds.
		if [ Glob $(AIROS_CI_PACKAGES) : vision-*-x86_64.hpkg ] {
			SuppressHaikuImagePackages vision ;
		}
	}
	case airos-arm64 : {
		AIROS_ROCK5 = 1 ;
		HAIKU_IMAGE_SIZE = $(AIROS_CI_IMAGE_SIZE:E=3072) ;
	}
	case airos-rpi4 : {
		AIROS_RPI4 = 1 ;
		HAIKU_IMAGE_SIZE = $(AIROS_CI_IMAGE_SIZE:E=3584) ;
		HAIKU_BFS_GROWABLE = 1 ;
		HAIKU_RPI_IMAGE_NAME = airos-rpi4.img ;
		# This image only runs on the Pi 4: all code is tuned for its
		# Cortex-A72, with inline atomics (docs/rpi4/CPU-TUNING.md). The Pi
		# builds in a build directory of its own; objects keep the flags
		# they were compiled with, so a changed profile needs a clean build.
		SetCPUProfile arm64 : rpi4 ;
	}
	case airos-cubie : {
		AIROS_CUBIE = 1 ;
		HAIKU_IMAGE_SIZE = $(AIROS_CI_IMAGE_SIZE:E=3584) ;
		HAIKU_BFS_GROWABLE = 1 ;
	}
}

# arm64: the bootstrap repository's packages CI has builds of in
# AIROS_CI_PACKAGES stay out of the image (icu74 and ncurses6, which link
# libgcc_s rather than a private copy of the unwinder; a C++ exception that
# passed through the bootstrap ones ended the program). CI's own go in as
# packages (AIROS_CI_BASE_PACKAGES, UserBuildConfigRulePreImage), and so does
# zstd, which haiku requires with the zstd build feature: dependency
# resolution sees those, not the files of AIROS_CI_PACKAGES.
if $(AIROS_ROCK5) || $(AIROS_RPI4) || $(AIROS_CUBIE) {
	local package ;
	for package in [ Glob $(AIROS_CI_PACKAGES) : *.hpkg ] {
		local name = [ Match "^([^-]+)-" : $(package:BS) ] ;
		if [ IsPackageAvailable $(name) ] {
			SuppressHaikuImagePackages $(name) ;
			AIROS_CI_BASE_PACKAGES += $(package:BS) ;
		} else if $(name) = zstd || $(name) = airos_openssl {
			# haiku requires these with the zstd and (arm64) openssl build
			# features
			AIROS_CI_BASE_PACKAGES += $(package:BS) ;
		}
	}
}

# The ROCK 5 ITX's drivers and Bluetooth tools (bt_le, the AX210 loader).
if $(AIROS_ROCK5) {
	DeferredSubInclude HAIKU_TOP tools rock5-itx ;
}

# AirosCIFiles <image directory> : <source directory> : <grist> : <pattern>
#	: [ <names to leave out> ]
rule AirosCIFiles directoryTokens : sourceDir : grist : pattern : exclude
{
	if ! $(sourceDir) {
		return ;
	}
	local files = [ Glob $(sourceDir) : $(pattern) ] ;
	# The glob of * also returns . and ..
	files = [ FFilter $(files:BS) : . .. $(exclude) ] ;
	if ! $(files) {
		return ;
	}
	files = <$(grist)>$(files) ;
	SEARCH on $(files) = $(sourceDir) ;
	AddFilesToHaikuImage $(directoryTokens) : $(files) ;
}

# AirosCIPackageFiles <package> : <directory> : <source directory> : <grist>
#	: [ <Deskbar folder> ]
# Adds every file of the source directory to the package's directory, each
# linked from that folder of Deskbar's menu when one is given.
rule AirosCIPackageFiles package : directoryTokens : sourceDir : grist : folder
{
	if ! $(sourceDir) {
		return ;
	}
	local files = [ Glob $(sourceDir) : * ] ;
	files = [ FFilter $(files:BS) : . .. ] ;
	local file ;
	for file in $(files) {
		local target = $(file:G=$(grist)) ;
		SEARCH on $(target) = $(sourceDir) ;
		AddFilesToContainer $(package) : $(directoryTokens) : $(target) ;
		if $(folder) {
			AddSymlinkToContainer $(package) : data deskbar menu $(folder)
				: ../../../../$(directoryTokens:J=/)/$(file) : $(file) ;
		}
	}
}

# AirosCIFile <image directory> : <source file> : <name>
# AirosCISymlink <image directory> : <link target> : <name>
# One file of CI's trees, as AIROS_CI_FILES lists them.
rule AirosCIFile directoryTokens : source : name
{
	local file = $(name:G=airos-ci-file!$(directoryTokens:J=!)) ;
	SEARCH on $(file) = $(source:D) ;
	AddFilesToHaikuImage $(directoryTokens) : $(file) ;
}

rule AirosCISymlink directoryTokens : linkTarget : name
{
	AddSymlinkToHaikuImage $(directoryTokens) : $(linkTarget) : $(name) ;
}


# AirosRemoveImageFile <image directory> : <name>
# Leaves a file the image definitions added out of the image.
rule AirosRemoveImageFile directoryTokens : name
{
	local grist = [ on $(HAIKU_IMAGE_CONTAINER_NAME)
		return $(HAIKU_CONTAINER_GRIST) ] ;
	local directory = [ FDirName $(directoryTokens) ] ;
	directory = $(directory:G=$(grist)) ;
	local kept ;
	local destTarget ;
	for destTarget in [ on $(directory) return $(TARGETS_TO_INSTALL) ] {
		if $(destTarget:G=) != $(name) {
			kept += $(destTarget) ;
		}
	}
	TARGETS_TO_INSTALL on $(directory) = $(kept) ;
}


# AirosMoveToPayload <package>
# Moves every file the image would install in system/non-packaged into the
# payload package, under data/airos/non-packaged, and links to it from the
# image (System Updater, docs/airos/SYSTEM-UPDATER.md). Symlinks stay as they
# are and go into the package too.
rule AirosMoveToPayload package
{
	local image = $(HAIKU_IMAGE_CONTAINER_NAME) ;
	local root = /boot/system/data/airos/non-packaged ;
	local directory ;
	for directory in [ on $(image) return $(HAIKU_INSTALL_DIRECTORIES) ] {
		local tokens = [ on $(directory) return $(DIRECTORY_TOKENS) ] ;
		if $(tokens[1]) != system || $(tokens[2]) != non-packaged {
			continue ;
		}
		if [ on $(directory) return $(DIRECTORIES_TO_INSTALL) ] {
			Exit "AirosMoveToPayload: a directory copied into"
				[ FDirName $(tokens) ] "- name its files (AIROS_CI_FILES)" ;
		}

		local relative = $(tokens[3-]) ;
		local prefix = $(root) ;
		if $(relative) {
			prefix = $(root)/$(relative:J=/) ;
		}

		local links = [ on $(directory) return $(SYMLINKS_TO_INSTALL) ] ;
		local link ;
		for link in $(links) {
			AddSymlinkToContainer $(package) : data airos non-packaged
				$(relative) : [ on $(link) return $(SYMLINK_TARGET) ]
				: $(link:G=:D=) ;
		}

		local destTarget ;
		for destTarget in [ on $(directory) return $(TARGETS_TO_INSTALL) ] {
			local target = [ on $(destTarget) return $(TARGET) ] ;
			local name = $(destTarget:G=) ;
			AddFilesToContainer $(package) : data airos non-packaged $(relative)
				: $(target) : $(name) ;
			AddSymlinkToContainer $(image) : $(tokens) : $(prefix)/$(name)
				: $(name) ;
		}
		TARGETS_TO_INSTALL on $(directory) = ;
	}
}


rule UserBuildConfigRulePreImage
{
	# The build calls this before the image and again before the CD
	# (build/jam/images/HaikuCD), with the same container: add everything
	# once. Moving files into the payload twice would also put the image's
	# links over the payload's files.
	if $(AIROS_CI_PRE_IMAGE_DONE) {
		return ;
	}
	AIROS_CI_PRE_IMAGE_DONE = 1 ;

	local tree = [ FDirName $(HAIKU_TOP) tools airos ci ] ;

	# Everything CI built for this image; (arm64) its builds of repository
	# packages and zstd as packages (above), the rest as files.
	if $(AIROS_CI_BASE_PACKAGES) {
		local basePackages = <airos-ci-base>$(AIROS_CI_BASE_PACKAGES) ;
		SEARCH on $(basePackages) = $(AIROS_CI_PACKAGES) ;
		AddPackageFilesToHaikuImage system packages : $(basePackages) ;
	}
	AirosCIFiles system packages : $(AIROS_CI_PACKAGES) : airos-ci-pkg : *.hpkg
		: $(AIROS_CI_BASE_PACKAGES) ;
	if $(AIROS_CI_FILES) {
		include $(AIROS_CI_FILES) ;
	} else {
		AirosCIFiles system non-packaged lib : $(AIROS_CI_LIBS) : airos-ci-lib : *.so* ;
		AirosCIFiles system non-packaged add-ons opengl egl_vendor.d : $(AIROS_CI_EGL)
			: airos-ci-egl : *.json ;
		AirosCIFiles system non-packaged demos : $(AIROS_CI_DEMOS) : airos-ci-demo : * ;
		# Add-ons outside packages (x86_64: nvidia_rm, its accelerant, NVDEC), so
		# the boot menu's "Disable user add-ons" turns them off.
		if $(AIROS_CI_ADDONS) {
			CopyDirectoryToHaikuImage system non-packaged : $(AIROS_CI_ADDONS)
				: add-ons ;
		}
		if $(AIROS_CI_FIRMWARE) {
			CopyDirectoryToHaikuImage system non-packaged data : $(AIROS_CI_FIRMWARE)
				: firmware ;
		}
		# x86_64: libdrm, libva, libglvnd and Mesa (radeonsi, RADV, VA-API) and the
		# amduvd decoder for amdgpu_drm, kept apart: the boot script links them
		# into place only where amdgpu_drm drives a GPU.
		if $(AIROS_CI_AMDGPU) {
			CopyDirectoryToHaikuImage system non-packaged : $(AIROS_CI_AMDGPU)
				: amdgpu ;
		}
		# arm64: the same for the Dragon Q8B's Adreno, beside the ROCK 5's
		# Panfrost stack, which every other machine keeps.
		if $(AIROS_CI_ADRENO) {
			CopyDirectoryToHaikuImage system non-packaged : $(AIROS_CI_ADRENO)
				: adreno ;
		}
	}

	# Join remembered Wi-Fi networks at start (x86_64 and ROCK 5; the Pi and
	# the Cubie have their own scripts that also set the clock).
	if $(AIROS_X86_64) || $(AIROS_ROCK5) {
		local bootscript = <airos-ci>UserBootscript ;
		SEARCH on $(bootscript) = [ FDirName $(tree) boot ] ;
		AddFilesToHaikuImage home config settings boot : $(bootscript) ;
	}

	if $(AIROS_ROCK5) || $(AIROS_RPI4) || $(AIROS_CUBIE) {
		# CI stages this architecture-neutral package with zlib, since the
		# arm64 release package readers may not support the repository's zstd.
		if ! [ Glob $(AIROS_CI_PACKAGES) : ca_root_certificates-*-any.hpkg ] {
			Exit "The arm64 image requires the ca_root_certificates package." ;
		}
		# The system fonts: the arm64 repository's bootstrap noto has no Noto
		# Sans Mono, app_server's default fixed font, which then falls back to
		# a proportional serif. Added as system packages (not files), they
		# satisfy the haiku package's noto requirement when jam resolves the
		# image's dependencies, so the bootstrap noto stays out.
		local fonts = [ Glob $(AIROS_CI_FONTS) : noto-*-any.hpkg
			noto_sans_cjk_jp-*-any.hpkg ] ;
		if ! $(fonts[2]) {
			Exit "The arm64 image requires the noto and noto_sans_cjk_jp"
				"packages (AIROS_CI_FONTS)." ;
		}
		fonts = <airos-ci-font>$(fonts:BS) ;
		SEARCH on $(fonts) = $(AIROS_CI_FONTS) ;
		AddPackageFilesToHaikuImage system packages : $(fonts) ;
		# Fontconfig's system configuration, which x86_64 gets from the
		# fontconfig package: Summit includes it in the configuration it
		# generates.
		local fontconfig = <airos-ci-fontconfig>fonts.conf ;
		SEARCH on $(fontconfig) = [ FDirName $(tree) fonts ] ;
		AddFilesToHaikuImage system settings fonts : $(fontconfig) ;
		# FreeType 2.14.3 rather than the repository's bootstrap 2.6.3; the
		# build system does the rest when the packages are named.
		if ! [ Glob $(HAIKU_ARM64_FREETYPE_PACKAGES_DIR)
				: freetype-*-arm64.hpkg ] {
			Exit "The arm64 image requires air/OS's freetype packages"
				"(HAIKU_ARM64_FREETYPE_PACKAGES_DIR)." ;
		}
		# libpng, which the arm64 repository does not have: BuildFeatures
		# builds the PNG translator with libpng16_devel, and the translator and
		# FreeType need libpng16 in the image.
		local libpng = [ Glob $(HAIKU_ARM64_LIBPNG_PACKAGES_DIR)
			: libpng16-*-arm64.hpkg ] ;
		if ! $(libpng) {
			Exit "The arm64 image requires air/OS's libpng16 packages"
				"(HAIKU_ARM64_LIBPNG_PACKAGES_DIR)." ;
		}
		libpng = <airos-ci-libpng>$(libpng:BS) ;
		SEARCH on $(libpng) = $(HAIKU_ARM64_LIBPNG_PACKAGES_DIR) ;
		AddPackageFilesToHaikuImage system packages : $(libpng) ;
		# Keep the legacy arm64 engine's CA path pointing at the packaged
		# trust store used by curl and current engines.
		AddSymlinkToHaikuImage system non-packaged data ssl
			: /boot/system/data/ssl/CARootCertificates.pem
			: CARootCertificates.pem ;
		# The arm64 ICU bootstrap package's data directory.
		local environment = <airos-ci>UserSetupEnvironment ;
		SEARCH on $(environment) = [ FDirName $(HAIKU_TOP) tools rock5-itx ] ;
		AddFilesToHaikuImage home config settings boot : $(environment) ;
	}

	if $(AIROS_ROCK5) {
		local rock5 = [ FDirName $(HAIKU_TOP) tools rock5-itx ] ;
		# Driver settings: PCIe, the GIC ITS, the VPU, and the firmware
		# profiles that admit the eMMC, display and GPU drivers.
		local settings = <airos-rock5>rk3588_pcie <airos-rock5>gicv3_its
			<airos-rock5>rk3588_vpu ;
		SEARCH on $(settings) = $(rock5) ;
		AddFilesToHaikuImage home config settings kernel drivers : $(settings) ;
		local profiles = <airos-rock5>sdhci <airos-rock5>rk3588_display
			<airos-rock5>mali_csf ;
		SEARCH on $(profiles) = [ FDirName $(rock5) image-settings ] ;
		AddFilesToHaikuImage home config settings kernel drivers : $(profiles) ;

		AddDriversToHaikuImage net : ipro1000 rtl8125 ;
		AddNewDriversToHaikuImage graphics : mali_csf rk3588_display ;
		AddNewDriversToHaikuImage video : rk3588_vpu ;
		AddNewDriversToHaikuImage audio hmulti : rk3588_audio ;
		AddFilesToHaikuImage system non-packaged add-ons accelerants
			: rk3588_display.accelerant ;
		# The Dragon Q8B's GPU (only where the device tree has an Adreno 690).
		AddDriversToHaikuImage graphics : adreno ;
		# The Bluetooth LE command line tool.
		AddFilesToHaikuImage system non-packaged bin : bt_le ;
	}

	if $(AIROS_RPI4) {
		if ! [ Glob $(AIROS_CI_PACKAGES) : rpi_installer-*.hpkg ] {
			Exit "The Pi image requires the rpi_installer package." ;
		}
		local rpi = [ FDirName $(HAIKU_TOP) data boot rpi ] ;
		# Package entries the Pi must not see (the ROCK 5's MPP decoder).
		local packageSettings = <airos-rpi4>packages ;
		SEARCH on $(packageSettings) = $(rpi) ;
		AddFilesToHaikuImage system settings : $(packageSettings) ;
		local localeSettings = "<airos-rpi4>Locale settings"
			<airos-rpi4>RTC_time_settings ;
		SEARCH on $(localeSettings) = $(rpi) ;
		AddFilesToHaikuImage home config settings : $(localeSettings) ;
		local bootscript = <airos-rpi4>UserBootscript
			<airos-rpi4>rpi-time-sync ;
		SEARCH on $(bootscript) = $(rpi) ;
		AddFilesToHaikuImage home config settings boot : $(bootscript) ;
	}

	if $(AIROS_CUBIE) {
		# The first-boot setup (SD card size, time zone), which the boot
		# script starts.
		if ! [ Glob $(AIROS_CI_PACKAGES) : rpi_installer-*.hpkg ] {
			Exit "The Cubie image requires the rpi_installer package." ;
		}
		local rpi = [ FDirName $(HAIKU_TOP) data boot rpi ] ;
		# Package entries the Cubie must not see either (the ROCK 5's MPP
		# decoder), and an installed system's locale: straight to the desktop.
		local packageSettings = <airos-cubie>packages ;
		SEARCH on $(packageSettings) = $(rpi) ;
		AddFilesToHaikuImage system settings : $(packageSettings) ;
		local localeSettings = "<airos-cubie>Locale settings"
			<airos-cubie>RTC_time_settings ;
		SEARCH on $(localeSettings) = $(rpi) ;
		AddFilesToHaikuImage home config settings : $(localeSettings) ;
		# NTP (the board has no battery-backed clock) and Wi-Fi autojoin
		local bootscript = <airos-cubie>UserBootscript ;
		SEARCH on $(bootscript) = [ FDirName $(HAIKU_TOP) data boot cubie-a7s ] ;
		local timeSync = <airos-cubie>rpi-time-sync ;
		SEARCH on $(timeSync) = $(rpi) ;
		AddFilesToHaikuImage home config settings boot : $(bootscript)
			$(timeSync) ;
		# The GPU: the image has its firmware (AIROS_CI_FIRMWARE), which the
		# powervr driver only starts when its settings say so; without them
		# OpenGL, Summit's too, runs in software.
		local gpuSettings = <airos-cubie>powervr ;
		SEARCH on $(gpuSettings)
			= [ FDirName $(HAIKU_TOP) tools cubie-a7s settings ] ;
		AddFilesToHaikuImage home config settings kernel drivers
			: $(gpuSettings) ;
		# The AIC8800D80 Wi-Fi/Bluetooth module: its driver loads the
		# firmware the image has (AIROS_CI_FIRMWARE), and Bluetooth comes
		# up with it. tools/cubie-a7s/UserBuildConfig added it for the lab
		# images; CI's images had the firmware but no driver.
		AddDriversToHaikuImage net : aic8800wifi ;
	}

	# A release image: its identity, and its files outside packages in a
	# package of their own (see the top of this file).
	if ! $(AIROS_CI_RELEASE_VERSION)
		&& ( $(AIROS_CI_SYSTEM_DEMOS) || $(AIROS_CI_SYSTEM_APPS) ) {
		Exit "AIROS_CI_SYSTEM_DEMOS and AIROS_CI_SYSTEM_APPS need a release"
			"image (AIROS_CI_RELEASE_VERSION)" ;
	}
	if $(AIROS_CI_RELEASE_VERSION) {
		if ! $(AIROS_CI_RELEASE_DIR) {
			Exit "AIROS_CI_RELEASE_VERSION needs AIROS_CI_RELEASE_DIR" ;
		}
		SEARCH on <package-info-source>airos_release
			<package-info-source>airos_payload = $(AIROS_CI_RELEASE_DIR) ;

		local payload = airos_payload.hpkg ;
		HaikuPackage $(payload) ;
		AirosMoveToPayload $(payload) ;
		# CI's GL demo and application where the haiku package has them on
		# x86_64 (packagefs merges them into system/demos and system/apps),
		# so they come with each release like the rest of the system.
		AirosCIPackageFiles $(payload) : demos : $(AIROS_CI_SYSTEM_DEMOS)
			: airos-ci-system-demo : Demos ;
		AirosCIPackageFiles $(payload) : apps : $(AIROS_CI_SYSTEM_APPS)
			: airos-ci-system-app ;
		BuildHaikuPackage $(payload) : airos_payload ;

		local release = airos_release.hpkg ;
		HaikuPackage $(release) ;
		local releaseFile = <airos-release>release ;
		SEARCH on $(releaseFile) = $(AIROS_CI_RELEASE_DIR) ;
		AddFilesToPackage data airos : $(releaseFile) ;
		BuildHaikuPackage $(release) : airos_release ;

		AddPackageFilesToHaikuImage system packages : $(payload) $(release)
			: nameFromMetaInfo ;

		# System Updater installs the system packages. Haiku's own
		# repository would offer upstream Haiku's in their place (its haiku
		# package has the higher revision) to SoftwareUpdater and pkgman;
		# HaikuPorts stays for HaikuDepot.
		AirosRemoveImageFile system settings package-repositories : Haiku ;
		AirosRemoveImageFile system cache package-repositories : Haiku ;
	}

}
