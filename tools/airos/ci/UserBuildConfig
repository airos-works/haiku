# air/OS release images, built by the air/OS build server (jmgasper/airos-ci,
# images/build-image.sh) from this tree and from inputs CI builds itself (the
# owner's applications, Summit, the libraries and GL stack from the jmgasper
# forks, firmware) - never from a workstation's directories.
#
#   x86_64     jam -q @nightly-airos-x86_64               -> airos-x86_64.iso
#              hybrid ISO for a USB stick or a CD, EFI and BIOS (X399 and
#              other PCs); boots to the desktop and the Installer
#   arm64 EFI  jam -q @airos-arm64                        -> airos-arm64.iso
#              hybrid ISO with an EFI system partition (ROCK 5 ITX and other
#              arm64 machines with UEFI firmware)
#   Pi 4       jam -q @airos-rpi4 airos-rpi-image         -> airos-rpi4.img
#              SD card image (FAT boot partition + BFS) that boots directly
#   Cubie A7S  jam -q @airos-cubie                        -> haiku-airos-cubie.image
#              then tools/cubie-a7s/build-sd-image.sh haiku-airos-cubie.image
#              airos-cubie.img: SD card image (Radxa's boot chain, the air/OS
#              U-Boot, ESP, BFS); building that U-Boot needs an
#              aarch64-linux-gnu cross compiler (tools/cubie-a7s/u-boot)
#
# The build directory's UserBuildConfig sets these and then includes this file:
#   AIROS_CI_PACKAGES       directory of packages for system/packages: the
#                           applications, Summit and summit_webkit, the
#                           airos_* libraries, rock5_ffmpeg, firmware packages,
#                           and (x86_64) HaikuPorts packages the build system's
#                           repository list lacks, and qt6_base with air/OS's
#                           Haiku platform plugin
#   AIROS_CI_SYSTEM_PACKAGES
#                           (x86_64) names of packages from the build system's
#                           HaikuPorts list that CI's packages need (Qt's
#                           dependencies), installed with theirs
#   AIROS_CI_FONTS          (arm64) HaikuPorts' noto and noto_sans_cjk_jp
#                           packages, added as system packages in place of
#                           the arm64 repository's bootstrap noto
#   HAIKU_ARM64_FREETYPE_PACKAGES_DIR
#                           (arm64) air/OS's freetype and freetype_devel
#                           packages: build/jam/BuildFeatures compiles Haiku
#                           against them and the top Jamfile puts freetype in
#                           the image instead of the bootstrap FreeType 2.6.3
#   HAIKU_ARM64_LIBPNG_PACKAGES_DIR
#                           (arm64) air/OS's libpng16 and libpng16_devel: the
#                           libpng build feature (the PNG translator), and
#                           libpng16 in the image for it and for FreeType
#   HAIKU_MUPDF_PACKAGES_DIR
#                           HaikuPorts' mupdf and mupdf_devel for the
#                           architecture: the mupdf build feature (Quick
#                           Look's PDFPreview add-on); mupdf and jbig2dec go
#                           in the image through AIROS_CI_PACKAGES
#   AIROS_CI_LIBS           libraries for system/non-packaged/lib (GL stack)
#   AIROS_CI_EGL            EGL vendor files for .../add-ons/opengl/egl_vendor.d
#   AIROS_CI_DEMOS          demos for system/non-packaged/demos (GLTeapot)
#   AIROS_CI_ADDONS         an add-ons tree for system/non-packaged/add-ons
#   AIROS_CI_FLUIDLITE      (arm64) a prefix with FluidLite for the MIDI kit,
#                           read by build/jam/BuildFeatures
#   AIROS_CI_FIRMWARE       a tree copied to system/non-packaged/data/firmware
#   AIROS_CI_AMDGPU         (x86_64) the AMD GPU user land: a tree copied to
#                           system/non-packaged/amdgpu, which the boot script
#                           links into system/non-packaged where amdgpu_drm
#                           drives a GPU
#   AIROS_CI_ADRENO         (arm64) the Dragon Q8B's GPU user land: a tree
#                           copied to system/non-packaged/adreno (Turnip,
#                           zink's EGL vendor library, libvulkan.so.1, the
#                           GPU firmware), which the boot script links into
#                           system/non-packaged where the adreno driver
#                           publishes the GPU
#   AIROS_CI_IMAGE_SIZE     image size in MiB (optional)
#   HAIKU_RPI_FIRMWARE_DIR  (Pi) the Raspberry Pi boot firmware files
#
# Unlike the lab configurations (tools/rock5-itx, tools/rpi4) this adds no
# remote shell, password, keys, probes or diagnostics.

HAIKU_IMAGE_LABEL = airOS ;
HAIKU_IMAGE_HOST_NAME ?= airos ;

DefineBuildProfile nightly-airos-x86_64 : anyboot-image : "airos-x86_64.iso" ;
DefineBuildProfile airos-arm64 : anyboot-image : "airos-arm64.iso" ;
DefineBuildProfile airos-rpi4 : image : "haiku-airos-rpi4.image" ;
DefineBuildProfile airos-cubie : image : "haiku-airos-cubie.image" ;

AIROS_X86_64 = ;
AIROS_ROCK5 = ;
AIROS_RPI4 = ;
AIROS_CUBIE = ;
switch $(HAIKU_BUILD_PROFILE) {
	case nightly-airos-x86_64 : {
		AIROS_X86_64 = 1 ;
		HAIKU_IMAGE_SIZE = $(AIROS_CI_IMAGE_SIZE:E=3072) ;
		# What the x86_64 applications require that the HaikuPorts repository
		# list of the build system has (the rest arrive as package files):
		# Amp (curl, SQLite), Kiri (git, PCRE2), airTime
		# (FFmpeg 6), Burrow (OpenSSL 3) and Summit's TLS certificates.
		AddHaikuImageSystemPackages curl sqlite libpcre2 openssl3 ffmpeg6 git
			ca_root_certificates ;
		# and what CI's packages need that this list has: Qt's dependencies
		# (airos-ci deps/build-qt-airos.sh, images/build-image.sh)
		if $(AIROS_CI_SYSTEM_PACKAGES) {
			AddHaikuImageSystemPackages $(AIROS_CI_SYSTEM_PACKAGES) ;
		}
		# CI's Vision (HaikuPorts' build with its Deskbar entry in the menu's
		# Utilities folder) instead of the repository's, which the nightly
		# profile adds.
		if [ Glob $(AIROS_CI_PACKAGES) : vision-*-x86_64.hpkg ] {
			SuppressHaikuImagePackages vision ;
		}
	}
	case airos-arm64 : {
		AIROS_ROCK5 = 1 ;
		HAIKU_IMAGE_SIZE = $(AIROS_CI_IMAGE_SIZE:E=3072) ;
	}
	case airos-rpi4 : {
		AIROS_RPI4 = 1 ;
		HAIKU_IMAGE_SIZE = $(AIROS_CI_IMAGE_SIZE:E=3584) ;
		HAIKU_BFS_GROWABLE = 1 ;
		HAIKU_RPI_IMAGE_NAME = airos-rpi4.img ;
	}
	case airos-cubie : {
		AIROS_CUBIE = 1 ;
		HAIKU_IMAGE_SIZE = $(AIROS_CI_IMAGE_SIZE:E=3584) ;
		HAIKU_BFS_GROWABLE = 1 ;
	}
}

# The ROCK 5 ITX's drivers and Bluetooth tools (bt_le, the AX210 loader).
if $(AIROS_ROCK5) {
	DeferredSubInclude HAIKU_TOP tools rock5-itx ;
}

# AirosCIFiles <image directory> : <source directory> : <grist> : <pattern>
rule AirosCIFiles directoryTokens : sourceDir : grist : pattern
{
	if ! $(sourceDir) {
		return ;
	}
	local files = [ Glob $(sourceDir) : $(pattern) ] ;
	# The glob of * also returns . and ..
	files = [ FFilter $(files:BS) : . .. ] ;
	if ! $(files) {
		return ;
	}
	files = <$(grist)>$(files) ;
	SEARCH on $(files) = $(sourceDir) ;
	AddFilesToHaikuImage $(directoryTokens) : $(files) ;
}

rule UserBuildConfigRulePreImage
{
	local tree = [ FDirName $(HAIKU_TOP) tools airos ci ] ;

	# Everything CI built for this image.
	AirosCIFiles system packages : $(AIROS_CI_PACKAGES) : airos-ci-pkg : *.hpkg ;
	AirosCIFiles system non-packaged lib : $(AIROS_CI_LIBS) : airos-ci-lib : *.so* ;
	AirosCIFiles system non-packaged add-ons opengl egl_vendor.d : $(AIROS_CI_EGL)
		: airos-ci-egl : *.json ;
	AirosCIFiles system non-packaged demos : $(AIROS_CI_DEMOS) : airos-ci-demo : * ;
	# Add-ons outside packages (x86_64: nvidia_rm, its accelerant, NVDEC), so
	# the boot menu's "Disable user add-ons" turns them off.
	if $(AIROS_CI_ADDONS) {
		CopyDirectoryToHaikuImage system non-packaged : $(AIROS_CI_ADDONS)
			: add-ons ;
	}
	if $(AIROS_CI_FIRMWARE) {
		CopyDirectoryToHaikuImage system non-packaged data : $(AIROS_CI_FIRMWARE)
			: firmware ;
	}
	# x86_64: libdrm, libva, libglvnd and Mesa (radeonsi, RADV, VA-API) and the
	# amduvd decoder for amdgpu_drm, kept apart: the boot script links them
	# into place only where amdgpu_drm drives a GPU.
	if $(AIROS_CI_AMDGPU) {
		CopyDirectoryToHaikuImage system non-packaged : $(AIROS_CI_AMDGPU)
			: amdgpu ;
	}
	# arm64: the same for the Dragon Q8B's Adreno, beside the ROCK 5's
	# Panfrost stack, which every other machine keeps.
	if $(AIROS_CI_ADRENO) {
		CopyDirectoryToHaikuImage system non-packaged : $(AIROS_CI_ADRENO)
			: adreno ;
	}

	# Join remembered Wi-Fi networks at start (x86_64 and ROCK 5; the Pi and
	# the Cubie have their own scripts that also set the clock).
	if $(AIROS_X86_64) || $(AIROS_ROCK5) {
		local bootscript = <airos-ci>UserBootscript ;
		SEARCH on $(bootscript) = [ FDirName $(tree) boot ] ;
		AddFilesToHaikuImage home config settings boot : $(bootscript) ;
	}

	if $(AIROS_ROCK5) || $(AIROS_RPI4) || $(AIROS_CUBIE) {
		# CI stages this architecture-neutral package with zlib, since the
		# arm64 release package readers may not support the repository's zstd.
		if ! [ Glob $(AIROS_CI_PACKAGES) : ca_root_certificates-*-any.hpkg ] {
			Exit "The arm64 image requires the ca_root_certificates package." ;
		}
		# The system fonts: the arm64 repository's bootstrap noto has no Noto
		# Sans Mono, app_server's default fixed font, which then falls back to
		# a proportional serif. Added as system packages (not files), they
		# satisfy the haiku package's noto requirement when jam resolves the
		# image's dependencies, so the bootstrap noto stays out.
		local fonts = [ Glob $(AIROS_CI_FONTS) : noto-*-any.hpkg
			noto_sans_cjk_jp-*-any.hpkg ] ;
		if ! $(fonts[2]) {
			Exit "The arm64 image requires the noto and noto_sans_cjk_jp"
				"packages (AIROS_CI_FONTS)." ;
		}
		fonts = <airos-ci-font>$(fonts:BS) ;
		SEARCH on $(fonts) = $(AIROS_CI_FONTS) ;
		AddPackageFilesToHaikuImage system packages : $(fonts) ;
		# FreeType 2.14.3 rather than the repository's bootstrap 2.6.3; the
		# build system does the rest when the packages are named.
		if ! [ Glob $(HAIKU_ARM64_FREETYPE_PACKAGES_DIR)
				: freetype-*-arm64.hpkg ] {
			Exit "The arm64 image requires air/OS's freetype packages"
				"(HAIKU_ARM64_FREETYPE_PACKAGES_DIR)." ;
		}
		# libpng, which the arm64 repository does not have: BuildFeatures
		# builds the PNG translator with libpng16_devel, and the translator and
		# FreeType need libpng16 in the image.
		local libpng = [ Glob $(HAIKU_ARM64_LIBPNG_PACKAGES_DIR)
			: libpng16-*-arm64.hpkg ] ;
		if ! $(libpng) {
			Exit "The arm64 image requires air/OS's libpng16 packages"
				"(HAIKU_ARM64_LIBPNG_PACKAGES_DIR)." ;
		}
		libpng = <airos-ci-libpng>$(libpng:BS) ;
		SEARCH on $(libpng) = $(HAIKU_ARM64_LIBPNG_PACKAGES_DIR) ;
		AddPackageFilesToHaikuImage system packages : $(libpng) ;
		# Keep the legacy arm64 engine's CA path pointing at the packaged
		# trust store used by curl and current engines.
		AddSymlinkToHaikuImage system non-packaged data ssl
			: /boot/system/data/ssl/CARootCertificates.pem
			: CARootCertificates.pem ;
		# The arm64 ICU bootstrap package's data directory.
		local environment = <airos-ci>UserSetupEnvironment ;
		SEARCH on $(environment) = [ FDirName $(HAIKU_TOP) tools rock5-itx ] ;
		AddFilesToHaikuImage home config settings boot : $(environment) ;
	}

	if $(AIROS_ROCK5) {
		local rock5 = [ FDirName $(HAIKU_TOP) tools rock5-itx ] ;
		# Driver settings: PCIe, the GIC ITS, the VPU, and the firmware
		# profiles that admit the eMMC, display and GPU drivers.
		local settings = <airos-rock5>rk3588_pcie <airos-rock5>gicv3_its
			<airos-rock5>rk3588_vpu ;
		SEARCH on $(settings) = $(rock5) ;
		AddFilesToHaikuImage home config settings kernel drivers : $(settings) ;
		local profiles = <airos-rock5>sdhci <airos-rock5>rk3588_display
			<airos-rock5>mali_csf ;
		SEARCH on $(profiles) = [ FDirName $(rock5) image-settings ] ;
		AddFilesToHaikuImage home config settings kernel drivers : $(profiles) ;

		AddDriversToHaikuImage net : ipro1000 rtl8125 ;
		AddNewDriversToHaikuImage graphics : mali_csf rk3588_display ;
		AddNewDriversToHaikuImage video : rk3588_vpu ;
		AddNewDriversToHaikuImage audio hmulti : rk3588_audio ;
		AddFilesToHaikuImage system non-packaged add-ons accelerants
			: rk3588_display.accelerant ;
		# The Dragon Q8B's GPU (only where the device tree has an Adreno 690).
		AddDriversToHaikuImage graphics : adreno ;
		# The Bluetooth LE command line tool.
		AddFilesToHaikuImage system non-packaged bin : bt_le ;
	}

	if $(AIROS_RPI4) {
		if ! [ Glob $(AIROS_CI_PACKAGES) : rpi_installer-*.hpkg ] {
			Exit "The Pi image requires the rpi_installer package." ;
		}
		local rpi = [ FDirName $(HAIKU_TOP) data boot rpi ] ;
		# Package entries the Pi must not see (the ROCK 5's MPP decoder).
		local packageSettings = <airos-rpi4>packages ;
		SEARCH on $(packageSettings) = $(rpi) ;
		AddFilesToHaikuImage system settings : $(packageSettings) ;
		local localeSettings = "<airos-rpi4>Locale settings"
			<airos-rpi4>RTC_time_settings ;
		SEARCH on $(localeSettings) = $(rpi) ;
		AddFilesToHaikuImage home config settings : $(localeSettings) ;
		local bootscript = <airos-rpi4>UserBootscript
			<airos-rpi4>rpi-time-sync ;
		SEARCH on $(bootscript) = $(rpi) ;
		AddFilesToHaikuImage home config settings boot : $(bootscript) ;
	}

	if $(AIROS_CUBIE) {
		local rpi = [ FDirName $(HAIKU_TOP) data boot rpi ] ;
		# Package entries the Cubie must not see either (the ROCK 5's MPP
		# decoder), and an installed system's locale: straight to the desktop.
		local packageSettings = <airos-cubie>packages ;
		SEARCH on $(packageSettings) = $(rpi) ;
		AddFilesToHaikuImage system settings : $(packageSettings) ;
		local localeSettings = "<airos-cubie>Locale settings"
			<airos-cubie>RTC_time_settings ;
		SEARCH on $(localeSettings) = $(rpi) ;
		AddFilesToHaikuImage home config settings : $(localeSettings) ;
		# NTP (the board has no battery-backed clock) and Wi-Fi autojoin
		local bootscript = <airos-cubie>UserBootscript ;
		SEARCH on $(bootscript) = [ FDirName $(HAIKU_TOP) data boot cubie-a7s ] ;
		local timeSync = <airos-cubie>rpi-time-sync ;
		SEARCH on $(timeSync) = $(rpi) ;
		AddFilesToHaikuImage home config settings boot : $(bootscript)
			$(timeSync) ;
	}
}
