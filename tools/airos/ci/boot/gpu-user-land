#!/bin/sh
# air/OS: links the GPU user lands the image keeps apart into
# system/non-packaged where their driver publishes a GPU, and unlinks them
# elsewhere. The launch daemon runs it at every start (data/user_launch/
# airos-gpu-user-land). It comes with each release, in the payload, so an
# update brings its changes, which ~/config/settings/boot/UserBootscript, the
# user's own file, never got: an installation from before 2026-11-21 has the
# AMD-only version of this in there.

# A GPU user land kept apart in system/non-packaged/<name>, linked into
# system/non-packaged only where its driver publishes the GPU, and unlinked
# elsewhere. Files of the same name that are not such links (a user land
# installed by hand, or the system's own) are left alone.
#
# The links go through /system (the root's link to /boot/system): the
# UserBootscript of an older installation, which runs at the same time, has
# its own version of this, which leaves links to anything but
# /boot/system/non-packaged/<name> alone; its AMD-only version would remove
# the links on a machine whose GPU nouveau_drm drives. Its links (through
# /boot/system) count as this one's.
#   link_gpu_user_land <name> <whether the GPU is there: 0 = yes>
link_gpu_user_land()
{
	nonPackaged=/boot/system/non-packaged
	userLand=$nonPackaged/$1
	linkTo=/system/non-packaged/$1
	[ -d "$userLand" ] || return
	if [ "$2" = 0 ]; then
		(cd "$userLand" && find . \( -type f -o -type l \)) | while read -r file; do
			file=${file#./}
			target=$nonPackaged/$file
			if [ -e "$target" ] || [ -L "$target" ]; then
				case $(readlink "$target") in
					"$linkTo/$file") continue ;;
					"$userLand"/* | "$linkTo"/*) ;;
					*) continue ;;
				esac
			fi
			mkdir -p "$(dirname "$target")"
			ln -sfn "$linkTo/$file" "$target"
		done
	else
		find "$nonPackaged/lib" "$nonPackaged/data" "$nonPackaged/add-ons" \
				-type l 2> /dev/null | while read -r link; do
			case $(readlink "$link") in
				"$userLand"/* | "$linkTo"/*) rm -f "$link" ;;
			esac
		done
	fi
}

# The GPU user land of Linux's DRM drivers (x86_64): libdrm, libva, libglvnd
# and Mesa (radeonsi and RADV for amdgpu_drm, nouveau and NVK for nouveau_drm,
# the VA-API driver) and the amduvd decoder, where amdgpu_drm or nouveau_drm
# drives a GPU. Its libGL and libEGL come before the system's, which every
# other machine keeps (Zink on newer NVIDIA cards, llvmpipe elsewhere).
ls /dev/graphics/amdgpu_drm_* /dev/graphics/nouveau_drm_* 2> /dev/null \
	| grep -q .
link_gpu_user_land amdgpu $?

# The Dragon Q8B's (arm64): Turnip, libvulkan.so.1 and zink's EGL vendor
# library, whose vendor file sorts before the ROCK 5's Panfrost one, which
# every other machine keeps. On the Dragon the Panfrost vendor is set aside:
# libglvnd loads every vendor library, and with two Mesas in one team an
# application that makes a second BGLView after the first is gone (Snap)
# crashed in Mesa making the new context current.
[ -e /dev/graphics/adreno/0 ]
adreno=$?
link_gpu_user_land adreno $adreno
vendors=/boot/system/non-packaged/add-ons/opengl/egl_vendor.d
if [ $adreno = 0 ] && [ -e $vendors/10_mesa_panfrost.json ]; then
	mv -f $vendors/10_mesa_panfrost.json $vendors/10_mesa_panfrost.json.off
elif [ $adreno != 0 ] && [ -e $vendors/10_mesa_panfrost.json.off ]; then
	mv -f $vendors/10_mesa_panfrost.json.off $vendors/10_mesa_panfrost.json
fi

# The Zink OpenGL renderer (x86_64), only where nvidia_rm drives a card and NVK
# gives it a GPU: the GL kit takes the first renderer it finds, and anywhere
# else Mesa's llvmpipe is the faster one.
zink=/boot/system/non-packaged/add-ons/opengl-zink/Zink
if [ -e "$zink" ]; then
	opengl=/boot/system/non-packaged/add-ons/opengl
	if [ -e /dev/nvidiactl ]; then
		mkdir -p "$opengl" && ln -sf "$zink" "$opengl/Zink"
	else
		rm -f "$opengl/Zink"
	fi
fi
