	MCPServer.cpp
	App.cpp
	Json.cpp
	Mcp.cpp
	Process.cpp
	Transport.cpp
	Util.cpp
	DriverTools.cpp
	FileTools.cpp
	HealthTools.cpp
	InventoryTools.cpp
	PackageTools.cpp
	RunTools.cpp
	ScreenshotTools.cpp
	ScriptingTools.cpp
	SyslogTools.cpp
	TeamTools.cpp
	: be media network bnetapi [ BuildFeatureAttribute zlib : library ] [ TargetLibstdc++ ]
	: mcp_server.rdef
;

Depends mcp_server.rsrc : mcp.hvif ;
