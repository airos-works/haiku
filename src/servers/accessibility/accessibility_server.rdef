resource app_signature "application/x-vnd.Haiku-accessibility_server";

resource app_flags B_EXCLUSIVE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "accessibility_server",
	long_info = "accessibility_server ©2026 air/OS contributors"
};
