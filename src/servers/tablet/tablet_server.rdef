resource app_signature "application/x-vnd.airOS-tablet_server";

resource app_flags B_EXCLUSIVE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "tablet_server",
	long_info = "tablet_server ©2026 air/OS"
};
