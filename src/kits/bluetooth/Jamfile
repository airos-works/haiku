SubDir HAIKU_TOP src kits bluetooth ;

#if ! $(TARGET_PLATFORM_HAIKU_COMPATIBLE) {
#       UseHeaders [ FDirName $(HAIKU_TOP) headers os ] : true ;
#}

UsePrivateHeaders shared bluetooth ;
UsePrivateHeaders drivers ;
UsePrivateHeaders kernel ;
UseHeaders [ FDirName $(HAIKU_TOP) src add-ons kernel drivers input
	hid_shared ] [ FDirName $(HAIKU_TOP) src bin hid_decode ]
	[ FDirName $(HAIKU_TOP) headers private kernel ] ;
SubDirC++Flags -DUSERLAND_HID ;

SubDirHdrs [ FDirName $(SUBDIR) UI ] ;

local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup ] {
	on $(architectureObject) {

		SEARCH_SOURCE += [ FDirName $(SUBDIR) UI ] ;
		SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src libs compat openbsd_wlan crypto ] ;
		SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src add-ons kernel drivers
			input hid_shared ] ;

		SharedLibrary [ MultiArchDefaultGristFiles libbluetooth.so ] :
			LocalDevice.cpp
			A2dpSource.cpp
			AudioSinkSetting.cpp
			SbcEncoder.cpp
			DiscoveryListener.cpp
			DiscoveryAgent.cpp
			RemoteDevice.cpp
			CommandManager.cpp
			KitSupport.cpp
			LEAttributeClient.cpp
			LEHIDService.cpp
			LEHIDMouseDecoder.cpp
			HIDCollection.cpp
			HIDParser.cpp
			HIDReport.cpp
			HIDReportItem.cpp
			LELegacyPairingCrypto.cpp
			LELegacyPairingClient.cpp
			LEBondStore.cpp
			LEPairingSession.cpp
			LELog.cpp
			LEDeviceStatus.cpp
			aes.c
			DeviceClass.cpp
			#UI
			PincodeWindow.cpp
			ConnectionIncoming.cpp
			ConnectionView.cpp
			BluetoothIconView.cpp
			:
			be network localestub [ TargetLibstdc++ ]
		;
	}
}

DoCatalogs libbluetooth.so :
	x-vnd.Haiku-Bluetooth
	:
	DeviceClass.cpp
	RemoteDevice.cpp
;
