SubDir HAIKU_TOP src kits neural ;

UsePrivateHeaders neural shared storage ;

# The kernels are loops over numbers; they are written for the
# vectorizer, which -O2 holds back.
SubDirC++Flags -O3 ;

local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup ] {
	on $(architectureObject) {
		SEARCH_SOURCE += [ FDirName $(SUBDIR) ops ] ;

		SharedLibrary [ MultiArchDefaultGristFiles libneural.so ] :
			GraphData.cpp
			Interpreter.cpp
			NeuralModel.cpp
			NeuralRoster.cpp
			NeuralSession.cpp
			NeuralUtils.cpp
			Tensor.cpp
			TFLiteLoader.cpp

			# speech recognition: the core, which the host tests build
			# too, and the class applications use
			SpeechAudio.cpp
			SpeechEngine.cpp
			SpeechModel.cpp
			SpeechWhisper.cpp
			SpeechRecognizer.cpp

			# ops: the CPU kernels, one file per family of operators
			Activation.cpp
			Arithmetic.cpp
			Convolution.cpp
			Detection.cpp
			Gather.cpp
			Kernels.cpp
			MatMul.cpp
			Pooling.cpp
			Quantize.cpp
			Reduce.cpp
			Resize.cpp
			Shape.cpp
			:
			be [ TargetLibstdc++ ]
			;
	}
}
