name			nvm
version			0.40.8-2
architecture	any
summary			"Node Version Manager, with Haiku support"
description		"nvm installs and switches between Node.js versions per user \
(in $NVM_DIR, default ~/.nvm). This build knows Haiku: it installs Haiku \
binaries of Node.js 10 to 26 from air/OS's mirror (or $NVM_HAIKU_MIRROR) \
and builds other releases from source with the Haiku port it ships. Login \
shells get the nvm command through data/profile.d/nvm.sh."

packager		"The Haiku build system"
vendor			"Haiku Project"

copyrights		"2010 Tim Caswell and Jordan Harband"
licenses		MIT

urls			"https://github.com/nvm-sh/nvm"

provides {
	nvm = 0.40.8
}

requires {
	haiku
	cmd:bash
	cmd:curl
	cmd:sha256sum
	cmd:tar
	cmd:xz
}
