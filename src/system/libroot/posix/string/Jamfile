SubDir HAIKU_TOP src system libroot posix string ;

UsePrivateHeaders
	[ FDirName libroot ]
	[ FDirName libroot locale ]
	;


# Our versions of strdup and strndup check for NULL parameters (for BeOS
# compatibility), but GCC optimizes this away as its builtins don't handle
# it.
C++FLAGS += -fno-builtin-strdup -fno-builtin-strndup ;

local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup ] {
	on $(architectureObject) {
		local architecture = $(TARGET_PACKAGING_ARCH) ;

		# The architecture string object (arch/*/Jamfile) supplies these;
		# keep the list in sync with the runtime_loader's Jamfile.
		local archSources ;
		if $(architecture) = arm64 || $(architecture) = x86_64 {
			archSources = memcmp.c strcmp.c strncmp.c strrchr.c ;
		}

		MergeObject <$(architecture)>posix_string.o : [ FFilter
			bcmp.c
			bcopy.c
			bzero.c
			memcmp.c
			strcasecmp.c
			strcasestr.c
			strcmp.c
			strcoll.cpp
			strdup.cpp
			strerror.c
			strlwr.c
			strncmp.c
			strncpy.cpp
			strndup.cpp
			strrchr.c
			strtok.c
			strupr.c
			strxfrm.cpp
			: $(archSources) ] ;
		# The members depend on the list above: merge again when it changes,
		# or an incremental build keeps the ones left out.
		local jamfile = [ FGristFiles Jamfile ] ;
		SEARCH on $(jamfile) = $(SUBDIR) ;
		Depends <$(architecture)>posix_string.o : $(jamfile) ;
	}
}

local arch ;
for arch in $(TARGET_ARCHS) {
	HaikuSubInclude arch $(arch) ;
}
