SubDir HAIKU_TOP src system libroot posix string arch arm64 ;

# Optimizations create infinite recursion otherwise.
SubDirCcFlags -fno-builtin -mgeneral-regs-only ;

local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup arm64 ] {
	on $(architectureObject) {
		local architecture = $(TARGET_PACKAGING_ARCH) ;

		UsePrivateSystemHeaders ;

		SEARCH_SOURCE += [ FDirName $(SUBDIR) $(DOTDOT) generic ] ;

		# The generic C versions of these are left out in
		# posix/string/Jamfile, posix/musl/string/Jamfile and the
		# runtime_loader's Jamfile.
		MergeObject <$(architecture)>posix_string_arch_$(TARGET_ARCH).o :
			arm64_memchr.S
			arm64_memcmp.S
			arm64_memcpy.S
			arm64_memrchr.S
			arm64_memset.S
			arm64_stpcpy.S
			arm64_strchr.S
			arm64_strchrnul.S
			arm64_strcmp.S
			arm64_strcpy.S
			arm64_strlen.S
			arm64_strncmp.S
			arm64_strnlen.S
			arm64_strrchr.S
			;
	}
}
