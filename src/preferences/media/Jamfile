SubDir HAIKU_TOP src preferences media ;

# libmidi.so is only built when the fluidlite softsynth package is
# available (src/kits/midi/Jamfile), and this target links it.
if ! [ FIsBuildFeatureEnabled fluidlite ] {
	return ;
}

UsePrivateHeaders media midi shared ;

Application Media :
	Cards.cpp
	Glyphs.cpp
	LiveViews.cpp
	Media.cpp
	MediaModel.cpp
	MediaWindow.cpp
	Pages.cpp
	ParameterForm.cpp
	Sidebar.cpp
	: media midi be localestub [ TargetLibsupc++ ] [ TargetLibstdc++ ]
	: media.rdef
	;

DoCatalogs Media
	: x-vnd.Haiku-Media
	: LiveViews.cpp
	  MediaModel.cpp
	  MediaWindow.cpp
	  Pages.cpp
	  ParameterForm.cpp
;
