SubDir HAIKU_TOP src apps mediaconverter ;

# MediaConverter: the air/OS converter. The engine (engine/) is FFmpeg for
# reading, decoding, filtering and writing, with the encoders of
# VideoEncoder: the GPUs' through VA-API (AMD) and NVENC (NVIDIA), and on the
# CPU x264, x265 and SVT-AV1 (opened at run time) and FFmpeg's own.

UsePrivateHeaders interface shared media ;
UsePrivateSystemHeaders ;
SubDirHdrs [ FDirName $(SUBDIR) engine ] ;
SubDirSysHdrs [ FDirName $(SUBDIR) thirdparty ] ;
SubDirHdrs [ FDirName $(SUBDIR) app ] ;
SubDirC++Flags -D__STDC_CONSTANT_MACROS ;

SEARCH_SOURCE += [ FDirName $(SUBDIR) engine ] ;
SEARCH_SOURCE += [ FDirName $(SUBDIR) app ] ;
SEARCH_SOURCE += [ FDirName $(SUBDIR) app airtime ] ;
SEARCH_SOURCE += [ FDirName $(SUBDIR) cli ] ;

local engineSources =
	BitWriter.cpp
	DiscSource.cpp
	Formats.cpp
	HardwareCaps.cpp
	LavcVideoEncoder.cpp
	MediaProbe.cpp
	NvencEncoder.cpp
	OutputSettings.cpp
	Presets.cpp
	SoftwareEncoders.cpp
	Transcoder.cpp
	VaapiEncoder.cpp
	VaapiLibrary.cpp
	VideoEncoder.cpp
	;

local appSources =
	AudioPreview.cpp
	HardwareWindow.cpp
	MediaConverterApp.cpp
	MediaConverterWindow.cpp
	OutputView.cpp
	QueueView.cpp
	SourceView.cpp

	# airTime's controller (app/airtime/README.md)
	ControlBar.cpp
	Look.cpp
	;

UseBuildFeatureHeaders ffmpeg ;
Includes [ FGristFiles $(engineSources) $(appSources) mediaconvert.cpp ]
	: [ BuildFeatureAttribute ffmpeg : headers ] ;

StaticLibrary libmediaconverter_engine.a : $(engineSources) ;

Application MediaConverter :
	$(appSources)
	:
	libmediaconverter_engine.a libcolumnlistview.a
	[ BuildFeatureAttribute ffmpeg : libraries ]
	be media tracker translation localestub [ TargetLibstdc++ ]
	: MediaConverter.rdef
;

# The engine from a shell, for tests (not part of the image).
Application mediaconvert :
	mediaconvert.cpp
	:
	libmediaconverter_engine.a
	[ BuildFeatureAttribute ffmpeg : libraries ]
	be [ TargetLibstdc++ ]
;

DoCatalogs MediaConverter :
	x-vnd.Haiku-MediaConverter
	:
	$(appSources)
;
