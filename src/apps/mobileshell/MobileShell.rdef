
resource app_signature "application/x-vnd.airOS-MobileShell";

resource app_version {
	major  = 0,
	middle = 3,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "air/OS Mobile",
	long_info = "air/OS Mobile, the touch desktop of tablet mode"
};

resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;
