SubDir HAIKU_TOP src apps terminal render opengl ;

# Terminal's OpenGL renderer, an add-on so that Terminal runs where there is
# no OpenGL.

UseBuildFeatureHeaders mesa ;
UseHeaders [ FDirName $(HAIKU_TOP) src apps terminal emulator ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src apps terminal render ] ;

Includes [ FGristFiles GLRenderer.cpp ]
	: [ BuildFeatureAttribute mesa : headers ] ;

if [ FIsBuildFeatureEnabled mesa ] {
	Addon Terminal-OpenGL :
		GLRenderer.cpp
		:
		be [ BuildFeatureAttribute mesa : library ]
		[ TargetLibsupc++ ] [ TargetLibstdc++ ]
		;
}
