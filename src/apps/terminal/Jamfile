SubDir HAIKU_TOP src apps terminal ;

UseHeaders [ FDirName $(HAIKU_TOP) src kits tracker ] ;
UseHeaders [ FDirName $(SUBDIR) emulator ] ;
UseHeaders [ FDirName $(SUBDIR) render ] ;

UsePrivateHeaders libroot notification shared system ;
UsePrivateHeaders textencoding ;
UseBuildFeatureHeaders zlib ;
UseBuildFeatureHeaders freetype ;
if [ FIsBuildFeatureEnabled openssl ] {
	SubDirC++Flags -DOPENSSL_ENABLED -DOPENSSL_API_COMPAT=10101
		-DOPENSSL_NO_DEPRECATED=1 ;
	UseBuildFeatureHeaders openssl ;
	Includes [ FGristFiles TermCrypto.cpp ]
		: [ BuildFeatureAttribute openssl : headers ] ;
}

SEARCH_SOURCE += [ FDirName $(SUBDIR) emulator ] ;
SEARCH_SOURCE += [ FDirName $(SUBDIR) render ] ;

local emulatorSources =
	Base64.cpp
	ColorNames.cpp
	Terminal.cpp
	TerminalCommands.cpp
	TerminalGraphics.cpp
	TerminalHistory.cpp
	TerminalInput.cpp
	TerminalSequences.cpp
	UnicodeTables.cpp
	VTParser.cpp
	;

local renderSources =
	BoxDrawing.cpp
	ColorEmoji.cpp
	FrameBuilder.cpp
	GlyphCache.cpp
	Ligatures.cpp
	SoftwareRenderer.cpp
	;

Includes [ FGristFiles $(emulatorSources) $(renderSources) ImageCodecs.cpp
		TermFileTransfer.cpp ]
	: [ BuildFeatureAttribute zlib : headers ]
	  [ BuildFeatureAttribute freetype : headers ] ;

Application Terminal :
	ActiveProcessInfo.cpp
	AppearPrefView.cpp
	Arguments.cpp
	Colors.cpp
	FindWindow.cpp
	Globals.cpp
	HyperLink.cpp
	ImageCodecs.cpp
	InlineInput.cpp
	PatternEvaluator.cpp
	PrefHandler.cpp
	PrefWindow.cpp
	SetTitleDialog.cpp
	Shell.cpp
	ShellInfo.cpp
	ShellParameters.cpp
	SmartTabView.cpp
	TermApp.cpp
	TermCrypto.cpp
	TermDragAndDrop.cpp
	TermFileTransfer.cpp
	TerminalCharClassifier.cpp
	TerminalRoster.cpp
	TermConst.cpp
	TermScrollView.cpp
	TermView.cpp
	TermViewStates.cpp
	TermWindow.cpp
	ThemeView.cpp
	ThemeWindow.cpp
	TitlePlaceholderMapper.cpp

	$(emulatorSources)
	$(renderSources)

	: be localestub shared tracker translation textencoding
	[ BuildFeatureAttribute zlib : library ]
	[ BuildFeatureAttribute freetype : library ]
	[ BuildFeatureAttribute openssl : libraries ]
	[ TargetLibsupc++ ] [ TargetLibstdc++ ]
	: Terminal.rdef XColors.rdef
;

DoCatalogs Terminal :
	x-vnd.Haiku-Terminal
	:
	AppearPrefView.cpp
	Arguments.cpp
	Colors.cpp
	FindWindow.cpp
	PrefHandler.cpp
	PrefWindow.cpp
	SetTitleDialog.cpp
	Shell.cpp
	SmartTabView.cpp
	TermApp.cpp
	TermConst.cpp
	TermView.cpp
	TermViewStates.cpp
	TermWindow.cpp
	ThemeView.cpp
	ThemeWindow.cpp
	: en.catalog
;

SubInclude HAIKU_TOP src apps terminal render opengl ;
