SubDir HAIKU_TOP src tests kits neural ;

UsePrivateHeaders neural ;

# the kit without hardware: tensors, models, sessions, a back end of its own
SimpleTest neural_kit_test : neural_kit_test.cpp
	: be neural [ TargetLibstdc++ ] ;

# the RK3588 back end against the CPU; needs the processor
if $(TARGET_ARCH) = arm64 {
	SimpleTest rk3588_npu_backend_test : rk3588_npu_backend_test.cpp
		: be neural translation [ TargetLibstdc++ ] ;
}

# the vulkan back end against the CPU; needs a graphics processor with a
# Vulkan driver
SimpleTest vulkan_backend_test : vulkan_backend_test.cpp
	: be neural [ TargetLibstdc++ ] ;

# the amdxdna back end with a design bundle; with the NPU it compares the
# NPU and the CPU, without it the back end's claims and the fallback
if $(TARGET_ARCH) = x86_64 {
	SimpleTest amdxdna_backend_test : amdxdna_backend_test.cpp
		: be neural [ TargetLibstdc++ ] ;
}
