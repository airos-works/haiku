# Tracker's copy and move engine on two volumes: what is where afterwards.
# Run it with a folder on each of two BFS volumes:
#	tracker_fsops_test /Data/t /OtherVolume/t
SimpleTest tracker_fsops_test : tracker_fsops_test.cpp
	: be tracker shared [ TargetLibstdc++ ] ;

# Folder sizes and thumbnails with folders of thousands of entries (#179):
# file descriptors held, walks per burst of changes, a walk cancelled,
# thumbnails of icons scrolled out of view, redraws after failed thumbnails.
# Needs app_server (it draws into a window); keeps <folder>/bigtree, a tree
# of 300,000 files that takes minutes to make, between runs.
#	tracker_large_folder_test /Data/t
SimpleTest tracker_large_folder_test : tracker_large_folder_test.cpp
	: be tracker translation shared [ TargetLibstdc++ ] ;
