SEARCH_SOURCE += $(driver) ;
SimpleTest hevc_stream_test : hevc_stream_test.cpp HevcStream.cpp hevc_parse.c h264_parse.c UvdHevc.cpp
	: [ TargetLibstdc++ ] ;
