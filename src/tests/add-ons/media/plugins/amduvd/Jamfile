	: [ TargetLibstdc++ ] ;
SimpleTest hevc_output_test : hevc_output_test.cpp HevcOutput.cpp H264Output.cpp
	: [ TargetLibstdc++ ] ;

# Test-only add-on: the real decoders with an owned, root-only GPU timeout
# inserted at a selected decode. Never install this as the default add-on.
