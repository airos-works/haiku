	H264Stream.cpp H264Packet.cpp H264Output.cpp h264_parse.c
	HevcStream.cpp HevcPacket.cpp HevcOutput.cpp hevc_parse.c
	: be media [ TargetLibsupc++ ] [ TargetLibstdc++ ] ;
