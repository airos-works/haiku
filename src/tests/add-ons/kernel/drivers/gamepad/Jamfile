SubDir HAIKU_TOP src tests add-ons kernel drivers gamepad ;

# gamepad_protocols_test: the Xbox 360 / Xbox One (GIP) report translation and
# synthesized descriptors of usb_hid, and the Sony rumble reports, checked
# against the shared HID parser in user land.
# gamepad_test: a BJoystick tool for real pads (state and rumble).

local usbHIDDir = [ FDirName $(HAIKU_TOP) src add-ons kernel drivers input
	usb_hid ] ;
local hidSharedDir = [ FDirName $(HAIKU_TOP) src add-ons kernel drivers input
	hid_shared ] ;

SubDirC++Flags [ FDefines USERLAND_HID ] ;

UsePrivateHeaders drivers device bluetooth ;
UsePrivateKernelHeaders ;
SubDirHdrs $(usbHIDDir) ;
SubDirHdrs $(hidSharedDir) ;
SubDirHdrs [ FDirName $(HAIKU_TOP) src bin hid_decode ] ;

SimpleTest gamepad_protocols_test :
	gamepad_protocols_test.cpp
	GamepadProtocols.cpp
	HIDCollection.cpp
	HIDParser.cpp
	HIDReport.cpp
	HIDReportItem.cpp
	HIDWriter.cpp
	: be [ TargetLibsupc++ ]
;

SEARCH on [ FGristFiles GamepadProtocols.cpp ] = $(usbHIDDir) ;
SEARCH on [ FGristFiles HIDCollection.cpp HIDParser.cpp HIDReport.cpp
	HIDReportItem.cpp HIDWriter.cpp ] = $(hidSharedDir) ;

SimpleTest gamepad_test :
	gamepad_test.cpp
	: be device [ TargetLibsupc++ ]
;

SimpleTest bt_gamepad_test :
	bt_gamepad_test.cpp
	: be device [ TargetLibsupc++ ]
;
