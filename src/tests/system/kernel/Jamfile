# kevent() adding a directory freed an event that was queued
# (airos-works/haiku#183)
SourceSysHdrs kqueue_unsupported_fd_test.cpp
	: [ FDirName $(HAIKU_TOP) headers compatibility bsd ] ;
SimpleTest kqueue_unsupported_fd_test : kqueue_unsupported_fd_test.cpp
	: libbsd.so ;

# msync() of a mapping 4 GiB into a file wrote other pages
# (airos-works/haiku#183); needs 4.4 GiB on the volume and minutes
SimpleTest msync_large_offset_test : msync_large_offset_test.cpp ;

SimpleTest durable_write : durable_write.cpp ;

SimpleTest illegal_instruction_test : illegal_instruction_test.cpp ;

SimpleTest signal_fpu_test : signal_fpu_test.cpp ;
SimpleTest signal_suspend_resume_test : signal_suspend_resume_test.cpp ;

# user_thread.h, syscalls.h: the userland wait (_kern_block_thread()) and
# signals; airos-ci runs it in every image it boots (tools/airos/ci/guest-tests)
UsePrivateHeaders libroot system ;
SimpleTest user_block_thread_test : user_block_thread_test.cpp ;

# pipe() with a full FD table hung instead of failing with EMFILE
# (airos-works/haiku#59); in tools/airos/ci/guest-tests too
SimpleTest pipe_fd_table_full_test : pipe_fd_table_full_test.cpp ;

# a debugger removed while it profiles running threads left their profiling
# timers armed: a timer firing for the idle thread panicked in
# profiling_event(); in tools/airos/ci/guest-tests too
SimpleTest profiler_detach_test : profiler_detach_test.cpp ;

# the page writer's writes of fragmented files against metadata writes: a
# disk driver's completion report that sent the next part of a transfer
# itself stopped every write to an NVMe disk (airos-works/haiku#141); in
# tools/airos/ci/guest-tests too
SimpleTest fragmented_write_test : fragmented_write_test.cpp ;

# a disk driver's DMA paths (airos-works/haiku#181): a pattern written to a
# raw device with requests of all sizes, alignments and scattered vectors,
# read back and compared byte by byte; optionally throughput. Overwrites the
# device: run it by hand on a scratch disk.
SimpleTest raw_disk_dma_test : raw_disk_dma_test.cpp ;

# cold reads of fragmented files from several threads: a thread that waited
# for a block of a file's extent list reported other transfers of the same
# file and waited for the lock it held (airos-works/haiku#166). Mounts a
# scratch volume itself, so not in tools/airos/ci/guest-tests.
SimpleTest fragmented_read_test : fragmented_read_test.cpp ;

# modified pages of a file that is being removed, against a write that waits
# for the modified page quota: the page writer went round its queue at full
# speed and the write never returned (airos-works/haiku#146). Needs a slow
# device (it skips itself on a fast one), so not in tools/airos/ci/guest-tests.
SimpleTest page_writer_stall_test : page_writer_stall_test.cpp ;

# file data written without sync() reaches the disk within seconds, also
# when it is less than the page writer's run of 256 pages
# (airos-works/haiku#219). Reads the raw device of the volume it writes to,
# so not in tools/airos/ci/guest-tests.
SimpleTest idle_writeback_test : idle_writeback_test.cpp ;

# fsync() writes the pages a reader has busy at that moment, and returns
# only once they are on the device (airos-works/haiku#223). Reads the raw
# device of the volume it writes to, so not in tools/airos/ci/guest-tests.
SimpleTest fsync_busy_pages_test : fsync_busy_pages_test.cpp ;

# a new semaphore reported the latest holder of the one that had its slot
# before (airos-works/haiku#153)
SimpleTest sem_slot_reuse_test : sem_slot_reuse_test.cpp ;

# the semaphore table is backed in steps as it fills (airos-works/haiku#215):
# filling it to max_sems from several threads, stale and never-used IDs,
# concurrent create/delete. Leaves the system without free semaphores for a
# moment, so not in tools/airos/ci/guest-tests.
SimpleTest sem_table_test : sem_table_test.cpp ;

# a signal handler that changes the saved state the kernel restores with its
# own privileges: segment selectors, instruction pointer, XSAVE area, SPSR
# (airos-works/haiku#158). A kernel without the fix does not survive it.
SimpleTest signal_frame_forge_test : signal_frame_forge_test.cpp ;

# signal delivery to a thread whose stack pointer or alternate signal stack is
# a kernel address or unmapped (airos-works/haiku#224): the frame must not be
# written there and the team dies of SIGSEGV. A kernel without the fix writes
# the frame through its physical memory mapping into the test's own buffer
# (found with /dev/misc/poke).
SourceHdrs signal_stack_bounds_test.cpp
	: [ FDirName $(HAIKU_TOP) headers private drivers ] ;
SimpleTest signal_stack_bounds_test : signal_stack_bounds_test.cpp ;

# MXCSR and the x87 control word across system calls (airos-works/haiku#167:
# reset by every system call on processors with AVX-512)
SimpleTest fpu_control_syscall_test : fpu_control_syscall_test.cpp ;

# a thread bound to a CPU waking up in power-saving mode with no core idle: a
# NULL dereference in the scheduler; read_port() against delete_port(): a
# reader asleep on the deleted port (airos-works/haiku#168; the lock tests of
# that issue are in unit/lock). The scheduler test changes the scheduler mode
# for its run.
SimpleTest scheduler_pinned_power_saving_test
	: scheduler_pinned_power_saving_test.cpp ;
SimpleTest port_delete_race_test : port_delete_race_test.cpp ;

# a team's entries for its exited threads: joining later, and the cost of a
# join after many detached threads (airos-works/haiku#190)
SimpleTest dead_threads_test : dead_threads_test.cpp ;

