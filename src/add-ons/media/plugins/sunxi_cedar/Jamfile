SubDir HAIKU_TOP src add-ons media plugins sunxi_cedar ;

UsePrivateHeaders drivers media shared ;

# "00_": the Media Kit takes the first decoder of a directory that knows a
# format, in the order of their names, and the FFmpeg add-on beside it in
# system/add-ons/media/plugins also knows H.264 and HEVC
local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup ] {
	on $(architectureObject) {
		Addon [ MultiArchDefaultGristFiles 00_sunxi_cedar ] :
			bits.c
			h264_parse.c
			hevc_parse.c
			CedarDecoder.cpp
			CedarEngine.cpp
			CedarPlugin.cpp
			VeDevice.cpp
			: be media [ TargetLibsupc++ ] [ TargetLibstdc++ ]
		;
	}
}
