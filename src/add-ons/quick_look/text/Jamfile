SubDir HAIKU_TOP src add-ons quick_look text ;

UsePrivateHeaders interface shared ;

local architectureObject ;
for architectureObject in [ MultiArchSubDirSetup ] {
	on $(architectureObject) {
		Addon [ MultiArchDefaultGristFiles TextPreview ] :
			TextPreview.cpp
			TablePreview.cpp
			: [ MultiArchDefaultGristFiles libcolumnlistview.a ]
			be quicklook localestub [ TargetLibstdc++ ]
		;
	}
}

DoCatalogs TextPreview :
	x-vnd.Haiku-QuickLook-TextPreview
	:
	TextPreview.cpp
	TablePreview.cpp
;
