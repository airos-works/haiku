	PDFPreview.cpp
	: be quicklook localestub [ TargetLibstdc++ ]
	[ BuildFeatureAttribute mupdf : library ]
;

DoCatalogs PDFPreview :
	x-vnd.Haiku-QuickLook-PDFPreview
	:
	PDFPreview.cpp
;
