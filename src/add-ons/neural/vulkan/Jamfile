SubDir HAIKU_TOP src add-ons neural vulkan ;

# Any graphics processor with a Vulkan driver. The add-on links against no
# Vulkan library: it opens the loader at run time (VulkanLibrary.cpp), with
# the Khronos headers in vulkan/, and its shaders are compiled ahead of time
# (shaders/compile.sh), so that the build needs neither.

SubDirHdrs [ FDirName $(SUBDIR) shaders ] ;

Addon vulkan.neural :
	VulkanBackend.cpp
	VulkanDevice.cpp
	VulkanLibrary.cpp
	VulkanPlan.cpp
	VulkanProgram.cpp
	:
	be neural [ TargetLibstdc++ ]
;
