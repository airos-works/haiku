SubDir HAIKU_TOP src add-ons kernel drivers network ether tc956x ;

UsePrivateKernelHeaders ;
UsePrivateHeaders drivers net ;
UseLibraryHeaders [ FDirName libfdt ] ;

# the device tree blob is read for the board's MAC addresses
local libFDTSources =
	fdt.c
	fdt_ro.c
;

KernelAddon tc956x :
	tc956x.cpp
	$(libFDTSources)
;

SEARCH on [ FGristFiles $(libFDTSources) ]
	= [ FDirName $(HAIKU_TOP) src libs libfdt ] ;
