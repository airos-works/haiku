SubDir HAIKU_TOP src add-ons kernel drivers network wlan aic8800wifi host ;

UsePrivateKernelHeaders ;
UsePrivateHeaders drivers ;
UseHeaders [ FDirName $(SUBDIR) $(DOTDOT) ] : true ;

# The USB side and the firmware loader are plain Haiku kernel code; they are
# built apart from the driver, whose compatibility headers stand in for the
# system's.
KernelStaticLibrary aic8800wifi_usb.a :
	aic_usb.cpp
	aic_loader.c
	;
