SubDir HAIKU_TOP src add-ons kernel drivers power qcom_adsp ;

UsePrivateKernelHeaders ;
UsePrivateHeaders drivers ;
UseLibraryHeaders [ FDirName libfdt ] ;
UseHeaders [ FDirName $(HAIKU_TOP) src add-ons kernel drivers common qcom ] ;

local libFDTSources =
	fdt.c
	fdt_ro.c
;

KernelAddon qcom_adsp :
	qcom_adsp.cpp
	qcom_rpmh.cpp
	qcom_scm.cpp
	$(libFDTSources)
;

SEARCH on [ FGristFiles qcom_rpmh.cpp qcom_scm.cpp ]
	= [ FDirName $(HAIKU_TOP) src add-ons kernel drivers common qcom ] ;

SEARCH on [ FGristFiles $(libFDTSources) ]
	= [ FDirName $(HAIKU_TOP) src libs libfdt ] ;
