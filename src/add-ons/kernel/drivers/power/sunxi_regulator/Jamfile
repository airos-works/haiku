SubDir HAIKU_TOP src add-ons kernel drivers power sunxi_regulator ;

UsePrivateKernelHeaders ;
UsePrivateHeaders drivers ;
UseLibraryHeaders [ FDirName libfdt ] ;

# the display driver's R_TWI controller, for the PMIC
local sunxiDisplay = [ FDirName $(SUBDIR) $(DOTDOT) $(DOTDOT) graphics
	sunxi_display ] ;
SEARCH_SOURCE += $(sunxiDisplay) ;
SubDirSysHdrs $(sunxiDisplay) ;

local libFDTSources =
	fdt.c
	fdt_ro.c
	;

KernelAddon sunxi_regulator :
	sunxi_regulator.cpp
	sunxi_pmic.cpp
	twi.cpp
	$(libFDTSources)
;

SEARCH on [ FGristFiles $(libFDTSources) ]
	= [ FDirName $(HAIKU_TOP) src libs libfdt ] ;
