SubDir HAIKU_TOP src add-ons kernel drivers power qcom_pwrkey ;

UsePrivateKernelHeaders ;
UseLibraryHeaders [ FDirName libfdt ] ;

local libFDTSources =
	fdt.c
	fdt_ro.c
;

KernelAddon <driver>qcom_pwrkey :
	qcom_pwrkey.cpp
	$(libFDTSources)
	;

SEARCH on [ FGristFiles $(libFDTSources) ]
	= [ FDirName $(HAIKU_TOP) src libs libfdt ] ;
