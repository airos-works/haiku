SubDir HAIKU_TOP src add-ons kernel drivers power qcom_thermal ;

UsePrivateKernelHeaders ;
UseLibraryHeaders [ FDirName libfdt ] ;

local libFDTSources =
	fdt.c
	fdt_ro.c
;

KernelAddon <driver>qcom_thermal :
	qcom_thermal.cpp
	$(libFDTSources)
	;

SEARCH on [ FGristFiles $(libFDTSources) ]
	= [ FDirName $(HAIKU_TOP) src libs libfdt ] ;
