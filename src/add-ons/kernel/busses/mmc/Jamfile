SubDir HAIKU_TOP src add-ons kernel busses mmc ;

SubDirC++Flags -fno-rtti ;

UsePrivateKernelHeaders ;
UsePrivateHeaders drivers ;
SubDirHdrs $(HAIKU_TOP) src system kernel device_manager ;
SubDirHdrs $(HAIKU_TOP) src add-ons kernel bus_managers acpi acpica include ;
SubDirHdrs $(HAIKU_TOP) src add-ons kernel bus_managers acpi acpica include platform ;

local qcomSources ;
if $(TARGET_ARCH) = arm64 {
	# the SC8280XP's SD slot, its votes through RPMh
	UseLibraryHeaders [ FDirName libfdt ] ;
	SubDirSysHdrs $(HAIKU_TOP) src add-ons kernel drivers common qcom ;
	qcomSources = sdhci_qcom.cpp qcom_rpmh.cpp qcom_smmu.cpp fdt.c fdt_ro.c ;
}

KernelAddon sdhci :
	sdhci.cpp
	sdhci_dma.cpp
	sdhci_fdt.cpp
	sdhci_acpi.cpp
	sdhci_pci.cpp
	$(qcomSources)
;

SEARCH on [ FGristFiles qcom_rpmh.cpp qcom_smmu.cpp ]
	= [ FDirName $(HAIKU_TOP) src add-ons kernel drivers common qcom ] ;
SEARCH on [ FGristFiles fdt.c fdt_ro.c ]
	= [ FDirName $(HAIKU_TOP) src libs libfdt ] ;

if $(TARGET_ARCH) = arm64 {
	SubInclude HAIKU_TOP src add-ons kernel busses mmc bcm2711_emmc2 ;
	SubInclude HAIKU_TOP src add-ons kernel busses mmc sunxi_mmc ;
}
