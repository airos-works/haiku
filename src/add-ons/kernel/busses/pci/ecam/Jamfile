SubDir HAIKU_TOP src add-ons kernel busses pci ecam ;

SubDirC++Flags -fno-rtti -DECAM_PCI_WITH_FDT ;

UsePrivateKernelHeaders ;
UseLibraryHeaders [ FDirName libfdt ] ;

SubDirHdrs $(HAIKU_TOP) src system kernel arch generic ;

# the device tree blob is read directly for the MSI controller (msi-map)
local libFDTSources =
	fdt.c
	fdt_ro.c
	fdt_strerror.c
;

KernelAddon <pci>ecam :
	ECAMPCIController.cpp
	ECAMPCIControllerACPI.cpp
	ECAMPCIControllerFDT.cpp
	kernel_interface.cpp
	$(libFDTSources)
;

SEARCH on [ FGristFiles $(libFDTSources) ]
	= [ FDirName $(HAIKU_TOP) src libs libfdt ] ;
