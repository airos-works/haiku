SubDir HAIKU_TOP src add-ons kernel busses pci qcom ;

SubDirC++Flags -fno-rtti ;
UsePrivateKernelHeaders ;
UseLibraryHeaders [ FDirName libfdt ] ;

# the device tree blob is read directly where device nodes don't exist yet
local libFDTSources =
	fdt.c
	fdt_ro.c
	fdt_strerror.c
;

KernelAddon <pci>qcom_pcie :
	qcom_pcie.cpp
	$(libFDTSources)
;

SEARCH on [ FGristFiles $(libFDTSources) ]
	= [ FDirName $(HAIKU_TOP) src libs libfdt ] ;
