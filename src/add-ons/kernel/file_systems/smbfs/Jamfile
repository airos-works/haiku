SubDir HAIKU_TOP src add-ons kernel file_systems smbfs ;

SubDirSysHdrs [ FDirName $(HAIKU_TOP) headers private userlandfs fuse ] ;
UseHeaders [ FDirName $(HAIKU_TOP) headers libs libsmb2 ] : true ;

# libsmb2 has errors as -errno, and is built for errno to be positive. So is
# FUSE: what a file system returns is -errno there, too.
SubDirC++Flags -DB_USE_POSITIVE_POSIX_ERRORS ;

SubDirC++Flags -DFUSE_USE_VERSION=26 -D_FILE_OFFSET_BITS=64 ;

Addon smbfs :
	Connection.cpp
	StatCache.cpp
	smbfs.cpp
	:
	libsmb2.a
	[ MultiArchDefaultGristFiles libposix_error_mapper.a ]
	libuserlandfs_fuse.so
	be
	$(TARGET_NETWORK_LIBS)
	[ TargetLibstdc++ ]
;
