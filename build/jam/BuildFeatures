# WebKit
if $(HAIKU_SUMMIT_PACKAGES_DIR) && $(TARGET_PACKAGING_ARCH) = x86_64 {
	# The BWebView API on the Summit browser's engine instead of HaikuWebKit:
	# Summit's summit_webkitlegacy package (libWebKitLegacy with the same
	# classes) and the engine it runs on (summit_webkit), from the directory
	# HAIKU_SUMMIT_PACKAGES_DIR (set it in UserBuildConfig). The packages are
	# built by the Summit repository (legacy/, tools/package-summit-*.sh);
	# summit_webkitlegacy provides and replaces haikuwebkit.
	local summitLegacy = [ Glob $(HAIKU_SUMMIT_PACKAGES_DIR)
		: summit_webkitlegacy-*-x86_64.hpkg ] ;
	local summitEngine = [ Glob $(HAIKU_SUMMIT_PACKAGES_DIR)
		: summit_webkit-*-x86_64.hpkg ] ;
	if ! $(summitLegacy) || ! $(summitEngine) {
		Exit "HAIKU_SUMMIT_PACKAGES_DIR ($(HAIKU_SUMMIT_PACKAGES_DIR)) holds no"
			"summit_webkitlegacy and summit_webkit packages" ;
	}
	summitLegacy = $(summitLegacy[-1]) ;
	summitEngine = $(summitEngine[-1]) ;
	local legacyDirectory = [ FDirName $(HAIKU_OPTIONAL_BUILD_PACKAGES_DIR)
		$(summitLegacy:B) ] ;
	local engineDirectory = [ FDirName $(HAIKU_OPTIONAL_BUILD_PACKAGES_DIR)
		$(summitEngine:B) ] ;
	SetBuildFeatureAttribute webkit : headers
		: [ ExtractArchive $(legacyDirectory) : develop/headers
			: $(summitLegacy) : extracted-webkit-summit ] ;
	SetBuildFeatureAttribute webkit : libraries
		: [ ExtractArchive $(legacyDirectory) : lib/libWebKitLegacy.so.1
			: $(summitLegacy) : extracted-webkit-summit ] ;
	# The engine, for the linker to follow libWebKitLegacy's own needs.
	SetBuildFeatureAttribute webkit : engine
		: [ ExtractArchive $(engineDirectory) : lib/summit-webkit/lib
			: $(summitEngine) : extracted-webkit-summit-engine ] ;
	SetBuildFeatureAttribute webkit : engineLibraryDirectory
		: [ FDirName $(engineDirectory) lib summit-webkit lib ] ;
	# Where the attributes' paths are relative to (BuildFeatureAttribute path).
	SetBuildFeatureAttribute webkit : headers:package : summit ;
	SetBuildFeatureAttribute webkit : libraries:package : summit ;
	SetBuildFeatureAttribute webkit : engine:package : summitEngine ;
	SetBuildFeatureAttribute webkit : summit:directory : $(legacyDirectory) ;
	SetBuildFeatureAttribute webkit : summitEngine:directory
		: $(engineDirectory) ;

	EnableBuildFeatures webkit ;
} else if [ IsPackageAvailable haikuwebkit_devel ] {
	ExtractBuildFeatureArchives webkit :
		file: base haikuwebkit
			runtime: lib
		file: devel haikuwebkit_devel
			depends: base
			libraries:
				$(developLibDir)/libWebKitLegacy.so
			headers: $(developHeadersDir)
		;

	EnableBuildFeatures webkit ;
} else {
	unavailableBuildFeatures += webkit ;
}


