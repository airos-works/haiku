# This file contains setup for build features that require external packages. It
# is included once for each configured packaging architecture (with
# TARGET_PACKAGING_ARCH set accordingly).


local architecture = $(TARGET_PACKAGING_ARCH) ;
local secondaryArchSubDir = [ MultiArchIfPrimary "" : /$(architecture) ] ;
local libDir = lib$(secondaryArchSubDir) ;
local developLibDir = develop/lib$(secondaryArchSubDir) ;
local developHeadersDir = develop/headers$(secondaryArchSubDir) ;

local unavailableBuildFeatures ;


rule ExtractArm64ImageLibraryBuildFeature feature : package : version : library
	: headers
{
	# ExtractArm64ImageLibraryBuildFeature <feature> : <package> : <version>
	#	: <library> [ : <header directories> ] ;
	# The arm64 bootstrap repository has no image libraries. The pinned
	# packages of tools/rpi4/build-image-libs.sh in
	# HAIKU_ARM64_IMAGE_LIBS_PACKAGES_DIR stand in for HaikuPorts' <package>
	# and <package>_devel, the same way as zstd's below. <library> is the
	# file in lib/ to link against; <header directories> default to
	# develop/headers.
	headers ?= develop/headers ;
	local packageDirectory = $(HAIKU_ARM64_IMAGE_LIBS_PACKAGES_DIR) ;
	local base = [ FDirName $(packageDirectory)
		$(package)-$(version)-arm64.hpkg ] ;
	local devel = [ FDirName $(packageDirectory)
		$(package)_devel-$(version)-arm64.hpkg ] ;
	if ! [ Glob $(packageDirectory) : $(base:BS) ]
		|| ! [ Glob $(packageDirectory) : $(devel:BS) ] {
		Exit "Missing arm64 $(package) packages; run"
			"tools/rpi4/build-image-libs.sh" ;
	}
	local directory = [ FDirName $(HAIKU_OPTIONAL_BUILD_PACKAGES_DIR)
		airos-$(package)-$(version)-arm64 ] ;
	# Extraction shares the prefix (including .PackageInfo), so serialize it.
	Depends $(directory:G=$(feature)-devel) : $(directory:G=$(feature)-base) ;
	SetBuildFeatureAttribute $(feature) : runtime
		: [ ExtractArchive $(directory:G=$(feature)-base) : lib
			: $(base) : extracted-arm64-$(feature)-base ] : base ;
	SetBuildFeatureAttribute $(feature) : library
		: [ ExtractArchive $(directory:G=$(feature)-base) : lib/$(library)
			: $(base) : extracted-arm64-$(feature)-base ] : base ;
	SetBuildFeatureAttribute $(feature) : headers
		: [ ExtractArchive $(directory:G=$(feature)-devel) : $(headers)
			: $(devel) : extracted-arm64-$(feature)-devel ] : devel ;
	SetBuildFeatureAttribute $(feature) : base:directory : $(directory) ;
	SetBuildFeatureAttribute $(feature) : devel:directory : $(directory) ;
	EnableBuildFeatures $(feature) ;
}


# SSL

# Automatically enable the SSL feature, when the OpenSSL package is enabled.
