SYSTEM_ADD_ONS_DRIVERS_NET += [ FFilterByBuildFeatures
	# WLAN drivers. The M.2/mini PCIe and USB ones also serve arm64 boards;
	# they build there and load on the ROCK 5 ITX (iaxwifi200 is in use).
	x86,x86_64,riscv64,arm64 @{
		atheroswifi
		iaxwifi200
		idualwifi7260
		iprowifi3945
		iprowifi4965
		ralinkwifi
		realtekwifi
		realtekwifi8187
		zydwifi1211
	}@ # x86,x86_64,riscv64,arm64
	# MediaTek MT7921/MT7922 (Wi-Fi 6, M.2 and PCIe), so far tried only on
	# x86_64. Its firmware is not in HaikuPorts; see
	# docs/x399-workstation/UserBuildConfig.standard.
	x86_64 @{
		mt7922wifi
	}@ # x86_64
	# Broadcom/Cypress FullMAC on SDIO: the Raspberry Pi 4's CYW43455. It
	# only attaches on that board; its firmware comes with the board's image
	# (tools/rpi4/UserBuildConfig).
	arm64 @{
		broadcomfmac
	}@ # arm64
	# Legacy PCI and CardBus cards
	x86,x86_64,riscv64 @{
		aironetwifi
		broadcom43xx
		iprowifi2100
		iprowifi2200
		marvell88w8363
		marvell88w8335
	}@ # x86,x86_64,riscv64
] ;

