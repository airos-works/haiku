rule HaikuImageGetSystemLibs
{
	return
		# libs with special grist
		[ MultiArchDefaultGristFiles libroot.so : revisioned ]
		[ Libstdc++ForImage ]
		# libs with standard grist
		[ MultiArchDefaultGristFiles [ FFilterByBuildFeatures
			libalm.so
			libbe.so
			libbsd.so
			libbnetapi.so
			libbluetooth.so
			libdebug.so
			libdebugger.so@primary
			libdevice.so
			libgame.so
			libglut.so@mesa
			libgnu.so
			libmail.so
			libmedia.so
			libmidi.so@fluidlite
			libmidi2.so
			libnetwork.so
			libnvmm.so@x86_64
			libpackage.so
			libquicklook.so
			libscreensaver.so
			libtextencoding.so
			libtracker.so
			libtranslation.so
		] ]
		;
}


rule HaikuImageGetPrivateSystemLibs
{
	return [ MultiArchDefaultGristFiles [ FFilterByBuildFeatures
		libalm.so
		libpackage-add-on-libsolv.so
		libroot-addon-icu.so
	] ] ;
}


