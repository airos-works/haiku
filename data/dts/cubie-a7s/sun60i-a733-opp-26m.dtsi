			opp-microvolt-vf0400 = <800000>;
			opp-microvolt-vf0500 = <800000>;
			opp-microvolt-vf0600 = <800000>;
			opp-microvolt-vf0401 = <800000>;
			opp-microvolt-vf0501 = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-1092000000 {
			opp-hz = /bits/ 64 <1092000000>;
