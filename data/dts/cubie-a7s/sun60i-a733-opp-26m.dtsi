		};

		opp-1586000000 {
			opp-hz = /bits/ 64 <1586000000>;
			opp-microvolt-vf0000 = <900000>;
			clock-latency-ns = <244144>;
		};

		opp-1612000000 {
			opp-hz = /bits/ 64 <1612000000>;
