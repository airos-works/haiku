/*
 * The Allwinner A733's CPU and DSU operating points for boards with the
 * 26 MHz crystal, from Radxa's BSP device tree (Linux 6.6, cubie-a7s.dts:
 * cluster0/cluster1/dsu-opp-table, the opp-microvolt-26m-vfXXXX columns).
 * The chip's speed grade (eFuse, cpu_speed_grade) picks the column:
 * opp-microvolt-vf0500 for code 0x05. An operating point without a voltage
 * for the chip's column does not exist for it. Generated from the BSP's DTB
 * by tools/cubie-a7s/gen-opp-dts.py.
 */

/ {
	cpul_opp: opp-table-cpul {
		compatible = "allwinner,sun60i-a733-operating-points";
		nvmem-cells = <&cpu_speed_grade>;
		nvmem-cell-names = "speed";
		opp-shared;

		opp-416000000 {
			opp-hz = /bits/ 64 <416000000>;
			opp-microvolt-vf0000 = <800000>;
			opp-microvolt-vf0100 = <800000>;
			opp-microvolt-vf0200 = <800000>;
			opp-microvolt-vf0300 = <800000>;
			opp-microvolt-vf0400 = <800000>;
			opp-microvolt-vf0500 = <800000>;
			opp-microvolt-vf0600 = <800000>;
			opp-microvolt-vf0401 = <800000>;
			opp-microvolt-vf0501 = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-728000000 {
			opp-hz = /bits/ 64 <728000000>;
			opp-microvolt-vf0000 = <800000>;
			clock-latency-ns = <244144>;
		};

		opp-780000000 {
